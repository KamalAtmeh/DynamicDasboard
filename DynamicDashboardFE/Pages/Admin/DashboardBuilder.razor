    /// <summary>
    /// Finds the optimal position for a new component based on available space
    /// </summary>
    private (int x, int y) FindOptimalPosition(int width, int height)
    {
        const int gridColumns = 12;
        const int maxSearchRows = 20; // Limit search to prevent infinite loops

        // Create a grid to track occupied cells
        var occupiedCells = new HashSet<(int x, int y)>();

        if (dashboard.Components != null)
        {
            foreach (var component in dashboard.Components)
            {
                for (int x = component.GridX; x < component.GridX + component.GridWidth; x++)
                {
                    for (int y = component.GridY; y < component.GridY + component.GridHeight; y++)
                    {
                        occupiedCells.Add((x, y));
                    }
                }
            }
        }

        // Try to find a spot row by row
        for (int y = 0; y < maxSearchRows; y++)
        {
            for (int x = 0; x <= gridColumns - width; x++)
            {
                bool canFit = true;

                // Check if all required cells are free
                for (int cx = x; cx < x + width && canFit; cx++)
                {
                    for (int cy = y; cy < y + height && canFit; cy++)
                    {
                        if (occupiedCells.Contains((cx, cy)))
                        {
                            canFit = false;
                        }
                    }
                }

                if (canFit)
                {
                    return (x, y);
                }
            }
        }

        // If no space found, place at the bottom
        int maxY = dashboard.Components?.Any() == true
            ? dashboard.Components.Max(c => c.GridY + c.GridHeight)
            : 0;

        return (0, maxY);
    }

    /// <summary>
    /// Generates a title from the natural language question
    /// </summary>
    private string GenerateTitleFromQuestion(string question)
    {
        // Simple title extraction - take first 5-7 words and capitalize
        var words = question.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(7)
            .Select(w => char.ToUpper(w[0]) + w.Substring(1).ToLower());

        var title = string.Join(" ", words);

        // Remove trailing punctuation
        title = title.TrimEnd('.', '?', '!');

        // Limit length
        if (title.Length > 50)
        {
            title = title.Substring(0, 47) + "...";
        }

        return title;
    }




    private async Task LoadAllComponentsData()
    {
        if (dashboard?.Components == null || !dashboard.Components.Any())
        {
            ToastService.ShowWarning("No components to load data for");
            return;
        }

        if (dashboard.DatabaseID <= 0)
        {
            ToastService.ShowWarning("Please select a database in Dashboard Settings first");
            return;
        }

        isLoadingAllData = true;
        StateHasChanged();

        try
        {
            var tasks = dashboard.Components
                .Where(c => !string.IsNullOrEmpty(c.QueryText) &&
                           c.DataViewingTypeID != (int)DataViewingTypeEnum.Label)
                .Select(c => LoadComponentDataAsync(c));

            await Task.WhenAll(tasks);

            // ⚡ CRITICAL: These 3 lines make charts appear!
            StateHasChanged();
            await Task.Delay(200);
            await RenderAllCharts();

            ToastService.ShowSuccess("Data loaded for all components");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoadingAllData = false;
            StateHasChanged();
        }
    }

    private async Task RenderAllCharts()
    {
        var chartComponents = dashboard.Components
            .Where(c => c.DataViewingTypeID == (int)DataViewingTypeEnum.Chart && c.IsVisible);

        foreach (var chart in chartComponents)
        {
            await RenderChart(chart);
        }
    }

    private async Task RenderChart(DashboardComponent component)
    {
        if (!componentData.ContainsKey(component.ComponentID) || !componentData[component.ComponentID].Any())
            return;

        var data = componentData[component.ComponentID];
        var chartType = component.ChartType ?? "bar";

        try
        {
            await JSRuntime.InvokeVoidAsync("renderDynamicChart",
                component.ComponentID,
                chartType,
                data,
                component.Title);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering chart {component.ComponentID}: {ex.Message}");
        }
    }

    private async Task LoadComponentDataAsync(DashboardComponent component)
    {
        if (string.IsNullOrEmpty(component.QueryText))
        {
            return;
        }

        isComponentLoading[component.ComponentID] = true;
        StateHasChanged();

        try
        {
            // var payload = new
            // {
            //     SqlQuery = component.QueryText,
            //     Parameters = new List<object>()
            // };

            var request = new SqlExecutionRequest
            {
                OriginalQuestion = "",
                DatabaseId = dashboard.DatabaseID,
                Sql = component.QueryText
            };

            var response = await Http.PostAsJsonAsync($"api/query/execute", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<QueryExecutionResult>();
                if (result?.Success == true && result.Results != null)
                {
                    componentData[component.ComponentID] = result.Results;
                }
                else
                {
                    componentData[component.ComponentID] = new List<Dictionary<string, object>>();
                }
            }
            else
            {
                componentData[component.ComponentID] = new List<Dictionary<string, object>>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data for component {component.ComponentID}: {ex.Message}");
            componentData[component.ComponentID] = new List<Dictionary<string, object>>();
        }
        finally
        {
            isComponentLoading[component.ComponentID] = false;
            StateHasChanged();
        }
    }

