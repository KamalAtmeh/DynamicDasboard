@page "/dashboard/builder"
@page "/dashboard/builder/{DashboardId:int}"
@using DynamicDashboardCommon.Models
@using DynamicDashboardCommon.Enums
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IToastService ToastService

<PageTitle>Dashboard Builder</PageTitle>

<div class="dashboard-builder">
    <!-- Header -->
    <div class="builder-header">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                @if (!isPreviewMode)
                {
                    @*                 <button class="btn btn-outline-secondary" @onclick="() => NavigationManager.NavigateTo('/admin/dashboards')">
                    <i class="fas fa-arrow-left me-1"></i>Back
                </button> *@
                }

                @if (!isEditingTitle && !isPreviewMode)
                {
                    <h3 class="mb-0" @onclick="() => isEditingTitle = true" style="cursor: pointer;">
                        @dashboard.Title
                        <i class="fas fa-edit ms-2 text-muted" style="font-size: 0.8rem;"></i>
                    </h3>
                }
                else if (!isPreviewMode)
                {
                    <input @ref="titleInputRef" 
                    type="text" 
                    class="form-control" 
                    @bind="dashboard.Title" 
                    @onblur="() => isEditingTitle = false"
                    style="width: 300px;" />
                }
                else
                {
                    <h3 class="mb-0">@dashboard.Title</h3>
                }
            </div>

            <div class="d-flex gap-2 align-items-center">
                @if (isPreviewMode)
                {
                    <!-- Preview Mode Controls -->
                    <button class="btn btn-outline-secondary" @onclick="TogglePreviewMode">
                        <i class="fas fa-edit me-1"></i>Exit Preview
                    </button>
                    <button class="btn btn-outline-primary" @onclick="LoadAllComponentsData" disabled="@isLoadingAllData">
                        @if (isLoadingAllData)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <text>Refreshing...</text>
                        }
                        else
                        {
                            <i class="fas fa-sync me-1"></i>
                            <text>Refresh Data</text>
                        }
                    </button>
                }
                else
                {
                    <!-- Design Mode Controls -->
                    <button class="btn btn-success" @onclick="ShowTemplateModal">
                        <i class="fas fa-magic me-1"></i>Generate with AI
                    </button>
                    <button class="btn btn-info" @onclick="ShowAddChartModal" disabled="@(dashboard.DatabaseID <= 0)">
                        <i class="fas fa-plus-circle me-1"></i>Add Custom Chart
                    </button>
                    <button class="btn btn-outline-info" @onclick="TogglePreviewMode" disabled="@(!dashboard.Components.Any())">
                        <i class="fas fa-eye me-1"></i>Preview with Data
                    </button>
                    <button class="btn btn-primary" @onclick="SaveDashboard">
                        <i class="fas fa-save me-1"></i>Save
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Main Content -->
    @* REPLACE the builder-content section with this enhanced version *@

    <div class="builder-content @(isPreviewMode ? "preview-mode" : "")">
        <!-- Left Sidebar: Component Library (Hidden in preview) -->
        @if (!isPreviewMode)
        {
            <div class="builder-sidebar builder-sidebar-left">
                <div class="sidebar-header">
                    <h5 class="mb-0"><i class="fas fa-th me-2"></i>Components</h5>
                </div>
                <div class="sidebar-body">
                    <div class="mb-3">
                        <input type="text"
                        class="form-control form-control-sm"
                        placeholder="Search components..."
                        @bind="componentSearchTerm" />
                    </div>

                    @foreach (var category in componentCategories)
                    {
                        <div class="component-category mb-3">
                            <h6 class="category-title">@category</h6>
                            <div class="component-list">
                                @foreach (var component in FilteredComponents.Where(c => c.Category == category))
                                {
                                    <div class="component-item" draggable="true">
                                        <i class="fas @component.Icon me-2"></i>
                                        <span>@component.Title</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Center: Canvas -->
        <div class="builder-canvas-container @(isPreviewMode ? "fullscreen" : "")">
            @if (!isPreviewMode)
            {
                <div class="canvas-toolbar">
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary" @onclick="ZoomIn">
                            <i class="fas fa-search-plus"></i>
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="ZoomOut">
                            <i class="fas fa-search-minus"></i>
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="ResetZoom">
                            <i class="fas fa-expand"></i>
                        </button>
                    </div>
                    <span class="ms-3 text-muted">Zoom: @((int)(zoomLevel * 100))%</span>

                    @if (dashboard.Components != null && dashboard.Components.Any() && dashboard.DatabaseID > 0)
                    {
                        <button class="btn btn-sm btn-primary ms-auto" @onclick="LoadAllComponentsData" disabled="@isLoadingAllData">
                            @if (isLoadingAllData)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <text>Loading...</text>
                            }
                            else
                            {
                                <i class="fas fa-play me-1"></i>
                                <text>Load Data</text>
                            }
                        </button>
                    }
                </div>
            }

            <div class="builder-canvas" style="transform: scale(@(isPreviewMode ? 1 : zoomLevel)); background: @(isPreviewMode ? "#f5f5f5" : "white");">
                <div class="dashboard-grid" style="grid-template-rows: repeat(@GetGridHeight(), 100px);">
                    @if (dashboard.Components != null && dashboard.Components.Any())
                    {
                        @foreach (var component in dashboard.Components)
                        {
                            <div class="dashboard-component @(selectedComponentId == component.ComponentID && !isPreviewMode ? "selected" : "")"
                            style="grid-column: @(component.GridX + 1) / span @component.GridWidth;
                                    grid-row: @(component.GridY + 1) / span @component.GridHeight;"
                            @onclick="() => { if (!isPreviewMode) SelectComponent(component.ComponentID); }">

                                <div class="component-header">
                                    <span class="component-title">@component.Title</span>
                                    @if (!isPreviewMode)
                                    {
                                        <div class="component-actions">
                                            <button class="btn btn-sm btn-link" @onclick="() => DuplicateComponent(component)">
                                                <i class="fas fa-clone"></i>
                                            </button>
                                            <button class="btn btn-sm btn-link" @onclick="() => RemoveComponent(component.ComponentID)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    }
                                </div>

                                <div class="component-body">
                                    @if (IsComponentLoading(component.ComponentID))
                                    {
                                        <div class="text-center py-4">
                                            <div class="spinner-border text-primary mb-2"></div>
                                            <p class="text-muted small">Loading data...</p>
                                        </div>
                                    }
                                    else if (componentData.ContainsKey(component.ComponentID))
                                    {
                                        @* Render actual data based on component type *@
                                        var data = GetComponentData(component.ComponentID);

                                        @if (component.DataViewingTypeID == (int)DataViewingTypeEnum.Number)
                                        {
                                            @* KPI Display *@
                                            <div class="kpi-display">
                                                @if (data.Any())
                                                {
                                                    var rawValue = data[0].ContainsKey("value") ? data[0]["value"] : null;
                                                    var formattedValue = FormatNumericValue(rawValue, component); // USE FORMATTING

                                                    <div class="kpi-value">@formattedValue</div>
                                                    <div class="kpi-label">@component.Description</div>
                                                }
                                                else
                                                {
                                                    <div class="kpi-value">No Data</div>
                                                }
                                            </div>
                                        }
                                        else if (component.DataViewingTypeID == (int)DataViewingTypeEnum.Chart)
                                        {
                                            @* Chart Data Preview - Shows actual data values *@
                                            <div class="chart-data-preview">
                                                @if (data.Any())
                                                {
                                                    var chartType = GetChartType(component.VisualizationConfig);
                                                    <div class="chart-header mb-2">
                                                        <i class="fas fa-chart-@(GetChartIcon(chartType)) text-primary"></i>
                                                        <span class="fw-bold ms-2">@chartType Chart</span>
                                                        <small class="text-muted ms-2">(@data.Count data points)</small>
                                                    </div>
                                                    <div class="chart-data-table">
                                                        <table class="table table-sm table-striped mb-0">
                                                            <thead>
                                                                <tr>
                                                                    @foreach (var key in data[0].Keys.Take(3))
                                                                    {
                                                                        <th>@key</th>
                                                                    }
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var row in data.Take(8))
                                                                {
                                                                    <tr>
                                                                        @foreach (var key in row.Keys.Take(3))
                                                                        {
                                                                            <td>@row[key]</td>
                                                                        }
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    @if (data.Count > 8)
                                                    {
                                                        <div class="text-center text-muted small py-1">
                                                            Showing 8 of @data.Count points
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="text-center py-4 text-muted">
                                                        <i class="fas fa-chart-bar fa-2x mb-2"></i>
                                                        <p>No data available for chart</p>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (component.DataViewingTypeID == (int)DataViewingTypeEnum.Label)
                                        {
                                            @* Label Display *@
                                            <div class="label-display">
                                                @if (data.Any())
                                                {
                                                    @if (data[0].ContainsKey("value"))
                                                    {
                                                        <div class="label-value">@data[0]["value"]</div>
                                                    }
                                                    else if (data[0].Any())
                                                    {
                                                        <div class="label-value">@data[0].First().Value</div>
                                                    }
                                                    <div class="label-text">@component.Title</div>
                                                }
                                                else
                                                {
                                                    <div class="label-value">No Data</div>
                                                }
                                            </div>
                                        }
                                        else if (component.DataViewingTypeID == (int)DataViewingTypeEnum.Card)
                                        {
                                            @* Card Display *@
                                            <div class="card-display">
                                                @if (data.Any())
                                                {
                                                    var firstRow = data[0];
                                                    <div class="card-content">
                                                        @if (firstRow.ContainsKey("value"))
                                                        {
                                                            <div class="card-value">@firstRow["value"]</div>
                                                        }
                                                        else if (firstRow.Any())
                                                        {
                                                            <div class="card-value">@firstRow.First().Value</div>
                                                        }

                                                        @if (firstRow.ContainsKey("title"))
                                                        {
                                                            <div class="card-title">@firstRow["title"]</div>
                                                        }
                                                        else
                                                        {
                                                            <div class="card-title">@component.Title</div>
                                                        }

                                                        @if (firstRow.ContainsKey("description"))
                                                        {
                                                            <div class="card-description">@firstRow["description"]</div>
                                                        }
                                                        else if (!string.IsNullOrEmpty(component.Description))
                                                        {
                                                            <div class="card-description">@component.Description</div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-center py-4 text-muted">No data available</div>
                                                }
                                            </div>
                                        }
                                        else if (component.DataViewingTypeID == (int)DataViewingTypeEnum.Table)
                                        {
                                            @* Table Display *@
                                            <div class="table-responsive" style="max-height: 100%; overflow: auto;">
                                                @if (data.Any())
                                                {
                                                    <table class="table table-sm table-striped mb-0">
                                                        <thead>
                                                            <tr>
                                                                @foreach (var key in data[0].Keys.Take(6))
                                                                {
                                                                    <th>@key</th>
                                                                }
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var row in data.Take(10))
                                                            {
                                                                <tr>
                                                                    @foreach (var key in row.Keys.Take(6))
                                                                    {
                                                                        <td>@row[key]</td>
                                                                    }
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                    @if (data.Count > 10)
                                                    {
                                                        <div class="text-center text-muted small py-2">
                                                            Showing 10 of @data.Count rows
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="text-center py-4 text-muted">No data available</div>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        @* Placeholder when no data *@
                                        <div class="text-center text-muted pt-4">
                                            <i class="fas fa-chart-bar fa-2x mb-2"></i>
                                            <p>@GetComponentTypeName(component.DataViewingTypeID)</p>
                                            @if (!isPreviewMode)
                                            {
                                                <small>Click "Load Data" to preview</small>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-canvas">
                            <i class="fas fa-magic fa-3x mb-3 text-muted"></i>
                            <h5>Start Building Your Dashboard</h5>
                            <p class="text-muted">Click "Generate with AI" to create a dashboard automatically</p>
                            <button class="btn btn-success btn-lg" @onclick="ShowTemplateModal">
                                <i class="fas fa-magic me-2"></i>Generate with AI
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Sidebar: Properties Panel (Hidden in preview) -->
        @if (!isPreviewMode)
        {
            <div class="builder-sidebar builder-sidebar-right">
                @if (selectedComponentId > 0)
                {
                    var selectedComponent = dashboard.Components?.FirstOrDefault(c => c.ComponentID == selectedComponentId);
                    @if (selectedComponent != null)
                    {
                        <div class="sidebar-header">
                            <h5 class="mb-0"><i class="fas fa-cog me-2"></i>Component Settings</h5>
                        </div>
                        <div class="sidebar-body">
                            <div class="mb-3">
                                <label class="form-label">Title</label>
                                <input type="text" class="form-control" @bind="selectedComponent.Title" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <textarea class="form-control" rows="3" @bind="selectedComponent.Description"></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Query</label>
                                <textarea class="form-control font-monospace" rows="5" @bind="selectedComponent.QueryText"></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Type</label>
                                <select class="form-select" @bind="selectedComponent.DataViewingTypeID">
                                    <option value="@((int)DataViewingTypeEnum.Table)">Table</option>
                                    <option value="@((int)DataViewingTypeEnum.Chart)">Chart</option>
                                    <option value="@((int)DataViewingTypeEnum.Number)">Number/KPI</option>
                                    <option value="@((int)DataViewingTypeEnum.Card)">Card</option>
                                    <option value="@((int)DataViewingTypeEnum.Label)">Label</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <button class="btn btn-sm btn-primary w-100" @onclick="() => LoadComponentDataAsync(selectedComponent)">
                                    <i class="fas fa-play me-1"></i>Test Query
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="sidebar-header">
                        <h5 class="mb-0"><i class="fas fa-sliders-h me-2"></i>Dashboard Settings</h5>
                    </div>
                    <div class="sidebar-body">
                        <div class="mb-3">
                            <label class="form-label">Title</label>
                            <input type="text" class="form-control" @bind="dashboard.Title" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" rows="3" @bind="dashboard.Description"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Database</label>
                            <select class="form-select" @bind="dashboard.DatabaseID">
                                <option value="0">-- Select Database --</option>
                                @foreach (var ds in availableDataSources)
                                {
                                    <option value="@ds.Id">@ds.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Category</label>
                            <select class="form-select" @bind="dashboard.CategoryID">
                                <option value="0">-- Select Category --</option>
                                @foreach (var category in availableCategories)
                                {
                                    <option value="@category.CategoryID">@category.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Sharing Status</label>
                            <select class="form-select" @bind="dashboard.SharingStatus">
                                <option value="@DashboardSharingStatus.Private">Private</option>
                                <option value="@DashboardSharingStatus.Shared">Shared</option>
                                <option value="@DashboardSharingStatus.Public">Public</option>
                            </select>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <style>
        /* Preview Mode Styles */
        .builder-content.preview-mode {
        background: #f5f5f5;
        }

        .builder-canvas-container.fullscreen {
        width: 100%;
        flex: 1;
        }

        /* KPI Display */
        .kpi-display {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100%;
        padding: 1rem;
        }

        .kpi-value {
        font-size: 2.5rem;
        font-weight: 700;
        color: #667eea;
        line-height: 1;
        margin-bottom: 0.5rem;
        }

        .kpi-label {
        font-size: 0.9rem;
        color: #718096;
        text-align: center;
        }

        /* Chart Preview */
        .chart-preview {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100%;
        padding: 1rem;
        }

        /* Table in component */
        .component-body .table {
        font-size: 0.85rem;
        }

        .component-body .table th {
        background: #f8f9fa;
        position: sticky;
        top: 0;
        z-index: 1;
        }

        .chart-data-preview {
        padding: 1rem;
        height: 100%;
        overflow: auto;
        }

        .chart-header {
        border-bottom: 2px solid #e9ecef;
        padding-bottom: 0.5rem;
        margin-bottom: 0.75rem;
        }

        .chart-data-table {
        font-size: 0.85rem;
        }

        .chart-data-table .table th {
        background: #f8f9fa;
        font-weight: 600;
        position: sticky;
        top: 0;
        z-index: 1;
        }

        /* Label Display */
        .label-display {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100%;
        padding: 1.5rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        }

        .label-value {
        font-size: 3rem;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 0.5rem;
        text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        }

        .label-text {
        font-size: 1.1rem;
        font-weight: 500;
        text-align: center;
        opacity: 0.95;
        }

        /* Card Display */
        .card-display {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100%;
        padding: 1.5rem;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        }

        .card-content {
        text-align: center;
        width: 100%;
        }

        .card-value {
        font-size: 2.5rem;
        font-weight: 700;
        color: #2d3748;
        margin-bottom: 0.5rem;
        }

        .card-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #4a5568;
        margin-bottom: 0.25rem;
        }

        .card-description {
        font-size: 0.9rem;
        color: #718096;
        line-height: 1.4;
        }

        /* Steps Indicator */
        .steps-indicator {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 2rem;
        }

        .step {
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
        }

        .step-number {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #e0e0e0;
            color: #999;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 1.1rem;
            transition: all 0.3s;
        }

        .step.active .step-number {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }

        .step.completed .step-number {
            background: #10b981;
            color: white;
        }

            .step.completed .step-number::before {
                content: "✓";
            }

        .step-label {
            margin-top: 0.5rem;
            font-size: 0.85rem;
            color: #999;
            font-weight: 500;
        }

        .step.active .step-label {
            color: #667eea;
            font-weight: 600;
        }

        .step-line {
            width: 80px;
            height: 2px;
            background: #e0e0e0;
            margin: 0 1rem;
            transition: all 0.3s;
        }

            .step-line.active {
                background: #667eea;
            }

        /* Chart Type Grid */
        .chart-type-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
        }

        .chart-type-option {
            border: 2px solid #dee2e6;
            border-radius: 12px;
            padding: 1.5rem 1rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

            .chart-type-option:hover {
                border-color: #667eea;
                background: #f8f9ff;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(102, 126, 234, 0.2);
            }

            .chart-type-option.selected {
                border-color: #667eea;
                background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.2);
            }

            .chart-type-option i {
                color: #667eea;
            }

            .chart-type-option span {
                font-weight: 600;
                color: #2d3748;
            }

        /* Size Selection Grid */
        .size-selection-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
        }

        .size-option {
            border: 2px solid #dee2e6;
            border-radius: 12px;
            padding: 1.5rem 1rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
        }

            .size-option:hover {
                border-color: #667eea;
                background: #f8f9ff;
                transform: translateY(-2px);
            }

            .size-option.selected {
                border-color: #667eea;
                background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.2);
            }

        .size-preview {
            background: #667eea;
            margin: 0 auto 1rem;
            border-radius: 4px;
        }

        .small-preview {
            width: 60px;
            height: 40px;
        }

        .medium-preview {
            width: 90px;
            height: 60px;
        }

        .large-preview {
            width: 120px;
            height: 80px;
        }

        .size-option span {
            font-weight: 600;
            color: #2d3748;
            font-size: 0.9rem;
        }

        /* SQL Preview */
        .sql-preview {
            background: #2d3748;
            border-radius: 8px;
            padding: 1rem;
            max-height: 200px;
            overflow: auto;
        }

            .sql-preview pre {
                margin: 0;
                color: #e2e8f0;
                font-family: 'Courier New', monospace;
                font-size: 0.9rem;
                white-space: pre-wrap;
            }

            .sql-preview code {
                color: #a0aec0;
            }

        /* Examples Section */
        .examples-section {
            background: #f8f9fa;
            padding: 1rem;
            border-radius: 8px;
            margin-top: 1rem;
        }

        /* Step Content Animation */
        .step-content {
            animation: fadeInUp 0.4s ease-out;
        }



