    /// <summary>
    /// Step 2: Generate SQL and add chart to dashboard
    /// </summary>
    private async Task GenerateSqlAndAddChart()
    {
        if (string.IsNullOrWhiteSpace(customChartTitle))
        {
            ToastService.ShowWarning("Please enter a chart title");
            return;
        }

        if (analysisResponse == null)
        {
            ToastService.ShowError("No analysis response available");
            return;
        }

        isGeneratingSql = true;
        StateHasChanged();

        try
        {
            // Prepare SQL generation request
            var request = new NlQueryConfirmationRequest
            {
                OriginalQuestion = customChartQuery,
                DatabaseId = dashboard.DatabaseID,
                ConfirmedUnderstanding = analysisResponse.Explanation,
                ResolvedAmbiguities = new Dictionary<string, string>(),
                AdjustedParameters = new Dictionary<string, string>()
            };

            var response = await Http.PostAsJsonAsync("api/query/generate", request);

            if (response.IsSuccessStatusCode)
            {
                var sqlResponse = await response.Content.ReadFromJsonAsync<SqlGenerationResponse>();

                if (sqlResponse != null && sqlResponse.Success)
                {
                    customChartSql = sqlResponse.GeneratedSql;

                    // Add the chart to dashboard
                    AddCustomChartToDashboard();

                    // Move to success step
                    addChartStep = 3;
                    ToastService.ShowSuccess("Chart added to dashboard!");
                }
                else
                {
                    ToastService.ShowError("Failed to generate SQL query");
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error generating SQL: {error}");
                ToastService.ShowError("Failed to generate SQL");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception: {ex}");
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isGeneratingSql = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Adds the custom chart to the dashboard
    /// </summary>
    private void AddCustomChartToDashboard()
    {
        try
        {
            // Determine size based on selection
            var (width, height) = customChartSize switch
            {
                "small" => (3, 2),
                "medium" => (6, 3),
                "large" => (12, 4),
                _ => (6, 3)
            };

            // Find optimal position
            var (x, y) = FindOptimalPosition(width, height);

            // Create visualization config with chart type
            var visualizationConfig = new
            {
                chartType = customChartType,
                showLegend = true,
                showGrid = true,
                showDataLabels = false
            };

            // Create new component
            var newComponent = new DashboardComponent
            {
                ComponentID = dashboard.Components.Any()
                        ? dashboard.Components.Max(c => c.ComponentID) + 1
                        : 1,
                Title = customChartTitle,
                Description = customChartExplanation,
                QueryText = customChartSql,
                QueryIntent = customChartQuery,
                DataViewingTypeID = (int)DataViewingTypeEnum.Chart,
                DataViewingTypeName = "Chart",
                ChartType = customChartType, // Store chart type in dedicated field
                GridX = x,
                GridY = y,
                GridWidth = width,
                GridHeight = height,
                VisualizationConfig = JsonSerializer.Serialize(visualizationConfig),
                FilterExpression = "",
                RefreshInterval = 0,
                IsAIGenerated = true,
                IsValidated = false,
                IsVisible = true,
                CreatedAt = DateTime.UtcNow,
                LastUpdated = DateTime.UtcNow
            };

            // Add to dashboard
            dashboard.Components.Add(newComponent);

            // Mark as unsaved
            hasUnsavedChanges = true;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding chart: {ex}");
            ToastService.ShowError($"Error adding chart: {ex.Message}");
        }
    }

