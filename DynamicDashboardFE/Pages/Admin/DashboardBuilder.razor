                                            <i class="fas fa-search me-1"></i> Enable Search
                                        </label>
                                    </div>

                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" @bind="tableEnableSort" id="tableSort">
                                        <label class="form-check-label" for="tableSort">
