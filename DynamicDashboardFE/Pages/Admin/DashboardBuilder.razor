@* @page "/dashboard/builder"
@page "/dashboard/builder/{DashboardId:int}"
@using DynamicDashboardCommon.Models
@using Microsoft.AspNetCore.Components.Web
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IToastService ToastService
@inject IJSRuntime JSRuntime

<div class="dashboard-builder @(isDragging ? "is-dragging" : "")">
    <!-- Header Section -->
    <div class="builder-header shadow-sm">
        <div class="d-flex justify-content-between align-items-center px-3 py-2">
            <div class="d-flex align-items-center">
                <button class="btn btn-icon me-2" @onclick='() => NavigationManager.NavigateTo("/marketplace")'>
                    <i class="fas fa-arrow-left"></i>
                </button>
                <div class="dashboard-title-container">
                    @if (isEditingTitle)
                    {
                        <input type="text" class="form-control dashboard-title-input" 
                               @bind="dashboard.Title" 
                               @blur="FinishTitleEdit" 
                               @onkeydown="@HandleTitleKeyDown"
                               @ref="titleInputRef" />
                    }
                    else
                    {
                        <h4 class="mb-0 dashboard-title" @onclick="StartTitleEdit">
                            @(string.IsNullOrEmpty(dashboard.Title) ? "Untitled Dashboard" : dashboard.Title)
                            <i class="fas fa-pencil-alt ms-2 edit-icon"></i>
                        </h4>
                    }
                </div>
            </div>
            <div class="builder-actions">
                <div class="btn-group me-2">
                    <button class="btn btn-outline-secondary" title="Undo" @onclick="UndoAction" disabled="@(!canUndo)">
                        <i class="fas fa-undo"></i>
                    </button>
                    <button class="btn btn-outline-secondary" title="Redo" @onclick="RedoAction" disabled="@(!canRedo)">
                        <i class="fas fa-redo"></i>
                    </button>
                </div>
                <div class="btn-group me-2">
                    <button class="btn btn-outline-primary" title="Preview Dashboard" @onclick="PreviewDashboard">
                        <i class="fas fa-eye me-1"></i>
                        Preview
                    </button>
                    <button class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown">
                        <span class="visually-hidden">Toggle Dropdown</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <button class="dropdown-item" @onclick='() => SetPreviewMode("desktop")'>
                                <i class="fas fa-desktop me-2"></i>
                                Desktop View
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" @onclick='() => SetPreviewMode("tablet")'>
                                <i class="fas fa-tablet-alt me-2"></i>
                                Tablet View
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" @onclick='() => SetPreviewMode("mobile")'>
                                <i class="fas fa-mobile-alt me-2"></i>
                                Mobile View
                            </button>
                        </li>
                    </ul>
                </div>

                <!-- Export Button with Dropdown -->
                <div class="btn-group me-2">
                    <button class="btn btn-outline-secondary" @onclick="ShowExportModal">
                        <i class="fas fa-file-export me-1"></i>
                        Export
                    </button>
                    <button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                        <span class="visually-hidden">Toggle Dropdown</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <button class="dropdown-item" @onclick='() => ExportDashboard("pdf")'>
                                <i class="fas fa-file-pdf me-2 text-danger"></i>
                                Export as PDF
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" @onclick='() => ExportDashboard("image")'>
                                <i class="fas fa-file-image me-2 text-primary"></i>
                                Export as Image
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" @onclick='() => ExportDashboard("excel")'>
                                <i class="fas fa-file-excel me-2 text-success"></i>
                                Export Data to Excel
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" @onclick='() => ExportDashboard("json")'>
                                <i class="fas fa-file-code me-2 text-warning"></i>
                                Export Configuration
                            </button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button class="dropdown-item" @onclick="ShowScheduleExportModal">
                                <i class="fas fa-calendar-alt me-2"></i>
                                Schedule Export
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="btn-group">
                    <button class="btn btn-primary" @onclick="SaveDashboard">
                        <i class="fas fa-save me-1"></i>
                        Save
                    </button>
                    <button class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown">
                        <span class="visually-hidden">Toggle Dropdown</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <button class="dropdown-item" @onclick='() => SaveDashboardAs()'>
                                <i class="fas fa-save me-2"></i>
                                Save As...
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" @onclick='() => ShareDashboard()'>
                                <i class="fas fa-share-alt me-2"></i>
                                Share Dashboard
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="builder-tabs">
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "design" ? "active" : "")" @onclick='() => SetActiveTab("design")'>
                        <i class="fas fa-palette me-1"></i> Design
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "data" ? "active" : "")" @onclick='() => SetActiveTab("data")'>
                        <i class="fas fa-database me-1"></i> Data
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "settings" ? "active" : "")" @onclick='() => SetActiveTab("settings")'>
                        <i class="fas fa-cog me-1"></i> Settings
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="builder-content">
        <!-- Left Sidebar: Component Library -->
        <div class="builder-sidebar builder-sidebar-left">
            <BuilderComponentLibrary 
                OnComponentSelected="AddComponent"
                AvailableComponents="availableComponents"
                SearchTerm="@componentSearchTerm"
                OnSearchChanged="@((value) => componentSearchTerm = value)" />
        </div>

        <!-- Center: Canvas Area -->
        <div class="builder-canvas-container">
            <div class="builder-canvas-toolbar">
                <div class="btn-group me-2">
                    <button class="btn btn-sm btn-outline-secondary" title="Zoom Out" @onclick="ZoomOut">
                        <i class="fas fa-search-minus"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary px-3">@(Math.Round(zoomLevel * 100))%</button>
                    <button class="btn btn-sm btn-outline-secondary" title="Zoom In" @onclick="ZoomIn">
                        <i class="fas fa-search-plus"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" title="Reset Zoom" @onclick="ResetZoom">
                        <i class="fas fa-compress-arrows-alt"></i>
                    </button>
                </div>
                <div class="form-check form-switch ms-2">
                    <input class="form-check-input" type="checkbox" @bind="showGrid" id="showGridSwitch">
                    <label class="form-check-label" for="showGridSwitch">Show Grid</label>
                </div>
                <div class="spacer"></div>
                <div class="btn-group">
                    <button class="btn btn-sm btn-outline-secondary" title="Add Row" @onclick="AddRow">
                        <i class="fas fa-plus"></i> Add Row
                    </button>
                </div>
            </div>

            <div class="builder-canvas @(showGrid ? "show-grid" : "")" style="transform: scale(@zoomLevel);">
                @if (!dashboard.Components.Any())
                {
                    <div class="empty-canvas-message">
                        <div class="message-content">
                            <i class="fas fa-shapes fa-3x mb-3 text-muted"></i>
                            <h4>Your dashboard is empty</h4>
                            <p class="text-muted">Drag components from the library to start building your dashboard</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="dashboard-grid" 
                         style="grid-template-columns: repeat(12, 1fr); min-height: @(GetCanvasHeight())px;">
                        @foreach (var component in dashboard.Components.Where(c => c.IsVisible).OrderBy(c => c.GridY).ThenBy(c => c.GridX))
                        {
                            <div class="dashboard-grid-item @(selectedComponentId == component.ComponentID ? "selected" : "")" 
                                 style="grid-column: @(component.GridX + 1) / span @component.GridWidth; grid-row: @(component.GridY + 1) / span @component.GridHeight;"
                                 @onclick='() => SelectComponent(component.ComponentID)'
                                 @onmousedown='(e) => StartDragComponent(e, component.ComponentID)'
                                 @key="component.ComponentID">
                                <div class="component-container">
                                    <div class="component-header">
                                        <span class="component-title">@component.Title</span>
                                        <div class="component-controls">
                                            <button class="btn btn-icon" title="Component Menu" @onclick:stopPropagation="true" @onclick="(e) => ShowComponentMenu(e, component)">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="component-content">
                                        <!-- Component preview based on type -->
                                        @switch (component.DataViewingTypeID)
                                        {
                                            case (int)DataViewingTypeEnum.Table:
                                                <ComponentTable Component="component" Data="GetSampleData(component)" />
                                                break;
                                            case (int)DataViewingTypeEnum.Label:
                                                <ComponentLabel Component="component" />
                                                break;
                                            case (int)DataViewingTypeEnum.Number:
                                                <ComponentNumber Component="component" Data="GetSampleData(component)" />
                                                break;
                                            case (int)DataViewingTypeEnum.Chart:
                                                <ComponentChart Component="component" Data="GetSampleData(component)" />
                                                break;
                                            case (int)DataViewingTypeEnum.Card:
                                                <ComponentCard Component="component" Data="GetSampleData(component)" />
                                                break;
                                            default:
                                                <div class="text-center text-muted pt-4">
                                                    <i class="fas fa-chart-bar fa-2x mb-2"></i>
                                                    <p>Component Preview</p>
                                                </div>
                                                break;
                                        }
                                    </div>
                                    <div class="component-resize-handle" @onmousedown='(e) => StartResize(e, component.ComponentID)'></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Right Sidebar: Properties Panel -->
        <div class="builder-sidebar builder-sidebar-right">
            @if (selectedComponentId > 0)
            {
                <BuilderPropertyEditor 
                    Component="GetSelectedComponent()"
                    OnComponentUpdated="UpdateComponent"
                    AvailableDataSources="availableDataSources"
                    OnQueryChange="HandleQueryChange" />
            }
            else
            {
                <BuilderDashboardSettings
                    Dashboard="dashboard"
                    OnDashboardUpdated="UpdateDashboard"
                    Categories="availableCategories" />
            }
        </div>
    </div>

    <!-- Export Modal -->
    <BuilderExportModal 
        @ref="exportModal"
        Dashboard="dashboard"
        SelectedComponentId="selectedComponentId"
        OnExportCompleted="HandleExportCompleted" />

    <!-- Share Modal -->
    <BuilderShareModal
        @ref="shareModal"
        Dashboard="dashboard"
        OnShareCompleted="HandleShareCompleted" />

    <!-- Save As Modal -->
    <BuilderSaveAsModal
        @ref="saveAsModal"
        Dashboard="dashboard"
        OnSaveAsCompleted="HandleSaveAsCompleted" />

    <!-- Component Menu Context Menu (Positioned by JS) -->
    @if (showComponentMenu)
    {
        <div class="component-context-menu" style="top: @(menuPosY)px; left: @(menuPosX)px;">
            <ul class="context-menu-list">
                <li>
                    <button class="context-menu-item" @onclick="DuplicateComponent">
                        <i class="fas fa-clone me-2"></i>
                        Duplicate
                    </button>
                </li>
                <li>
                    <button class="context-menu-item" @onclick="RemoveComponent">
                        <i class="fas fa-trash-alt me-2"></i>
                        Remove
                    </button>
                </li>
                <li class="context-menu-divider"></li>
                <li>
                    <button class="context-menu-item" @onclick="ExportComponentData">
                        <i class="fas fa-file-export me-2"></i>
                        Export Data
                    </button>
                </li>
                <li>
                    <button class="context-menu-item" @onclick="BringComponentForward">
                        <i class="fas fa-level-up-alt me-2"></i>
                        Bring Forward
                    </button>
                </li>
                <li>
                    <button class="context-menu-item" @onclick="SendComponentBackward">
                        <i class="fas fa-level-down-alt me-2"></i>
                        Send Backward
                    </button>
                </li>
            </ul>
        </div>
    }
</div>

@code {
    [Parameter]
    public int DashboardId { get; set; }

    private DashboardModel dashboard = new DashboardModel();
    private List<DashboardCategory> availableCategories = new List<DashboardCategory>();
    private List<DataSource> availableDataSources = new List<DataSource>();
    private List<ComponentTemplate> availableComponents = new List<ComponentTemplate>();
    
    private int selectedComponentId;
    private string activeTab = "design";
    private bool isEditingTitle;
    private ElementReference titleInputRef;
    private string componentSearchTerm = "";
    
    // Canvas state
    private bool showGrid = true;
    private double zoomLevel = 1.0;
    private int lastGridY = 0;
    
    // Drag state
    private bool isDragging;
    private int dragComponentId;
    private double dragStartX;
    private double dragStartY;
    private int originalGridX;
    private int originalGridY;
    
    // Resize state
    private bool isResizing;
    private int resizeComponentId;
    private int originalWidth;
    private int originalHeight;
    private double resizeStartX;
    private double resizeStartY;
    
    // Component menu
    private bool showComponentMenu;
    private int menuPosX;
    private int menuPosY;
    private DashboardComponent contextMenuComponent;
    
    // History for undo/redo
    private List<string> history = new List<string>();
    private int historyIndex = -1;
    private bool isUndoRedoAction;
    private bool canUndo => historyIndex > 0;
    private bool canRedo => historyIndex < history.Count - 1;
    
    // References to child components
    private BuilderExportModal exportModal;
    private BuilderShareModal shareModal;
    private BuilderSaveAsModal saveAsModal;

    // Other state
    private bool hasUnsavedChanges;
    private System.Timers.Timer autoSaveTimer;
    private string previewMode = "desktop";

    protected override async Task OnInitializedAsync()
    {
        // Initialize auto-save timer
        autoSaveTimer = new System.Timers.Timer(30000); // 30 seconds
        autoSaveTimer.Elapsed += async (sender, e) => await AutoSave();
        autoSaveTimer.AutoReset = true;
        autoSaveTimer.Start();

        // Load available categories
        await LoadCategories();
        
        // Load available data sources
        await LoadDataSources();
        
        // Load available component templates
        await LoadComponentTemplates();
        
        // Load dashboard if ID is provided
        if (DashboardId > 0)
        {
            await LoadDashboard();
        }
        else
        {
            // Create a new dashboard
            dashboard = new DashboardModel
            {
                Title = "New Dashboard",
                Description = "",
                Components = new List<DashboardComponent>(),
                CreatedAt = DateTime.UtcNow,
                LastUpdated = DateTime.UtcNow,
                SharingStatus = DashboardSharingStatus.Private,
                ValidationStatus = DashboardValidationStatus.Draft,
                Tags = new List<string>()
            };
            
            // Add initial dashboard state to history
            AddToHistory();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Set up JS event handlers for drag and resize
            await JSRuntime.InvokeVoidAsync("dashboardBuilder.init", DotNetObjectReference.Create(this));
        }
        
        if (isEditingTitle)
        {
            await JSRuntime.InvokeVoidAsync("dashboardBuilder.focusElement", titleInputRef);
        }
    }

    private async Task LoadDashboard()
    {
        try
        {
            dashboard = await Http.GetFromJsonAsync<DashboardModel>($"api/dashboard/{DashboardId}");
            
            if (dashboard != null)
            {
                // Add initial dashboard state to history
                AddToHistory();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading dashboard: {ex.Message}");
            dashboard = new DashboardModel();
        }
    }

    private async Task LoadCategories()
    {
        try
        {
            availableCategories = await Http.GetFromJsonAsync<List<DashboardCategory>>("api/dashboard/categories") ?? new List<DashboardCategory>();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading categories: {ex.Message}");
        }
    }

    private async Task LoadDataSources()
    {
        try
        {
            // Load data sources (databases)
            var databases = await Http.GetFromJsonAsync<List<Database>>("api/databases") ?? new List<Database>();
            availableDataSources = databases
                .Where(db => db.IsActive)
                .Select(db => new DataSource { Id = db.DatabaseID, Name = db.Name })
                .ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading data sources: {ex.Message}");
        }
    }

    private async Task LoadComponentTemplates()
    {
        try
        {
            // We'll mock component templates for now
            // In a real implementation, these would come from an API
            availableComponents = new List<ComponentTemplate>
            {
                new ComponentTemplate
                {
                    Id = 1,
                    Title = "Table",
                    Description = "Display data in tabular format",
                    DataViewingTypeID = (int)DataViewingTypeEnum.Table,
                    Icon = "fa-table",
                    Category = "Data Display"
                },
                new ComponentTemplate
                {
                    Id = 2,
                    Title = "Bar Chart",
                    Description = "Visualize data with bars",
                    DataViewingTypeID = (int)DataViewingTypeEnum.Chart,
                    Icon = "fa-chart-bar",
                    Category = "Charts",
                    VisualizationConfig = JsonSerializer.Serialize(new { chartType = "bar" })
                },
                new ComponentTemplate
                {
                    Id = 3,
                    Title = "Line Chart",
                    Description = "Visualize trends over time",
                    DataViewingTypeID = (int)DataViewingTypeEnum.Chart,
                    Icon = "fa-chart-line",
                    Category = "Charts",
                    VisualizationConfig = JsonSerializer.Serialize(new { chartType = "line" })
                },
                new ComponentTemplate
                {
                    Id = 4,
                    Title = "Pie Chart",
                    Description = "Display proportion of categories",
                    DataViewingTypeID = (int)DataViewingTypeEnum.Chart,
                    Icon = "fa-chart-pie",
                    Category = "Charts",
                    VisualizationConfig = JsonSerializer.Serialize(new { chartType = "pie" })
                },
                new ComponentTemplate
                {
                    Id = 5,
                    Title = "KPI Card",
                    Description = "Display key metrics with indicators",
                    DataViewingTypeID = (int)DataViewingTypeEnum.Number,
                    Icon = "fa-tachometer-alt",
                    Category = "KPIs"
                },
                new ComponentTemplate
                {
                    Id = 6,
                    Title = "Text Label",
                    Description = "Add titles, descriptions, or notes",
                    DataViewingTypeID = (int)DataViewingTypeEnum.Label,
                    Icon = "fa-font",
                    Category = "Text"
                },
                new ComponentTemplate
                {
                    Id = 7,
                    Title = "Info Card",
                    Description = "Display information in card format",
                    DataViewingTypeID = (int)DataViewingTypeEnum.Card,
                    Icon = "fa-id-card",
                    Category = "Data Display"
                }
            };
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading component templates: {ex.Message}");
        }
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
    }

    private void StartTitleEdit()
    {
        isEditingTitle = true;
    }

    private void FinishTitleEdit()
    {
        isEditingTitle = false;
        UpdateDashboard(dashboard);
    }

    private void HandleTitleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            isEditingTitle = false;
            UpdateDashboard(dashboard);
        }
        else if (e.Key == "Escape")
        {
            isEditingTitle = false;
        }
    }

    private void SelectComponent(int componentId)
    {
        selectedComponentId = componentId;
    }

    private DashboardComponent GetSelectedComponent()
    {
        return dashboard.Components.FirstOrDefault(c => c.ComponentID == selectedComponentId);
    }

    private void UpdateComponent(DashboardComponent component)
    {
        var index = dashboard.Components.FindIndex(c => c.ComponentID == component.ComponentID);
        if (index >= 0)
        {
            dashboard.Components[index] = component;
            hasUnsavedChanges = true;
            
            // Add to history
            AddToHistory();
        }
    }

    private void UpdateDashboard(DashboardModel updatedDashboard)
    {
        dashboard = updatedDashboard;
        hasUnsavedChanges = true;
        
        // Add to history
        AddToHistory();
    }

    private void AddComponent(ComponentTemplate template)
    {
        // Find the highest ComponentID to assign a new unique ID
        int nextId = dashboard.Components.Any() ? 
            dashboard.Components.Max(c => c.ComponentID) + 1 : 1;
        
        // Find the highest GridY to place the component at the bottom
        int gridY = dashboard.Components.Any() ?
            dashboard.Components.Max(c => c.GridY + c.GridHeight) : 0;
        
        // Create new component
        var component = new DashboardComponent
        {
            ComponentID = nextId,
            DashboardID = dashboard.DashboardID,
            Title = template.Title,
            Description = template.Description,
            DataViewingTypeID = template.DataViewingTypeID,
            GridX = 0, // Start at left edge
            GridY = gridY, // Place at the bottom
            GridWidth = 6, // Default half width
            GridHeight = 4, // Default height
            IsVisible = true,
            CreatedAt = DateTime.UtcNow,
            LastUpdated = DateTime.UtcNow,
            VisualizationConfig = template.VisualizationConfig
        };
        
        // Add default query for data components
        if (component.DataViewingTypeID != (int)DataViewingTypeEnum.Label)
        {
            component.QueryText = "SELECT * FROM Customers LIMIT 10"; // Default query
            component.QueryIntent = "Show customer data";
        }
        
        // Add component to dashboard
        dashboard.Components.Add(component);
        
        // Select the new component
        selectedComponentId = component.ComponentID;
        
        // Update last used grid Y
        lastGridY = gridY + component.GridHeight;
        
        // Add to history
        AddToHistory();
        
        hasUnsavedChanges = true;
    }

    private void StartDragComponent(MouseEventArgs e, int componentId)
    {
        var component = dashboard.Components.FirstOrDefault(c => c.ComponentID == componentId);
        if (component == null) return;
        
        isDragging = true;
        dragComponentId = componentId;
        dragStartX = e.ClientX;
        dragStartY = e.ClientY;
        originalGridX = component.GridX;
        originalGridY = component.GridY;
        
        // Select the component being dragged
        selectedComponentId = componentId;
    }

    private void StartResize(MouseEventArgs e, int componentId)
    {
        var component = dashboard.Components.FirstOrDefault(c => c.ComponentID == componentId);
        if (component == null) return;
        
        isResizing = true;
        resizeComponentId = componentId;
        resizeStartX = e.ClientX;
        resizeStartY = e.ClientY;
        originalWidth = component.GridWidth;
        originalHeight = component.GridHeight;
        
        // Select the component being resized
        selectedComponentId = componentId;
    }

    [JSInvokable]
    public void OnDrag(double deltaX, double deltaY)
    {
        if (!isDragging) return;
        
        var component = dashboard.Components.FirstOrDefault(c => c.ComponentID == dragComponentId);
        if (component == null) return;
        
        // Convert pixel delta to grid cells
        int cellWidth = 100; // Grid cell width in pixels
        int cellHeight = 100; // Grid cell height in pixels
        
        int deltaGridX = (int)Math.Round(deltaX / cellWidth);
        int deltaGridY = (int)Math.Round(deltaY / cellHeight);
        
        // Calculate new position
        int newGridX = originalGridX + deltaGridX;
        int newGridY = originalGridY + deltaGridY;
        
        // Apply grid bounds
        newGridX = Math.Max(0, Math.Min(newGridX, 12 - component.GridWidth));
        newGridY = Math.Max(0, newGridY);
        
        // Update component position
        component.GridX = newGridX;
        component.GridY = newGridY;
        
        StateHasChanged();
    }

    [JSInvokable]
    public void OnDragEnd()
    {
        if (isDragging)
        {
            isDragging = false;
            var component = dashboard.Components.FirstOrDefault(c => c.ComponentID == dragComponentId);
            if (component != null && (component.GridX != originalGridX || component.GridY != originalGridY))
            {
                // Add to history when position has changed
                AddToHistory();
                hasUnsavedChanges = true;
            }
        }
    }

    [JSInvokable]
    public void OnResize(double deltaX, double deltaY)
    {
        if (!isResizing) return;
        
        var component = dashboard.Components.FirstOrDefault(c => c.ComponentID == resizeComponentId);
        if (component == null) return;
        
        // Convert pixel delta to grid cells
        int cellWidth = 100; // Grid cell width in pixels
        int cellHeight = 100; // Grid cell height in pixels
        
        int deltaGridWidth = (int)Math.Round(deltaX / cellWidth);
        int deltaGridHeight = (int)Math.Round(deltaY / cellHeight);
        
        // Calculate new size
        int newGridWidth = originalWidth + deltaGridWidth;
        int newGridHeight = originalHeight + deltaGridHeight;
        
        // Apply min/max constraints
        newGridWidth = Math.Max(2, Math.Min(newGridWidth, 12));
        newGridHeight = Math.Max(2, newGridHeight);
        
        // Apply grid bounds
        newGridWidth = Math.Min(newGridWidth, 12 - component.GridX);
        
        // Update component size
        component.GridWidth = newGridWidth;
        component.GridHeight = newGridHeight;
        
        StateHasChanged();
    }

    [JSInvokable]
    public void OnResizeEnd()
    {
        if (isResizing)
        {
            isResizing = false;
            var component = dashboard.Components.FirstOrDefault(c => c.ComponentID == resizeComponentId);
            if (component != null && (component.GridWidth != originalWidth || component.GridHeight != originalHeight))
            {
                // Add to history when size has changed
                AddToHistory();
                hasUnsavedChanges = true;
            }
        }
    }

