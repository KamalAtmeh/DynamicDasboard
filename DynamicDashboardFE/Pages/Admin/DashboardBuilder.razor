    private string FormatNumericValue(object value, DashboardComponent component)
    {
        if (value == null)
            return "N/A";

        // Try to parse as decimal
        if (!decimal.TryParse(value.ToString(), out decimal numericValue))
            return value.ToString();

        // Check if it's a percentage (rate, percentage, ratio)
        if (IsPercentageValue(component))
        {
            // If value is already 0-100, just add %
            if (numericValue <= 100)
                return $"{numericValue:N2}%";
            // If value is decimal (0.00-1.00), multiply by 100
            else if (numericValue < 1)
                return $"{(numericValue * 100):N2}%";
            else
                return $"{numericValue:N2}%";
        }

        // Check if it's currency
        if (IsCurrencyValue(component))
        {
            return numericValue.ToString("C2"); // $500.00
        }

        // Check if it's a time value
        if (IsTimeValue(component))
        {
            return FormatTimeValue(numericValue, component);
        }

        // Check if it's a whole number (count/ID)
        if (IsWholeNumber(component) || numericValue == Math.Floor(numericValue))
        {
            return numericValue.ToString("N0"); // 1,234
        }

        // Default: 2 decimal places
        return numericValue.ToString("N2"); // 1,234.56
    }

    private bool IsPercentageValue(DashboardComponent component)
    {
        var text = $"{component.Title} {component.Description} {component.QueryIntent}".ToLower();
        return text.Contains("rate") ||
               text.Contains("percentage") ||
               text.Contains("percent") ||
               text.Contains("%") ||
               text.Contains("ratio");
    }

    private bool IsCurrencyValue(DashboardComponent component)
    {
        var text = $"{component.Title} {component.Description} {component.QueryIntent}".ToLower();
        return text.Contains("amount") ||
               text.Contains("revenue") ||
               text.Contains("cost") ||
               text.Contains("price") ||
               text.Contains("fine") ||
               text.Contains("payment") ||
               text.Contains("total revenue") ||
               text.Contains("salary");
    }

    private bool IsTimeValue(DashboardComponent component)
    {
        var text = $"{component.Title} {component.Description}".ToLower();
        return text.Contains("time") ||
               text.Contains("duration") ||
               text.Contains("day") ||
               text.Contains("hour") ||
               text.Contains("minute");
    }

    private bool IsWholeNumber(DashboardComponent component)
    {
        var text = $"{component.Title} {component.Description} {component.QueryIntent}".ToLower();
        return text.Contains("count") ||
               text.Contains("total") ||
               text.Contains("number of") ||
               text.Contains("active") ||
               text.Contains("pending") ||
               text.Contains("camera") ||
               text.Contains("incident");
    }

    private string FormatTimeValue(decimal value, DashboardComponent component)
    {
        var text = $"{component.Title} {component.Description}".ToLower();

        if (text.Contains("day"))
        {
            return value == 1 ? "1 day" : $"{value:N0} days";
        }
        else if (text.Contains("hour"))
        {
            return value == 1 ? "1 hour" : $"{value:N0} hours";
        }
        else if (text.Contains("minute"))
        {
            return value == 1 ? "1 min" : $"{value:N0} mins";
        }

        return $"{value:N2}";
    }

    /// <summary>
    /// Gets the component type name from the DataViewingTypeID
    /// </summary>
    private string GetComponentTypeName(int dataViewingTypeID)
    {
        return dataViewingTypeID switch
        {
            (int)DataViewingTypeEnum.Table => "Table",
            (int)DataViewingTypeEnum.Chart => "Chart",
            (int)DataViewingTypeEnum.Number => "Number",
            (int)DataViewingTypeEnum.Card => "Card",
            (int)DataViewingTypeEnum.Label => "Label",
            _ => "Unknown"
        };
    }


