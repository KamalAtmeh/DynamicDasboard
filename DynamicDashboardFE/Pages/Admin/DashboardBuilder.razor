    /// <summary>
    /// Step 1: Analyze the natural language query using simplified chart analysis
    /// </summary>
    private async Task AnalyzeChartQuery()
    {
        if (string.IsNullOrWhiteSpace(customChartQuery))
        {
            ToastService.ShowWarning("Please enter a description");
            return;
        }

        isAnalyzing = true;
        StateHasChanged();

        try
        {
            var request = new NlQueryRequest
            {
                Question = customChartQuery,
                DatabaseId = dashboard.DatabaseID
            };

            // Use simplified chart analysis endpoint
            var response = await Http.PostAsJsonAsync("api/query/analyze-chart", request);

            if (response.IsSuccessStatusCode)
            {
                var chartExplanation = await response.Content.ReadFromJsonAsync<ChartExplanationResponse>();

                if (chartExplanation != null && chartExplanation.Success)
                {
                    // Store only the explanation
                    customChartExplanation = chartExplanation.Explanation;

                    // Create a simple analysis response for the generate step
                    analysisResponse = new AnalysisResponse
                    {
                        Explanation = chartExplanation.Explanation,
                        Success = true
                    };

                    // Auto-generate a title from the question
                    if (string.IsNullOrWhiteSpace(customChartTitle))
                    {
                        customChartTitle = GenerateTitleFromQuestion(customChartQuery);
                    }

                    // Move to configuration step
                    addChartStep = 2;
                    ToastService.ShowSuccess("Query analyzed successfully!");
                }
                else
                {
                    ToastService.ShowError(chartExplanation?.ErrorMessage ?? "Failed to analyze query");
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error analyzing query: {error}");
                ToastService.ShowError("Failed to analyze query");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception: {ex}");
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isAnalyzing = false;
            StateHasChanged();
        }
    }

