    // ==================== UNDO / REDO ====================
    private bool CanUndo => _undoStack.Count > 1;
    private bool CanRedo => _redoStack.Count > 0;

    private void SaveToHistory()
    {
        var state = JsonSerializer.Serialize(_components);
        _undoStack.Push(state);
        _redoStack.Clear();
    }

    private void Undo()
    {
        if (CanUndo)
        {
            var current = _undoStack.Pop();
            _redoStack.Push(current);
            var previous = _undoStack.Peek();
            _components = JsonSerializer.Deserialize<List<CanvasComponent>>(previous) ?? new();
            StateHasChanged();
            ShowNotification("Undo successful", "info");
        }
    }

    private void Redo()
    {
        if (CanRedo)
        {
            var next = _redoStack.Pop();
            _undoStack.Push(next);
            _components = JsonSerializer.Deserialize<List<CanvasComponent>>(next) ?? new();
            StateHasChanged();
            ShowNotification("Redo successful", "info");
        }
    }

    // ==================== ZOOM ====================
    private void ZoomIn()
    {
        if (_zoom < 2)
        {
            _zoom += 0.1;
            _zoomPercent = (int)(_zoom * 100);
        }
    }

    private void ZoomOut()
    {
        if (_zoom > 0.25)
        {
            _zoom -= 0.1;
            _zoomPercent = (int)(_zoom * 100);
        }
    }

    private void ResetZoom()
    {
        _zoom = 1.0;
        _zoomPercent = 100;
    }

    // ==================== CANVAS ====================
    private int GetCanvasRows()
    {
        if (!_components.Any()) return _canvasRows;
        var maxRow = _components.Max(c => c.GridY + c.GridHeight);
        return Math.Max(_canvasRows, maxRow + 1);
    }

    private void AddRow()
    {
        _canvasRows++;
        MarkChanged();
    }

    private void ClearCanvas()
    {
        if (_components.Any())
        {
            SaveToHistory();
            _components.Clear();
            _selectedComponentId = 0;
            _canvasRows = 4;
            ShowNotification("Canvas cleared", "warning");
        }
    }

    // ==================== COMPONENT LIBRARY ====================
    private IEnumerable<ComponentCategory> GetFilteredCategories()
    {
        if (string.IsNullOrWhiteSpace(_componentSearch))
            return _componentCategories;

        var search = _componentSearch.ToLower();
        return _componentCategories
            .Select(c => new ComponentCategory
                {
                    Name = c.Name,
                    Icon = c.Icon,
                    Components = c.Components.Where(comp =>
                        comp.Name.ToLower().Contains(search) ||
                        comp.Description.ToLower().Contains(search)).ToList()
                })
            .Where(c => c.Components.Any());
    }

