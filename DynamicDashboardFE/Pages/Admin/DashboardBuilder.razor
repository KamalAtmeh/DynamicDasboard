    private void HandleAIComponentsApplied(List<AIGeneratedComponent> generatedComponents)
    {
        foreach (var generated in generatedComponents)
        {
            var slot = selectedTemplate?.ComponentSlots?.FirstOrDefault(s => s.Id == generated.SlotId);
            var existingComponent = dashboard.Components.FirstOrDefault(c => c.Title == slot?.Label);

            if (existingComponent != null)
            {
                existingComponent.Title = generated.Title;
                existingComponent.Description = generated.Description;
                existingComponent.QueryText = generated.QueryText;
                existingComponent.QueryIntent = generated.QueryIntent;
                existingComponent.VisualizationConfig = generated.VisualizationConfig;
                existingComponent.IsAIGenerated = true;
                existingComponent.DataViewingTypeID = GetDataViewingTypeForSlot(generated.ComponentType);
            }
            else
            {
                var newComponent = new DashboardComponent
                    {
                        ComponentID = dashboard.Components.Any() ? dashboard.Components.Max(c => c.ComponentID) + 1 : 1,
                        Title = generated.Title,
                        Description = generated.Description,
                        QueryText = generated.QueryText,
                        QueryIntent = generated.QueryIntent,
                        VisualizationConfig = generated.VisualizationConfig,
                        DataViewingTypeID = GetDataViewingTypeForSlot(generated.ComponentType),
                        GridX = generated.GridX,
                        GridY = generated.GridY,
                        GridWidth = generated.GridWidth > 0 ? generated.GridWidth : 6,
                        GridHeight = generated.GridHeight > 0 ? generated.GridHeight : 3,
                        IsVisible = true,
                        IsAIGenerated = true
                    };
                dashboard.Components.Add(newComponent);
            }
        }

        hasUnsavedChanges = true;
        AddToHistory();
        StateHasChanged();
    }

