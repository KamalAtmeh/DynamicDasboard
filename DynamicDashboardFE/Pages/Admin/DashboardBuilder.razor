@code {
    private RenderFragment RenderComponent(CanvasComponent comp) => __builder =>
    {
        switch (comp.Type)
        {
            case "Chart":
                <div class="db-chart-preview">
                    @if (comp.ChartType == "pie" || comp.ChartType == "donut")
                    {
                        <ApexChart TItem="ChartData" Title="" Height="@((int)(comp.GridHeight * 80 - 60))">
                            <ApexPointSeries TItem="ChartData"
                                             Items="_pieChartData"
                                             SeriesType="@(comp.ChartType == "donut" ? SeriesType.Donut : SeriesType.Pie)"
                                             XValue="@(e => e.Label)"
                                             YValue="@(e => e.Value)"
                                             OrderBy="e => e.X" />
                        </ApexChart>
                    }
                    else
                    {
                        <ApexChart TItem="ChartData" Title="" Height="@((int)(comp.GridHeight * 80 - 60))">
                            <ApexPointSeries TItem="ChartData"
                                             Items="_lineChartData"
                                             SeriesType="@GetSeriesType(comp.ChartType)"
                                             Name="Sales"
                                             XValue="@(e => e.Label)"
                                             YValue="@(e => e.Value)" />
                        </ApexChart>
                    }
                </div>
                break;
                
            case "KPI":
                <div class="db-kpi-preview">
                    <div class="db-kpi-icon" style="background: @(comp.Color)20; color: @comp.Color;">
                        <i class="@comp.KpiIcon"></i>
                    </div>
                    <div class="db-kpi-content">
                        <span class="db-kpi-value">@comp.KpiValue</span>
                        <span class="db-kpi-label">@comp.Title</span>
                    </div>
                    <div class="db-kpi-trend @(comp.KpiTrend >= 0 ? "positive" : "negative")">
                        <i class="fas @(comp.KpiTrend >= 0 ? "fa-arrow-up" : "fa-arrow-down")"></i>
                        @Math.Abs(comp.KpiTrend)%
                    </div>
                </div>
                break;
                
            case "Table":
                <div class="db-table-preview">
                    <table>
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Status</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _sampleTableData.Take(comp.GridHeight > 2 ? 5 : 3))
                            {
                                <tr>
                                    <td>@row.Name</td>
                                    <td><span class="db-status-badge @row.StatusClass">@row.Status</span></td>
                                    <td>@row.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                break;
                
            case "Text":
                <div class="db-text-preview">
                    <p>@(string.IsNullOrEmpty(comp.TextContent) ? "Click to edit text content..." : comp.TextContent)</p>
                </div>
                break;
                
            case "Image":
                <div class="db-image-preview">
                    <i class="fas fa-image"></i>
                    <span>Click to add image</span>
                </div>
                break;
                
            default:
                <div class="db-placeholder-preview">
                    <i class="@comp.Icon"></i>
                    <span>@comp.Title</span>
                </div>
                break;
        }
    };
}
