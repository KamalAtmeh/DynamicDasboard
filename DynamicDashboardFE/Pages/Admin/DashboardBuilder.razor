    private void PrepareDashboardForSave()
    {
        // Set LayoutConfig (serialize component positions)
        if (string.IsNullOrEmpty(dashboard.LayoutConfig))
        {
            var componentsList = dashboard.Components?.Select(c => new
            {
                id = c.ComponentID,
                x = c.GridX,
                y = c.GridY,
                width = c.GridWidth,
                height = c.GridHeight
            }).ToList();

            var layoutData = new
            {
                gridColumns = 12,
                gridRowHeight = 100,
                components = componentsList ?? Enumerable.Empty<object>()
            };

            dashboard.LayoutConfig = JsonSerializer.Serialize(layoutData);
        }

        // Set FiltersConfig (empty JSON object if no filters)
        if (string.IsNullOrEmpty(dashboard.FiltersConfig))
        {
            dashboard.FiltersConfig = "{}";
        }

        // Set CreatedBy (use 1 for now, replace with actual user ID when auth is implemented)
        if (dashboard.CreatedBy == 0)
        {
            dashboard.CreatedBy = 1; // TODO: Replace with actual logged-in user ID
        }

        // Set CategoryName (for model validation even though it's JsonIgnore)
        if (string.IsNullOrEmpty(dashboard.CategoryName))
        {
            var category = availableCategories?.FirstOrDefault(c => c.CategoryID == dashboard.CategoryID);
            dashboard.CategoryName = category?.Name ?? "General";
        }

        // Ensure components have all required fields
        if (dashboard.Components != null)
        {
            foreach (var component in dashboard.Components)
            {
                // Set FilterExpression (empty string if not filtering)
                if (string.IsNullOrEmpty(component.FilterExpression))
                {
                    component.FilterExpression = "";
                }

                // Set DataViewingTypeName (for model validation even though it's JsonIgnore)
                if (string.IsNullOrEmpty(component.DataViewingTypeName))
                {
                    component.DataViewingTypeName = GetComponentTypeName(component.DataViewingTypeID);
                }

                // Ensure VisualizationConfig is set
                if (string.IsNullOrEmpty(component.VisualizationConfig))
                {
                    // Default visualization config based on type
                    var chartType = component.DataViewingTypeID == (int)DataViewingTypeEnum.Chart ? "bar" : null;
                    component.VisualizationConfig = JsonSerializer.Serialize(new
                    {
                        chartType = chartType,
                        showLegend = true,
                        showGrid = true
                    });
                }

                // Ensure timestamps are set
                if (component.CreatedAt == DateTime.MinValue || component.CreatedAt == default)
                {
                    component.CreatedAt = DateTime.UtcNow;
                }

                if (component.LastUpdated == DateTime.MinValue || component.LastUpdated == default)
                {
                    component.LastUpdated = DateTime.UtcNow;
                }
            }
        }
