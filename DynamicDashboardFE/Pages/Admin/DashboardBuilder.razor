    private void AddRow()
    {
        // Add a row (2x6 layout) at the bottom of the dashboard
        int gridY = dashboard.Components.Any() ?
            dashboard.Components.Max(c => c.GridY + c.GridHeight) : 0;
        
        // Create left component
        AddComponent(new ComponentTemplate
        {
            Id = 1,
            Title = "New Component",
            Description = "Left",
            DataViewingTypeID = (int)DataViewingTypeEnum.Table,
            Icon = "fa-table",
            Category = "Data Display"
        });
        
        // Get added component and adjust position
        var leftComponent = dashboard.Components.Last();
        leftComponent.GridX = 0;
        leftComponent.GridY = gridY;
        leftComponent.GridWidth = 6;
        
        // Create right component
        AddComponent(new ComponentTemplate
        {
            Id = 2,
            Title = "New Component",
            Description = "Right",
            DataViewingTypeID = (int)DataViewingTypeEnum.Table,
            Icon = "fa-table",
            Category = "Data Display"
        });
        
        // Get added component and adjust position
        var rightComponent = dashboard.Components.Last();
        rightComponent.GridX = 6;
        rightComponent.GridY = gridY;
        rightComponent.GridWidth = 6;
        
        AddToHistory();
    }

    private void ZoomIn()
    {
        zoomLevel = Math.Min(zoomLevel + 0.1, 2.0);
    }

    private void ZoomOut()
    {
        zoomLevel = Math.Max(zoomLevel - 0.1, 0.5);
    }

    private void ResetZoom()
    {
        zoomLevel = 1.0;
    }

    private int GetCanvasHeight()
    {
        // Calculate canvas height based on components
        if (!dashboard.Components.Any())
        {
            return 600; // Default height
        }
        
        int maxY = dashboard.Components.Max(c => c.GridY + c.GridHeight);
        return maxY * 100 + 100; // 100px per row
    }

    private List<Dictionary<string, object>> GetSampleData(DashboardComponent component)
    {
        // Generate sample data for component preview
        var result = new List<Dictionary<string, object>>();
        
        switch (component.DataViewingTypeID)
        {
            case (int)DataViewingTypeEnum.Table:
                // Sample table data
                for (int i = 1; i <= 5; i++)
                {
                    result.Add(new Dictionary<string, object>
                    {
                        { "ID", i },
                        { "Name", $"Sample {i}" },
                        { "Value", Random.Shared.Next(100, 1000) },
                        { "Date", DateTime.Now.AddDays(-i) }
                    });
                }
                break;
                
            case (int)DataViewingTypeEnum.Number:
                // Sample KPI data
                result.Add(new Dictionary<string, object>
                {
                    { "Value", Random.Shared.Next(1000, 10000) },
                    { "Change", Random.Shared.Next(-10, 20) }
                });
                break;
                
            case (int)DataViewingTypeEnum.Chart:
                // Sample chart data
                for (int i = 1; i <= 5; i++)
                {
                    result.Add(new Dictionary<string, object>
                    {
                        { "Category", $"Category {i}" },
                        { "Value", Random.Shared.Next(10, 100) }
                    });
                }
                break;
                
            case (int)DataViewingTypeEnum.Card:
                // Sample card data
                result.Add(new Dictionary<string, object>
                {
                    { "Title", "Sample Card" },
                    { "Value", Random.Shared.Next(100, 1000) },
                    { "Description", "Sample description text" }
                });
                break;
        }
        
        return result;
    }

    private void HandleQueryChange(string query)
    {
        var component = GetSelectedComponent();
        if (component != null)
        {
            component.QueryText = query;
            UpdateComponent(component);
        }
    }

    private void AddToHistory()
    {
        if (isUndoRedoAction)
        {
            isUndoRedoAction = false;
            return;
        }
        
        // Serialize current dashboard state
        string state = JsonSerializer.Serialize(dashboard);
        
        // Remove any forward history
        if (historyIndex >= 0 && historyIndex < history.Count - 1)
        {
            history.RemoveRange(historyIndex + 1, history.Count - historyIndex - 1);
        }
        
        // Add current state to history
        history.Add(state);
        historyIndex = history.Count - 1;
    }

    private void UndoAction()
    {
        if (canUndo)
        {
            isUndoRedoAction = true;
            historyIndex--;
            
            // Deserialize dashboard state
            dashboard = JsonSerializer.Deserialize<DashboardModel>(history[historyIndex]) ?? dashboard;
            
            hasUnsavedChanges = true;
        }
    }

    private void RedoAction()
    {
        if (canRedo)
        {
            isUndoRedoAction = true;
            historyIndex++;
            
            // Deserialize dashboard state
            dashboard = JsonSerializer.Deserialize<DashboardModel>(history[historyIndex]) ?? dashboard;
            
            hasUnsavedChanges = true;
        }
    }

    private async Task AutoSave()
    {
        if (hasUnsavedChanges && dashboard.DashboardID > 0)
        {
            await SaveDashboard();
        }
    }

    public void Dispose()
    {
        // Clean up timers and JS interop
        autoSaveTimer?.Dispose();
    }

