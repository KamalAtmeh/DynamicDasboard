    private int GetCanvasHeight()
    {
        if (!dashboard.Components.Any()) return 600;
        return (dashboard.Components.Max(c => c.GridY + c.GridHeight) + 2) * 80;
    }

    private void ZoomIn() => zoomLevel = Math.Min(zoomLevel + 0.1, 2.0);
    private void ZoomOut() => zoomLevel = Math.Max(zoomLevel - 0.1, 0.5);
    private void ResetZoom() => zoomLevel = 1.0;

    private void AddRow()
    {
        int gridY = dashboard.Components.Any() ? dashboard.Components.Max(c => c.GridY + c.GridHeight) : 0;
        int nextId = dashboard.Components.Any() ? dashboard.Components.Max(c => c.ComponentID) + 1 : 1;

        dashboard.Components.Add(new DashboardComponent
            {
                ComponentID = nextId,
                Title = "New Component",
                GridX = 0,
                GridY = gridY,
                GridWidth = 6,
                GridHeight = 3,
                IsVisible = true,
                DataViewingTypeID = (int)DataViewingTypeEnum.Chart
            });

        dashboard.Components.Add(new DashboardComponent
            {
                ComponentID = nextId + 1,
                Title = "New Component",
                GridX = 6,
                GridY = gridY,
                GridWidth = 6,
                GridHeight = 3,
                IsVisible = true,
                DataViewingTypeID = (int)DataViewingTypeEnum.Chart
            });

        hasUnsavedChanges = true;
        AddToHistory();
    }

    private void ClearCanvas()
    {
        if (dashboard.Components.Any())
        {
            dashboard.Components.Clear();
            selectedComponentId = 0;
            hasUnsavedChanges = true;
            AddToHistory();
            ToastService.ShowInfo("Canvas cleared");
        }
    }

    // ========== History (Undo/Redo) ==========
    private void AddToHistory()
    {
        var state = JsonSerializer.Serialize(dashboard);

        if (historyIndex < history.Count - 1)
            history.RemoveRange(historyIndex + 1, history.Count - historyIndex - 1);

        history.Add(state);
        historyIndex = history.Count - 1;

        if (history.Count > 50)
        {
            history.RemoveAt(0);
            historyIndex--;
        }
    }

    private void Undo()
    {
        if (canUndo)
        {
            historyIndex--;
            var state = history[historyIndex];
            dashboard = JsonSerializer.Deserialize<DashboardModel>(state) ?? new DashboardModel();
            StateHasChanged();
        }
    }

    private void Redo()
    {
        if (canRedo)
        {
            historyIndex++;
            var state = history[historyIndex];
            dashboard = JsonSerializer.Deserialize<DashboardModel>(state) ?? new DashboardModel();
            StateHasChanged();
        }
    }

