    // Template functionality
    private bool showTemplateModal = false;
    private string selectedTemplateId = "";
    private int selectedDatabaseIdForTemplate = 0;
    private bool isGeneratingFromTemplate = false;
    private List<DashboardTemplate> availableTemplates = new List<DashboardTemplate>();

    // UI state
    private int selectedComponentId;
    private bool isEditingTitle;
    private ElementReference titleInputRef;
    private string componentSearchTerm = "";
    private double zoomLevel = 1.0;

    private bool isPreviewMode = false;
    private bool hasUnsavedChanges = false;
    private Dictionary<int, List<Dictionary<string, object>>> componentData = new Dictionary<int, List<Dictionary<string, object>>>();
    private Dictionary<int, bool> isComponentLoading = new Dictionary<int, bool>();
    private bool isLoadingAllData = false;

    private bool showAddChartModal = false;
    private int addChartStep = 1;
    private string customChartQuery = "";
    private string customChartType = "bar";
    private string customChartSize = "medium";
    private string customChartSql = "";
    private string customChartTitle = "";
    private string customChartExplanation = "";
    private bool isGeneratingChart = false;
    private bool isAnalyzing = false;
    private bool isGeneratingSql = false;

    private bool showSettingsModal = false;


    // Analysis response to pass to generation step
    private AnalysisResponse analysisResponse = null;

    // Component categories
    private List<string> componentCategories = new List<string>
    {
        "Data Display",
        "Charts",
        "Metrics"
    };

    private List<ComponentTemplate> FilteredComponents =>
        string.IsNullOrWhiteSpace(componentSearchTerm)
            ? availableComponents
            : availableComponents.Where(c => c.Title.Contains(componentSearchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        await LoadDataSources();

        await LoadTemplates();
        LoadComponentTemplates();
        if (DashboardId > 0)
        {
            await LoadDashboard();
        }
        else
        {
            dashboard = new DashboardModel
            {
                Title = "New Dashboard",
                Description = "",
                Components = new List<DashboardComponent>(),
                CreatedAt = DateTime.UtcNow,
                LastUpdated = DateTime.UtcNow,
                SharingStatus = DashboardSharingStatus.Private,
                ValidationStatus = DashboardValidationStatus.Draft,
                CategoryID = 1
            };
        }
    }

    private async Task OnAIComponentAdded()
    {
        // Mark as unsaved
        hasUnsavedChanges = true;

        // Refresh UI
        StateHasChanged();

        // Show success toast
        ToastService.ShowSuccess("Component added successfully!");
    }

    private string GetChartType(string visualizationConfig)
    {
        if (string.IsNullOrEmpty(visualizationConfig))
            return "Bar";

        try
        {
            var config = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(visualizationConfig);
            if (config != null && config.ContainsKey("chartType"))
            {
                var chartType = config["chartType"].GetString();
                return chartType switch
                {
                    "bar" => "Bar",
                    "line" => "Line",
                    "pie" => "Pie",
                    "donut" => "Donut",
                    "area" => "Area",
                    _ => "Bar"
                };
            }
        }
        catch { }

        return "Bar";
    }

    private string GetChartIcon(string chartType)
    {
        return chartType.ToLower() switch
        {
            "bar" => "bar",
            "line" => "line",
            "pie" => "pie-chart",
            "donut" => "chart-pie",
            "area" => "area-chart",
            _ => "bar"
        };
    }

    private async Task LoadDashboard()
    {
        try
        {
            dashboard = await Http.GetFromJsonAsync<DashboardModel>($"api/dashboard/{DashboardId}");
            if (dashboard == null)
            {
                dashboard = new DashboardModel();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading dashboard: {ex.Message}");
            dashboard = new DashboardModel();
        }
    }

    private async Task LoadCategories()
    {
        try
        {
            availableCategories = await Http.GetFromJsonAsync<List<DashboardCategory>>("api/dashboard/categories") ?? new List<DashboardCategory>();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading categories: {ex.Message}");
        }
    }

    private async Task LoadDataSources()
    {
        try
        {
            var databases = await Http.GetFromJsonAsync<List<Database>>("api/databases") ?? new List<Database>();
            availableDataSources = databases
                .Where(db => db.IsActive)
                .Select(db => new DataSource { Id = db.DatabaseID, Name = db.Name })
                .ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading data sources: {ex.Message}");
        }
    }

    private void LoadComponentTemplates()
    {
        availableComponents = new List<ComponentTemplate>
        {
            new ComponentTemplate
            {
                Id = 1,
                Title = "Table",
                Description = "Display data in tabular format",
                DataViewingTypeID = (int)DataViewingTypeEnum.Table,
                Icon = "fa-table",
