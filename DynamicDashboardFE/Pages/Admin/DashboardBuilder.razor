            // Open export modal with specific component selected
            selectedComponentId = contextMenuComponent.ComponentID;
            exportModal.Show();
            
            StateHasChanged();
        }
    }

    private async Task PreviewDashboard()
    {
        // First save the dashboard if needed
        if (hasUnsavedChanges && dashboard.DashboardID > 0)
        {
            await SaveDashboard();
        }
        
        // If the dashboard has an ID, navigate to preview, otherwise show an error
        if (dashboard.DashboardID > 0)
        {
            NavigationManager.NavigateTo($"/dashboard/view/{dashboard.DashboardID}?mode={previewMode}");
        }
        else
        {
            ToastService.ShowWarning("Save the dashboard first to preview it");
        }
    }

    private void SetPreviewMode(string mode)
    {
        previewMode = mode;
    }

    private async Task SaveDashboard()
    {
        try
        {
            dashboard.LastUpdated = DateTime.UtcNow;
            
            if (dashboard.DashboardID > 0)
            {
                // Update existing dashboard
                var response = await Http.PutAsJsonAsync($"api/dashboard/{dashboard.DashboardID}", dashboard);
                
                if (response.IsSuccessStatusCode)
                {
                    hasUnsavedChanges = false;
                    ToastService.ShowSuccess("Dashboard saved successfully");
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    ToastService.ShowError($"Error saving dashboard: {error}");
                }
            }
            else
            {
                // Create new dashboard
                var response = await Http.PostAsJsonAsync("api/dashboard", dashboard);
                
                if (response.IsSuccessStatusCode)
                {
                    hasUnsavedChanges = false;
                    
                    // Get the created dashboard with ID
                    var createdDashboard = await response.Content.ReadFromJsonAsync<DashboardModel>();
                    if (createdDashboard != null)
                    {
                        dashboard = createdDashboard;
                        
                        // Update the URL to include the new dashboard ID
                        NavigationManager.NavigateTo($"/dashboard/builder/{dashboard.DashboardID}", false);
                        
                        ToastService.ShowSuccess("Dashboard created successfully");
                    }
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    ToastService.ShowError($"Error creating dashboard: {error}");
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving dashboard: {ex.Message}");
        }
    }

