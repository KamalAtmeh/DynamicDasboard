    }
    
    <!-- ==================== TOAST / NOTIFICATION ==================== -->
    @if (_showNotification)
    {
        <div class="db-notification @_notificationType">
            <i class="fas @GetNotificationIcon()"></i>
            <span>@_notificationMessage</span>
        </div>
    }
</div>

