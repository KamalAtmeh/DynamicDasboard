    /// <summary>
    /// Generates SQL and explanation from natural language query
    /// </summary>
    private async Task GenerateChartFromQuery()
    {
        if (string.IsNullOrWhiteSpace(customChartQuery))
        {
            ToastService.ShowWarning("Please enter a description");
            return;
        }

        isGeneratingChart = true;
        StateHasChanged();

        try
        {
            var request = new
            {
                Question = customChartQuery,
                DatabaseId = dashboard.DatabaseID
            };

            var response = await Http.PostAsJsonAsync("api/Dashboard/generate-sql-with-explanation", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SqlGenerationResult>();

                if (result != null && result.Success)
                {
                    customChartSql = result.GeneratedSql;
                    customChartTitle = result.Title ?? "Custom Chart";
                    customChartExplanation = result.Explanation ?? "Chart generated successfully";

                    // Move to configuration step
                    addChartStep = 2;
                    ToastService.ShowSuccess("SQL generated successfully!");
                }
                else
                {
                    ToastService.ShowError("Failed to generate SQL query");
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error: {error}");
                ToastService.ShowError("Failed to generate SQL");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception: {ex}");
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isGeneratingChart = false;
            StateHasChanged();
        }
    }







