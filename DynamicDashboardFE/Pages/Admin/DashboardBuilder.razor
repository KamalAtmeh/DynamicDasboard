    private async Task LoadTemplates()
    {
        try
        {
            availableTemplates = await Http.GetFromJsonAsync<List<DashboardTemplate>>("api/dashboard/templates") ?? new List<DashboardTemplate>();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading templates: {ex.Message}");
            availableTemplates = new List<DashboardTemplate>();
        }
    }

    private void ShowTemplateModal()
    {
        selectedTemplateId = "";
        selectedDatabaseIdForTemplate = 0;
        showTemplateModal = true;
    }

    private void CloseTemplateModal()
    {
        showTemplateModal = false;
        isGeneratingFromTemplate = false;
    }

    private async Task GenerateWithSelectedTemplate()
    {
        if (selectedDatabaseIdForTemplate == 0)
        {
            ToastService.ShowError("Please select a database");
            return;
        }

        if (string.IsNullOrEmpty(selectedTemplateId))
        {
            ToastService.ShowError("Please select a template");
            return;
        }

        isGeneratingFromTemplate = true;

        try
        {
            var request = new
            {
                DatabaseId = selectedDatabaseIdForTemplate,
                TemplateId = selectedTemplateId
            };

            Console.WriteLine($"Sending request: DB={request.DatabaseId}, Template={request.TemplateId}");

            var response = await Http.PostAsJsonAsync("api/dashboard/generate-with-template", request);

            Console.WriteLine($"Response status: {response.StatusCode}");

            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Response content: {responseContent}");

                var dashboards = await response.Content.ReadFromJsonAsync<List<DashboardModel>>();

                Console.WriteLine($"Dashboards parsed: {dashboards?.Count ?? 0}");

                if (dashboards != null && dashboards.Any())
                {
                    dashboard = dashboards[0];
                    dashboard.DatabaseID = selectedDatabaseIdForTemplate;
                    PrepareDashboardForSave();

                    Console.WriteLine($"Dashboard has {dashboard.Components?.Count ?? 0} components");

                    ToastService.ShowSuccess($"Dashboard generated with {dashboard.Components.Count} components!");
                    CloseTemplateModal();
                    StateHasChanged();
                }
                else
                {
                    ToastService.ShowError("No dashboards returned from API");
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"API Error: {error}");
                ToastService.ShowError($"Generation failed: {error}");
                CloseTemplateModal();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception: {ex}");
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isGeneratingFromTemplate = false;
        }
    }

    private void SelectComponent(int componentId)
    {
        selectedComponentId = componentId;

        if (selectedComponent != null)
        {
            // ✅ Set the dropdown value from component
            selectedComponentType = selectedComponent.DataViewingTypeID;
            componentTypeChanged = false;
        }

        StateHasChanged();
    }

    private void DuplicateComponent(DashboardComponent component)
    {
        var newComponent = new DashboardComponent
        {
            ComponentID = dashboard.Components.Max(c => c.ComponentID) + 1,
            Title = component.Title + " (Copy)",
            Description = component.Description,
            DataViewingTypeID = component.DataViewingTypeID,
            QueryText = component.QueryText,
            QueryIntent = component.QueryIntent,
            GridX = component.GridX,
            GridY = component.GridY + component.GridHeight,
            GridWidth = component.GridWidth,
            GridHeight = component.GridHeight,
            IsAIGenerated = component.IsAIGenerated,
            IsVisible = true,
            CreatedAt = DateTime.UtcNow,
            LastUpdated = DateTime.UtcNow
        };

        dashboard.Components.Add(newComponent);
        StateHasChanged();
    }

    private void RemoveComponent(int componentId)
    {
        var component = dashboard.Components?.FirstOrDefault(c => c.ComponentID == componentId);
        if (component != null)
        {
            dashboard.Components.Remove(component);
            selectedComponentId = 0;
            StateHasChanged();
        }
    }

    private async Task SaveDashboard()
    {
        try
        {
            // Validate before save
            if (dashboard.DatabaseID <= 0)
            {
                ToastService.ShowError("Please select a database before saving");
                return;
            }

            if (string.IsNullOrEmpty(dashboard.Title))
            {
                ToastService.ShowError("Please enter a dashboard title");
                return;
            }

            // Populate required fields before saving
            PrepareDashboardForSave();

            dashboard.LastUpdated = DateTime.UtcNow;

            if (dashboard.DashboardID > 0)
            {
                // Update existing dashboard
                var response = await Http.PutAsJsonAsync($"api/dashboard/{dashboard.DashboardID}", dashboard);

                if (response.IsSuccessStatusCode)
                {
                    hasUnsavedChanges = false;
                    ToastService.ShowSuccess("Dashboard saved successfully");
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Console.WriteLine($"❌ Save error response: {error}");

                    // Try to parse error message
                    try
                    {
                        var errorObj = JsonSerializer.Deserialize<Dictionary<string, object>>(error);
                        if (errorObj.ContainsKey("title"))
                        {
                            ToastService.ShowError($"Save failed: {errorObj["title"]}");
                        }
                        else
                        {
                            ToastService.ShowError($"Error: {error}");
                        }
                    }
                    catch
                    {
                        ToastService.ShowError($"Error saving: {error}");
                    }
                }
            }
            else
            {
                // Create new dashboard
                var response = await Http.PostAsJsonAsync("api/dashboard", dashboard);

                if (response.IsSuccessStatusCode)
                {
                    hasUnsavedChanges = false;

                    var createdDashboard = await response.Content.ReadFromJsonAsync<DashboardModel>();
                    if (createdDashboard != null)
                    {
                        dashboard = createdDashboard;
                        NavigationManager.NavigateTo($"/dashboard/builder/{dashboard.DashboardID}", false);
                        ToastService.ShowSuccess("Dashboard created successfully");
                    }
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Console.WriteLine($"❌ Create error response: {error}");

                    try
                    {
                        var errorObj = JsonSerializer.Deserialize<Dictionary<string, object>>(error);
                        if (errorObj.ContainsKey("title"))
                        {
                            ToastService.ShowError($"Create failed: {errorObj["title"]}");
                        }
                        else
                        {
                            ToastService.ShowError($"Error: {error}");
                        }
                    }
                    catch
                    {
                        ToastService.ShowError($"Error creating: {error}");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception in SaveDashboard: {ex.Message}");
            Console.WriteLine($"❌ Stack trace: {ex.StackTrace}");
            ToastService.ShowError($"Unexpected error: {ex.Message}");
        }
    }

