    // ✅ Auto Arrange Components in Grid
    private void AutoArrangeComponents()
    {
        if (dashboard?.Components == null || !dashboard.Components.Any())
            return;

        int currentX = 0;
        int currentY = 0;
        const int maxColumns = 12;

        // Sort by current position, then auto-arrange
        var sortedComponents = dashboard.Components
            .OrderBy(c => c.GridY)
            .ThenBy(c => c.GridX)
            .ToList();

        foreach (var component in sortedComponents)
        {
            // Check if component fits in current row
            if (currentX + component.GridWidth > maxColumns)
            {
                // Move to next row
                currentX = 0;
                currentY += 3; // Move down (default row height)
            }

            // Set new position
            component.GridX = currentX;
            component.GridY = currentY;

            // Move to next position
            currentX += component.GridWidth;
        }

        // Force canvas re-render
        canvasKey++;
        StateHasChanged();

        ToastService.ShowSuccess("Components auto-arranged successfully!");
    }

