    private void SelectTemplate(BuilderDashboardTemplate template)
    {
        selectedTemplate = template;
    }

    private void ConfirmTemplateSelection()
    {
        if (selectedTemplate != null)
        {
            ApplyTemplate(selectedTemplate);
            CloseTemplateSelector();
        }
    }

    private void ApplyTemplate(BuilderDashboardTemplate template)
    {
        dashboard.Components.Clear();

        int componentId = 1;
        foreach (var slot in template.ComponentSlots)
        {
            var component = new DashboardComponent
                {
                    ComponentID = componentId++,
                    Title = slot.Label,
                    Description = $"Placeholder for {slot.Label}",
                    DataViewingTypeID = GetDataViewingTypeForSlot(slot.Type),
                    GridX = slot.GridX,
                    GridY = slot.GridY,
                    GridWidth = slot.GridWidth,
                    GridHeight = slot.GridHeight,
                    IsVisible = true,
                    IsAIGenerated = false
                };
            dashboard.Components.Add(component);
        }

        selectedTemplate = template;
        hasUnsavedChanges = true;
        AddToHistory();

        ToastService.ShowSuccess($"Applied '{template.Name}' template");
    }

    private int GetDataViewingTypeForSlot(string slotType)
    {
        return slotType switch
        {
            "KPI" => (int)DataViewingTypeEnum.Number,
            "Chart" => (int)DataViewingTypeEnum.Chart,
            "Table" => (int)DataViewingTypeEnum.Table,
            "Card" => (int)DataViewingTypeEnum.Card,
            _ => (int)DataViewingTypeEnum.Label
        };
    }

    private void OpenAIPanel()
    {
        if (selectedDatabaseId == 0)
        {
            ToastService.ShowWarning("Please select a database first");
            return;
        }

        showTemplateSelector = false;
        showAIPanel = true;
    }

    // ========== Component Library Methods ==========
    private Dictionary<string, List<BuilderComponentTemplate>> GetFilteredComponentCategories()
    {
        var filtered = availableComponents.AsEnumerable();

        if (!string.IsNullOrEmpty(componentSearchTerm))
        {
            filtered = filtered.Where(c =>
                c.Title.Contains(componentSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                c.Description.Contains(componentSearchTerm, StringComparison.OrdinalIgnoreCase));
        }

        return filtered.GroupBy(c => c.Category).ToDictionary(g => g.Key, g => g.ToList());
    }

    private void ToggleCategory(string category)
    {
        if (expandedCategories.Contains(category))
            expandedCategories.Remove(category);
        else
            expandedCategories.Add(category);
    }

    // ========== Component Operations ==========
    private void AddComponent(BuilderComponentTemplate template)
    {
        int nextId = dashboard.Components.Any() ? dashboard.Components.Max(c => c.ComponentID) + 1 : 1;
        int gridY = dashboard.Components.Any() ? dashboard.Components.Max(c => c.GridY + c.GridHeight) : 0;

        var newComponent = new DashboardComponent
            {
                ComponentID = nextId,
                Title = template.Title,
                Description = template.Description,
                DataViewingTypeID = template.DataViewingTypeID,
                GridX = 0,
                GridY = gridY,
                GridWidth = 6,
                GridHeight = 3,
                IsVisible = true,
                IsAIGenerated = false
            };

        dashboard.Components.Add(newComponent);
        selectedComponentId = nextId;
        hasUnsavedChanges = true;
        AddToHistory();
    }

    private DashboardComponent GetSelectedComponent()
    {
        return dashboard.Components.FirstOrDefault(c => c.ComponentID == selectedComponentId);
    }

    private void SelectComponent(int componentId)
    {
        selectedComponentId = componentId;
    }

    private void DeselectComponent()
    {
        selectedComponentId = 0;
    }

    private void RemoveComponentById(int componentId)
    {
        dashboard.Components.RemoveAll(c => c.ComponentID == componentId);
        if (selectedComponentId == componentId)
            selectedComponentId = 0;
        hasUnsavedChanges = true;
        AddToHistory();
    }

    private void DuplicateComponent(DashboardComponent component)
    {
        int nextId = dashboard.Components.Max(c => c.ComponentID) + 1;
        var clone = new DashboardComponent
            {
                ComponentID = nextId,
                Title = component.Title + " (Copy)",
                Description = component.Description,
                DataViewingTypeID = component.DataViewingTypeID,
                GridX = component.GridX,
                GridY = component.GridY + component.GridHeight,
                GridWidth = component.GridWidth,
                GridHeight = component.GridHeight,
                QueryText = component.QueryText,
                QueryIntent = component.QueryIntent,
                VisualizationConfig = component.VisualizationConfig,
                IsVisible = true,
                IsAIGenerated = component.IsAIGenerated
            };

        dashboard.Components.Add(clone);
        selectedComponentId = nextId;
        hasUnsavedChanges = true;
        AddToHistory();
    }

