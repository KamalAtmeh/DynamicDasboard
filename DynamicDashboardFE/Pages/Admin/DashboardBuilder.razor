    private void RemoveComponent()
    {
        if (contextMenuComponent != null)
        {
            dashboard.Components.RemoveAll(c => c.ComponentID == contextMenuComponent.ComponentID);
            
            if (selectedComponentId == contextMenuComponent.ComponentID)
            {
                selectedComponentId = 0;
            }
            
            showComponentMenu = false;
            AddToHistory();
            hasUnsavedChanges = true;
            
            StateHasChanged();
        }
    }

    private void DuplicateComponent()
    {
        if (contextMenuComponent != null)
        {
            // Find the highest ComponentID to assign a new unique ID
            int nextId = dashboard.Components.Any() ? 
                dashboard.Components.Max(c => c.ComponentID) + 1 : 1;
            
            // Clone the component
            var clone = new DashboardComponent
            {
                ComponentID = nextId,
                DashboardID = dashboard.DashboardID,
                Title = $"{contextMenuComponent.Title} (Copy)",
                Description = contextMenuComponent.Description,
                DataViewingTypeID = contextMenuComponent.DataViewingTypeID,
                GridX = contextMenuComponent.GridX,
                GridY = contextMenuComponent.GridY + contextMenuComponent.GridHeight, // Place below original
                GridWidth = contextMenuComponent.GridWidth,
                GridHeight = contextMenuComponent.GridHeight,
                QueryText = contextMenuComponent.QueryText,
                QueryIntent = contextMenuComponent.QueryIntent,
                VisualizationConfig = contextMenuComponent.VisualizationConfig,
                FilterExpression = contextMenuComponent.FilterExpression,
                IsVisible = true,
                IsAIGenerated = contextMenuComponent.IsAIGenerated,
                CreatedAt = DateTime.UtcNow,
                LastUpdated = DateTime.UtcNow
            };
            
            // Clone parameters if any
            if (contextMenuComponent.Parameters?.Any() == true)
            {
                clone.Parameters = contextMenuComponent.Parameters.Select(p => new ComponentParameter
                {
                    Name = p.Name,
                    DisplayName = p.DisplayName,
                    DefaultValue = p.DefaultValue,
                    CurrentValue = p.CurrentValue,
                    DataType = p.DataType,
                    IsRequired = p.IsRequired,
                    Options = p.Options,
                    IsVisible = p.IsVisible,
                    ValidationRules = p.ValidationRules,
                    Description = p.Description
                }).ToList();
            }
            
            dashboard.Components.Add(clone);
            
            // Select the new component
            selectedComponentId = clone.ComponentID;
            
            showComponentMenu = false;
            AddToHistory();
            hasUnsavedChanges = true;
            
            StateHasChanged();
        }
    }

    private void BringComponentForward()
    {
        if (contextMenuComponent != null)
        {
            // Move component backward in Z-order (visual only, as grid handles actual layout)
            var index = dashboard.Components.IndexOf(contextMenuComponent);
            if (index < dashboard.Components.Count - 1)
            {
                dashboard.Components.RemoveAt(index);
                dashboard.Components.Insert(index + 1, contextMenuComponent);
                
                showComponentMenu = false;
                hasUnsavedChanges = true;
                
                StateHasChanged();
            }
        }
    }

    private void SendComponentBackward()
    {
        if (contextMenuComponent != null)
        {
            // Move component forward in Z-order (visual only, as grid handles actual layout)
            var index = dashboard.Components.IndexOf(contextMenuComponent);
            if (index > 0)
            {
                dashboard.Components.RemoveAt(index);
                dashboard.Components.Insert(index - 1, contextMenuComponent);
                
                showComponentMenu = false;
                hasUnsavedChanges = true;
                
                StateHasChanged();
            }
        }
    }

    private void ExportComponentData()
