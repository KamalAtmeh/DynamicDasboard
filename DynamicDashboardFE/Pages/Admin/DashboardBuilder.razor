                                        </label>
                                    </div>
                                </div>
                            }

                            <!-- KPI Options (Only if Number) -->
                            @if (selectedComponent.DataViewingTypeID == 3)
                            {
                                <div class="property-section">
                                    <label class="property-label">
                                        <i class="fas fa-tachometer-alt me-2"></i>
                                        KPI Options
                                    </label>

                                    <div class="form-group mb-3">
                                        <label class="form-label small">Number Format</label>
                                        <select class="form-select form-select-sm" @bind="kpiNumberFormat">
                                            <option value="number">Number (1,234.56)</option>
                                            <option value="currency">Currency ($1,234.56)</option>
                                            <option value="percentage">Percentage (12.34%)</option>
                                            <option value="compact">Compact (1.2K, 1.5M)</option>
                                        </select>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label class="form-label small">Decimal Places</label>
                                        <input type="number" class="form-control form-control-sm"
                                               @bind="kpiDecimalPlaces" min="0" max="4" />
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-6">
                                            <label class="form-label small">Prefix</label>
                                            <input type="text" class="form-control form-control-sm"
                                                   @bind="kpiPrefix" placeholder="$" maxlength="5" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small">Suffix</label>
                                            <input type="text" class="form-control form-control-sm"
                                                   @bind="kpiSuffix" placeholder="%" maxlength="5" />
                                        </div>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label class="form-label small">Icon (Font Awesome)</label>
                                        <input type="text" class="form-control form-control-sm"
                                               @bind="kpiIcon" placeholder="dollar-sign" />
                                        <small class="text-muted">Without 'fa-' prefix</small>
                                    </div>

                                    <div class="form-check mb-3">
                                        <input class="form-check-input" type="checkbox" @bind="kpiShowTrend" id="kpiTrend">
                                        <label class="form-check-label" for="kpiTrend">
                                            <i class="fas fa-chart-line me-1"></i> Show Trend Indicator
                                        </label>
                                    </div>
                                </div>
                            }

                            <!-- Component Size -->
                            <div class="property-section">
                                <label class="property-label">
                                    <i class="fas fa-expand me-2"></i>
                                    Component Size
                                </label>
                                <div class="size-selector">
                                    @foreach (var size in new[] { (3, 2), (6, 2), (6, 3), (12, 3), (12, 4) })
                                    {
                                        <div class="size-option @(selectedComponent.GridWidth == size.Item1 && selectedComponent.GridHeight == size.Item2 ? "active" : "")"
                                             @onclick="() => UpdateComponentSize(size.Item1, size.Item2)">
                                            <div class="size-preview" style="width: @(size.Item1 * 8)px; height: @(size.Item2 * 20)px;"></div>
                                            <span>@size.Item1 × @size.Item2</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="property-actions">
                                <button class="btn btn-primary w-100 mb-2" @onclick="ApplyComponentChanges">
                                    <i class="fas fa-check me-2"></i>
                                    Apply Changes
                                </button>
                                <button class="btn btn-outline-secondary w-100" @onclick="ClosePropertiesPanel">
                                    <i class="fas fa-times me-2"></i>
                                    Cancel
                                </button>
                                <small class="text-muted d-block mt-2 text-center">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Changes saved to dashboard, remember to save dashboard
                                </small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>


