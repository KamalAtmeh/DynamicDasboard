@page "/dashboard/builder"
@page "/dashboard/builder/{DashboardId:int}"
@using DynamicDashboardCommon.Models
@using DynamicDashboardCommon.Enums
@using Microsoft.AspNetCore.Components.Web
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IToastService ToastService
@inject IJSRuntime JSRuntime

<PageTitle>Dashboard Builder - @(string.IsNullOrEmpty(dashboard.Title) ? "New Dashboard" : dashboard.Title)</PageTitle>

<div class="dashboard-builder @(isDragging ? "is-dragging" : "") @(showAIPanel ? "ai-panel-open" : "")">
    <!-- Header Section -->
    <div class="builder-header shadow-sm">
        <div class="d-flex justify-content-between align-items-center px-3 py-2">
            <div class="d-flex align-items-center">
                <button class="btn btn-icon me-2" @onclick='() => NavigationManager.NavigateTo("/marketplace")'>
                    <i class="fas fa-arrow-left"></i>
                </button>
                <div class="dashboard-title-container">
                    @if (isEditingTitle)
                    {
                        <input type="text" class="form-control dashboard-title-input"
                               value="@dashboard.Title"
                               @oninput="HandleTitleInput"
                               @onblur="FinishTitleEdit"
                               @onkeydown="HandleTitleKeyDown" />
                    }
                    else
                    {
                        <h4 class="mb-0 dashboard-title" @onclick="StartTitleEdit">
                            @(string.IsNullOrEmpty(dashboard.Title) ? "Untitled Dashboard" : dashboard.Title)
                            <i class="fas fa-pen edit-icon"></i>
                        </h4>
                    }
                    @if (hasUnsavedChanges)
                    {
                        <span class="unsaved-indicator">
                            <i class="fas fa-circle"></i> Unsaved changes
                        </span>
                    }
                </div>
            </div>

            <!-- Center Tabs -->
            <div class="builder-tabs">
                <ul class="nav nav-pills">
                    <li class="nav-item">
                        <a class="nav-link @(activeTab == "design" ? "active" : "")" @onclick='() => SetActiveTab("design")'>
                            <i class="fas fa-palette me-1"></i> Design
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeTab == "data" ? "active" : "")" @onclick='() => SetActiveTab("data")'>
                            <i class="fas fa-database me-1"></i> Data
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeTab == "settings" ? "active" : "")" @onclick='() => SetActiveTab("settings")'>
                            <i class="fas fa-cog me-1"></i> Settings
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Right Actions -->
            <div class="builder-actions">
                <div class="btn-group me-2">
                    <button class="btn btn-outline-secondary btn-sm" title="Undo (Ctrl+Z)" @onclick="Undo" disabled="@(!canUndo)">
                        <i class="fas fa-undo"></i>
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" title="Redo (Ctrl+Y)" @onclick="Redo" disabled="@(!canRedo)">
                        <i class="fas fa-redo"></i>
                    </button>
                </div>

                <!-- AI Generate Button -->
                <button class="btn btn-ai-generate me-2" @onclick="OpenTemplateSelector" title="Generate with AI">
                    <i class="fas fa-magic me-1"></i>
                    <span>Generate with AI</span>
                    <span class="ai-badge">✨</span>
                </button>

                <div class="btn-group me-2">
                    <button class="btn btn-outline-secondary btn-sm" title="Preview" @onclick="PreviewDashboard">
                        <i class="fas fa-eye me-1"></i> Preview
                    </button>
                </div>

                <div class="btn-group">
                    <button class="btn btn-primary green btn-sm" @onclick="SaveDashboard">
                        <i class="fas fa-save me-1"></i> Save
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="builder-content">
        <!-- Left Sidebar: Component Library -->
        <div class="builder-sidebar builder-sidebar-left">
            <div class="sidebar-header">
                <h6 class="sidebar-title">
                    <i class="fas fa-puzzle-piece me-2"></i>Components
                </h6>
                <div class="sidebar-search">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Search components..."
                           value="@componentSearchTerm"
                           @oninput="HandleSearchInput" />
                </div>
            </div>

            <div class="component-library">
                @foreach (var category in GetFilteredComponentCategories())
                {
                    <div class="component-category">
                        <div class="category-header" @onclick="() => ToggleCategory(category.Key)">
                            <span>@category.Key</span>
                            <i class="fas @(expandedCategories.Contains(category.Key) ? "fa-chevron-down" : "fa-chevron-right")"></i>
                        </div>
                        @if (expandedCategories.Contains(category.Key))
                        {
                            <div class="category-items">
                                @foreach (var component in category.Value)
                                {
                                    <div class="component-item" @onclick="() => AddComponent(component)">
                                        <div class="component-icon">
                                            <i class="fas @component.Icon"></i>
                                        </div>
                                        <div class="component-info">
                                            <span class="component-name">@component.Title</span>
                                            <span class="component-desc">@component.Description</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Templates Section -->
            <div class="sidebar-section">
                <h6 class="sidebar-title">
                    <i class="fas fa-layer-group me-2"></i>Quick Templates
                </h6>
                <div class="template-quick-list">
                    @foreach (var template in dashboardTemplates.Take(3))
                    {
                        <div class="template-quick-item" @onclick="() => ApplyTemplate(template)">
                            <i class="@template.Icon"></i>
                            <span>@template.Name</span>
                        </div>
                    }
                    <button class="btn btn-link btn-sm" @onclick="OpenTemplateSelector">
                        View All Templates →
                    </button>
                </div>
            </div>
        </div>

        <!-- Center: Canvas Area -->
        <div class="builder-canvas-container">
            <div class="builder-canvas-toolbar">
                <div class="toolbar-left">
                    <div class="btn-group me-2">
                        <button class="btn btn-sm btn-outline-secondary" title="Zoom Out" @onclick="ZoomOut">
                            <i class="fas fa-search-minus"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary px-3">@(Math.Round(zoomLevel * 100))%</button>
                        <button class="btn btn-sm btn-outline-secondary" title="Zoom In" @onclick="ZoomIn">
                            <i class="fas fa-search-plus"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" title="Reset Zoom" @onclick="ResetZoom">
                            <i class="fas fa-compress-arrows-alt"></i>
                        </button>
                    </div>
                    <div class="form-check form-switch ms-2">
                        <input class="form-check-input" type="checkbox" checked="@showGrid" @onchange="HandleGridToggle" id="showGridSwitch">
                        <label class="form-check-label" for="showGridSwitch">Show Grid</label>
                    </div>
                </div>

                <div class="toolbar-center">
                    @if (selectedDatabaseId > 0)
                    {
                        <div class="selected-db-badge">
                            <i class="fas fa-database"></i>
                            <span>@GetSelectedDatabaseName()</span>
                        </div>
                    }
                </div>

                <div class="toolbar-right">
                    <div class="btn-group">
                        <button class="btn btn-sm btn-outline-secondary" title="Add Row" @onclick="AddRow">
                            <i class="fas fa-plus"></i> Add Row
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" title="Clear Canvas" @onclick="ClearCanvas">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="builder-canvas @(showGrid ? "show-grid" : "")" style="transform: scale(@zoomLevel);">
                @if (!dashboard.Components.Any())
                {
                    <div class="empty-canvas-message">
                        <div class="message-content">
                            <div class="empty-icon">
                                <i class="fas fa-shapes"></i>
                            </div>
                            <h4>Start Building Your Dashboard</h4>
                            <p class="text-muted">Drag components from the library or use AI to generate components</p>
                            <div class="empty-actions">
                                <button class="btn btn-outline-primary me-2" @onclick="OpenTemplateSelector">
                                    <i class="fas fa-layer-group me-1"></i>
                                    Choose Template
                                </button>
                                <button class="btn btn-ai-generate" @onclick="OpenTemplateSelector">
                                    <i class="fas fa-magic me-1"></i>
                                    Generate with AI
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="dashboard-grid" style="grid-template-columns: repeat(12, 1fr); min-height: @(GetCanvasHeight())px;">
                        @foreach (var component in dashboard.Components.Where(c => c.IsVisible).OrderBy(c => c.GridY).ThenBy(c => c.GridX))
                        {
                            <div class="dashboard-grid-item @(selectedComponentId == component.ComponentID ? "selected" : "") @(component.IsAIGenerated ? "ai-generated" : "")"
                                 style="grid-column: @(component.GridX + 1) / span @component.GridWidth; grid-row: @(component.GridY + 1) / span @component.GridHeight;"
                                 @onclick="() => SelectComponent(component.ComponentID)"
                                 @key="component.ComponentID">
                                <div class="component-container">
                                    <div class="component-header">
                                        <span class="component-title">
                                            @if (component.IsAIGenerated)
                                            {
                                                <i class="fas fa-magic ai-indicator" title="AI Generated"></i>
                                            }
                                            @component.Title
                                        </span>
                                        <div class="component-controls">
                                            <button class="btn btn-icon" title="Delete"
                                                    @onclick="() => RemoveComponentById(component.ComponentID)"
                                                    @onclick:stopPropagation="true">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="component-content">
                                        @switch (component.DataViewingTypeID)
                                        {
                                            case (int)DataViewingTypeEnum.Number:
                                                <div class="component-preview kpi-preview">
                                                    <div class="kpi-value">@GetMockKPIValue(component)</div>
                                                    <div class="kpi-label">@component.Title</div>
                                                    <div class="kpi-trend positive">
                                                        <i class="fas fa-arrow-up"></i> 12.5%
                                                    </div>
                                                </div>
                                                break;
                                            case (int)DataViewingTypeEnum.Chart:
                                                <div class="component-preview chart-preview">
                                                    <div class="mock-chart-bars">
                                                        <div class="bar" style="height: 60%"></div>
                                                        <div class="bar" style="height: 80%"></div>
                                                        <div class="bar" style="height: 45%"></div>
                                                        <div class="bar" style="height: 90%"></div>
                                                        <div class="bar" style="height: 70%"></div>
                                                        <div class="bar" style="height: 55%"></div>
                                                    </div>
                                                </div>
                                                break;
                                            case (int)DataViewingTypeEnum.Table:
                                                <div class="component-preview table-preview">
                                                    <i class="fas fa-table"></i>
                                                    <span>Data Table</span>
                                                </div>
                                                break;
                                            default:
                                                <div class="component-preview default-preview">
                                                    <i class="fas fa-chart-bar"></i>
                                                    <span>Component</span>
                                                </div>
                                                break;
                                        }
                                    </div>
                                    @if (component.IsAIGenerated && !string.IsNullOrEmpty(component.QueryText))
                                    {
                                        <div class="sql-badge" title="Click to view SQL"
                                             @onclick="() => ShowSQLPreview(component)"
                                             @onclick:stopPropagation="true">
                                            <i class="fas fa-code"></i>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Right Sidebar: Properties Panel -->
        <div class="builder-sidebar builder-sidebar-right">
            @if (selectedComponentId > 0 && GetSelectedComponent() != null)
            {
                var selectedComponent = GetSelectedComponent();
                <div class="property-panel">
                    <div class="panel-header">
                        <h6>
                            <i class="fas fa-sliders-h me-2"></i>
                            Component Properties
                        </h6>
                        <button class="btn btn-icon" @onclick="DeselectComponent">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>

                    <div class="panel-body">
                        <!-- Basic Info -->
                        <div class="property-section">
                            <div class="section-header">Basic Info</div>
                            <div class="property-group">
                                <label>Title</label>
                                <input type="text" class="form-control form-control-sm"
                                       value="@selectedComponent.Title"
                                       @onchange="e => UpdateComponentTitle(selectedComponent, e)" />
                            </div>
                            <div class="property-group">
                                <label>Description</label>
                                <textarea class="form-control form-control-sm" rows="2"
                                          @onchange="e => UpdateComponentDescription(selectedComponent, e)">@selectedComponent.Description</textarea>
                            </div>
                        </div>

                        <!-- Position & Size -->
                        <div class="property-section">
                            <div class="section-header">Position & Size</div>
                            <div class="property-row">
                                <div class="property-group half">
                                    <label>Width</label>
                                    <input type="number" class="form-control form-control-sm"
                                           value="@selectedComponent.GridWidth" min="1" max="12"
                                           @onchange="e => UpdateComponentWidth(selectedComponent, e)" />
                                </div>
                                <div class="property-group half">
                                    <label>Height</label>
                                    <input type="number" class="form-control form-control-sm"
                                           value="@selectedComponent.GridHeight" min="1" max="8"
                                           @onchange="e => UpdateComponentHeight(selectedComponent, e)" />
                                </div>
                            </div>
                        </div>

                        <!-- Data Source -->
                        @if (!string.IsNullOrEmpty(selectedComponent.QueryText))
                        {
                            <div class="property-section">
                                <div class="section-header">Data Source</div>
                                <div class="property-group">
                                    <label>SQL Query</label>
                                    <div class="sql-editor">
                                        <pre>@selectedComponent.QueryText</pre>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (selectedComponent.IsAIGenerated)
                        {
                            <div class="ai-generated-badge">
                                <i class="fas fa-magic"></i>
                                <span>AI Generated Component</span>
                            </div>
                        }
                    </div>

                    <div class="panel-footer">
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveComponentById(selectedComponent.ComponentID)">
                            <i class="fas fa-trash-alt me-1"></i> Delete
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => DuplicateComponent(selectedComponent)">
                            <i class="fas fa-clone me-1"></i> Duplicate
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- Dashboard Settings -->
                <div class="dashboard-settings-panel">
                    <div class="panel-header">
                        <h6>
                            <i class="fas fa-cog me-2"></i>
                            Dashboard Settings
                        </h6>
                    </div>

                    <div class="panel-body">
                        <div class="property-section">
                            <div class="section-header">General</div>
                            <div class="property-group">
                                <label>Title</label>
                                <input type="text" class="form-control form-control-sm"
                                       value="@dashboard.Title"
                                       @onchange="HandleDashboardTitleChange" />
                            </div>
                            <div class="property-group">
                                <label>Description</label>
                                <textarea class="form-control form-control-sm" rows="3"
                                          @onchange="HandleDashboardDescriptionChange">@dashboard.Description</textarea>
                            </div>
                        </div>

                        <div class="property-section">
                            <div class="section-header">Data Source</div>
                            <div class="property-group">
                                <label>Database</label>
                                <select class="form-select form-select-sm" value="@selectedDatabaseId" @onchange="HandleDatabaseSelection">
                                    <option value="0">-- Select Database --</option>
                                    @foreach (var db in availableDatabases)
                                    {
                                        <option value="@db.DatabaseID">@db.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="property-section">
                            <div class="section-header">Category</div>
                            <div class="property-group">
                                <label>Dashboard Category</label>
                                <select class="form-select form-select-sm" value="@dashboard.CategoryID" @onchange="HandleCategoryChange">
                                    @foreach (var cat in availableCategories)
                                    {
                                        <option value="@cat.CategoryID">@cat.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Template Selector Modal -->
    @if (showTemplateSelector)
    {
        <div class="modal-overlay" @onclick="CloseTemplateSelector"></div>
        <div class="template-selector-modal">
            <div class="modal-header">
                <h5>
                    <i class="fas fa-layer-group me-2"></i>
                    Choose a Template
                </h5>
                <button class="btn btn-icon" @onclick="CloseTemplateSelector">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <p class="modal-subtitle">Select a layout template to start building your dashboard</p>

                <div class="template-grid">
                    @foreach (var template in dashboardTemplates)
                    {
                        <div class="template-card @(selectedTemplate?.Id == template.Id ? "selected" : "")"
                             @onclick="() => SelectTemplate(template)">
                            <div class="template-preview">
                                <div class="template-layout @template.LayoutClass">
                                    @foreach (var slot in template.ComponentSlots)
                                    {
                                        <div class="slot-preview @slot.Type.ToLower()"
                                             style="grid-column: span @slot.GridWidth; grid-row: span @slot.GridHeight;">
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="template-info">
                                <span class="template-name">@template.Name</span>
                                <span class="template-slots-count">@template.ComponentSlots.Count components</span>
                            </div>
                            @if (selectedTemplate?.Id == template.Id)
                            {
                                <div class="selected-indicator">
                                    <i class="fas fa-check-circle"></i>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" @onclick="CloseTemplateSelector">Cancel</button>
                <button class="btn btn-primary green" @onclick="ConfirmTemplateSelection" disabled="@(selectedTemplate == null)">
                    <i class="fas fa-check me-1"></i>
                    Use Template
                </button>
                <button class="btn btn-ai-generate" @onclick="OpenAIPanel" disabled="@(selectedTemplate == null || selectedDatabaseId == 0)">
                    <i class="fas fa-magic me-1"></i>
                    Generate with AI
                </button>
            </div>

            @if (selectedDatabaseId == 0)
            {
                <div class="db-warning">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>Please select a database in Dashboard Settings to use AI generation</span>
                </div>
            }
        </div>
    }

    <!-- SQL Preview Modal -->
    @if (showSQLModal)
    {
        <div class="modal-overlay" @onclick="CloseSQLModal"></div>
        <div class="sql-modal">
            <div class="modal-header">
                <h5><i class="fas fa-code me-2"></i>SQL Query</h5>
                <button class="btn btn-icon" @onclick="CloseSQLModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="sql-content">
                    <pre>@sqlModalContent</pre>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" @onclick="CopySQLToClipboard">
                    <i class="fas fa-copy me-1"></i> Copy
                </button>
                <button class="btn btn-primary green" @onclick="CloseSQLModal">Close</button>
            </div>
        </div>
    }

    <!-- AI Component Assistant Panel -->
    <AIComponentAssistant IsOpen="@showAIPanel"
                          IsOpenChanged="@HandleAIPanelClose"
                          SelectedTemplate="@selectedTemplate"
                          AvailableDatabases="@availableDatabases"
                          OnChangeTemplateRequested="@(async () => HandleChangeTemplateRequest())"
                          OnComponentsApplied="HandleAIComponentsApplied" />
</div>

@code {
    [Parameter]
    public int DashboardId { get; set; }

    // ========== Core State ==========
    private DashboardModel dashboard = new DashboardModel();
    private List<DashboardCategory> availableCategories = new();
    private List<Database> availableDatabases = new();
    private List<BuilderComponentTemplate> availableComponents = new();
    private int selectedDatabaseId;

    private int selectedComponentId;
    private string activeTab = "design";
    private bool isEditingTitle;
    private string componentSearchTerm = "";
    private HashSet<string> expandedCategories = new() { "Charts", "KPIs", "Data Display" };

    // ========== Canvas State ==========
    private bool showGrid = true;
    private double zoomLevel = 1.0;
    private bool isDragging;

    // ========== History (Undo/Redo) ==========
    private List<string> history = new();
    private int historyIndex = -1;
    private bool canUndo => historyIndex > 0;
    private bool canRedo => historyIndex < history.Count - 1;

    // ========== AI Panel State ==========
    private bool showAIPanel;
    private bool showTemplateSelector;
    private BuilderDashboardTemplate selectedTemplate;
    private List<BuilderDashboardTemplate> dashboardTemplates = new();

    // ========== SQL Modal State ==========
    private bool showSQLModal;
    private string sqlModalContent = "";

    // ========== Other State ==========
    private bool hasUnsavedChanges;

    // ========== Lifecycle ==========
    protected override void OnInitialized()
    {
        InitializeTemplates();
        InitializeComponents();
        LoadDatabases();
        LoadCategories();

        dashboard = new DashboardModel
            {
                Title = "New MOI Dashboard",
                Description = "Public services performance dashboard",
                Components = new List<DashboardComponent>(),
                CreatedAt = DateTime.UtcNow,
                LastUpdated = DateTime.UtcNow,
                SharingStatus = DashboardSharingStatus.Private,
                ValidationStatus = DashboardValidationStatus.Draft,
                Tags = new List<string>()
            };
        AddToHistory();
    }

    // ========== Data Loading ==========
    private void LoadDatabases()
    {
        availableDatabases = new List<Database>
        {
            new Database { DatabaseID = 1, Name = "MOI Services Database", IsActive = true },
            new Database { DatabaseID = 2, Name = "Traffic Management System", IsActive = true },
            new Database { DatabaseID = 3, Name = "Citizen Portal Database", IsActive = true },
            new Database { DatabaseID = 4, Name = "HR & Administration", IsActive = true }
        };
    }

    private void LoadCategories()
    {
        availableCategories = new List<DashboardCategory>
        {
            new DashboardCategory { CategoryID = 1, Name = "Operations", IsActive = true },
            new DashboardCategory { CategoryID = 2, Name = "Performance", IsActive = true },
            new DashboardCategory { CategoryID = 3, Name = "Citizen Services", IsActive = true },
            new DashboardCategory { CategoryID = 4, Name = "Executive", IsActive = true }
        };
    }

    private void InitializeTemplates()
    {
        dashboardTemplates = new List<BuilderDashboardTemplate>
        {
            new BuilderDashboardTemplate
            {
                Id = 1,
                Name = "Executive Overview",
                Icon = "fas fa-tachometer-alt",
                LayoutClass = "layout-executive",
                Description = "High-level KPIs with trend chart",
                ComponentSlots = new List<BuilderComponentSlot>
                {
                    new BuilderComponentSlot { Id = "kpi1", Label = "KPI 1", Type = "KPI", GridX = 0, GridY = 0, GridWidth = 3, GridHeight = 2 },
                    new BuilderComponentSlot { Id = "kpi2", Label = "KPI 2", Type = "KPI", GridX = 3, GridY = 0, GridWidth = 3, GridHeight = 2 },
                    new BuilderComponentSlot { Id = "kpi3", Label = "KPI 3", Type = "KPI", GridX = 6, GridY = 0, GridWidth = 3, GridHeight = 2 },
                    new BuilderComponentSlot { Id = "kpi4", Label = "KPI 4", Type = "KPI", GridX = 9, GridY = 0, GridWidth = 3, GridHeight = 2 },
                    new BuilderComponentSlot { Id = "chart1", Label = "Main Chart", Type = "Chart", GridX = 0, GridY = 2, GridWidth = 8, GridHeight = 4 },
                    new BuilderComponentSlot { Id = "table1", Label = "Data Table", Type = "Table", GridX = 8, GridY = 2, GridWidth = 4, GridHeight = 4 }
                }
            },
            new BuilderDashboardTemplate
            {
                Id = 2,
                Name = "Service Metrics",
                Icon = "fas fa-chart-pie",
                LayoutClass = "layout-metrics",
                Description = "Service performance with breakdown",
                ComponentSlots = new List<BuilderComponentSlot>
                {
