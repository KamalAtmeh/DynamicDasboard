        if (dashboard.DatabaseID <= 0)
        {
            ToastService.ShowWarning("Please select a database in Dashboard Settings first");
            return;
        }

        isLoadingAllData = true;
        StateHasChanged();

        try
        {
            var tasks = dashboard.Components
                .Where(c => !string.IsNullOrEmpty(c.QueryText))
                .Select(c => LoadComponentDataAsync(c));

            await Task.WhenAll(tasks);

            ToastService.ShowSuccess("Data loaded for all components");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoadingAllData = false;
            StateHasChanged();
        }
    }

    private async Task LoadComponentDataAsync(DashboardComponent component)
    {
        if (string.IsNullOrEmpty(component.QueryText))
        {
            return;
        }

        isComponentLoading[component.ComponentID] = true;
        StateHasChanged();

        try
        {
            // var payload = new
            // {
            //     SqlQuery = component.QueryText,
            //     Parameters = new List<object>()
            // };

            var request = new SqlExecutionRequest
                {
                    OriginalQuestion = "",
                    DatabaseId = dashboard.DatabaseID,
                    Sql = component.QueryText
                };

            var response = await Http.PostAsJsonAsync($"api/query/execute", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<QueryExecutionResult>();
                if (result?.Success == true && result.Results != null)
                {
                    componentData[component.ComponentID] = result.Results;
                }
                else
                {
                    componentData[component.ComponentID] = new List<Dictionary<string, object>>();
                }
            }
            else
            {
                componentData[component.ComponentID] = new List<Dictionary<string, object>>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data for component {component.ComponentID}: {ex.Message}");
            componentData[component.ComponentID] = new List<Dictionary<string, object>>();
        }
        finally
        {
            isComponentLoading[component.ComponentID] = false;
            StateHasChanged();
        }
    }

    private async Task TogglePreviewMode()
    {
        isPreviewMode = !isPreviewMode;

        if (isPreviewMode && !componentData.Any())
        {
            await LoadAllComponentsData();
        }
    }

    private List<Dictionary<string, object>> GetComponentData(int componentId)
    {
        return componentData.ContainsKey(componentId)
            ? componentData[componentId]
            : new List<Dictionary<string, object>>();
    }

    private bool IsComponentLoading(int componentId)
    {
        return isComponentLoading.ContainsKey(componentId) && isComponentLoading[componentId];
    }

