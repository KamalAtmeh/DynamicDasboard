    private void DuplicateComponent(CanvasComponent comp)
    {
        var duplicate = new CanvasComponent
            {
                Id = _nextComponentId++,
                Type = comp.Type,
                Title = comp.Title + " (Copy)",
                Description = comp.Description,
                Icon = comp.Icon,
                Color = comp.Color,
                GridX = Math.Min(11, comp.GridX + 1),
                GridY = comp.GridY + comp.GridHeight,
                GridWidth = comp.GridWidth,
                GridHeight = comp.GridHeight,
                ChartType = comp.ChartType,
                ShowLegend = comp.ShowLegend,
                ShowDataLabels = comp.ShowDataLabels,
                EnableAnimation = comp.EnableAnimation,
                KpiValue = comp.KpiValue,
                KpiIcon = comp.KpiIcon,
                KpiTrend = comp.KpiTrend,
                TextContent = comp.TextContent,
                Query = comp.Query,
                DataSourceId = comp.DataSourceId,
                BorderRadius = comp.BorderRadius,
                Shadow = comp.Shadow
            };

        _components.Add(duplicate);
        _selectedComponentId = duplicate.Id;
        SaveToHistory();
        MarkChanged();
        UpdateCanvasRows();

        ShowNotification("Component duplicated", "success");
    }

    private void DeleteComponent(CanvasComponent comp)
    {
        _components.Remove(comp);
        if (_selectedComponentId == comp.Id)
            _selectedComponentId = 0;
        SaveToHistory();
        MarkChanged();

        ShowNotification("Component deleted", "warning");
    }

    private void MoveUp(CanvasComponent comp)
    {
        if (comp.GridY > 0)
        {
            comp.GridY--;
            SaveToHistory();
            MarkChanged();
        }
    }

    private void MoveDown(CanvasComponent comp)
    {
        comp.GridY++;
        UpdateCanvasRows();
        SaveToHistory();
        MarkChanged();
    }

