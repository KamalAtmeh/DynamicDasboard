@page "/dashboard/builder"
@page "/dashboard/builder/{DashboardId:int}"
@using System.Text.Json
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IToastService ToastService

<PageTitle>Dashboard Builder - DataVision</PageTitle>

<!-- ============================================================ -->
<!-- DASHBOARD BUILDER - MODERN INTERACTIVE UI                    -->
<!-- ============================================================ -->

<div class="db-builder @(_isDragging ? "is-dragging" : "") @(_darkMode ? "dark-mode" : "")">
    
    <!-- ==================== TOP HEADER BAR ==================== -->
    <header class="db-header">
        <div class="db-header-left">
            <button class="db-btn-icon db-btn-back" @onclick="NavigateBack" title="Back to Marketplace">
                <i class="fas fa-arrow-left"></i>
            </button>
            
            <div class="db-logo">
                <i class="fas fa-cube"></i>
            </div>
            
            <div class="db-title-section">
                @if (_isEditingTitle)
                {
                    <input type="text" 
                           class="db-title-input" 
                           @bind="_dashboardTitle" 
                           @bind:event="oninput"
                           @onblur="() => _isEditingTitle = false"
                           @onkeydown="HandleTitleKeyDown"
                           placeholder="Enter dashboard name..." />
                }
                else
                {
                    <h1 class="db-title" @onclick="() => _isEditingTitle = true">
                        @(string.IsNullOrEmpty(_dashboardTitle) ? "Untitled Dashboard" : _dashboardTitle)
                        <i class="fas fa-pen db-title-edit-icon"></i>
                    </h1>
                }
                
                <div class="db-title-meta">
                    @if (_hasUnsavedChanges)
                    {
                        <span class="db-badge db-badge-warning">
                            <i class="fas fa-circle"></i> Unsaved changes
                        </span>
                    }
                    else
                    {
                        <span class="db-badge db-badge-success">
                            <i class="fas fa-check-circle"></i> Saved
                        </span>
                    }
                    <span class="db-meta-text">Last edited: Just now</span>
                </div>
            </div>
        </div>
        
        <div class="db-header-center">
            <div class="db-view-switcher">
                <button class="db-view-btn @(_activeView == "design" ? "active" : "")" 
                        @onclick='() => SetActiveView("design")'>
                    <i class="fas fa-pencil-ruler"></i>
                    <span>Design</span>
                </button>
                <button class="db-view-btn @(_activeView == "preview" ? "active" : "")" 
                        @onclick='() => SetActiveView("preview")'>
                    <i class="fas fa-eye"></i>
                    <span>Preview</span>
                </button>
                <button class="db-view-btn @(_activeView == "code" ? "active" : "")" 
                        @onclick='() => SetActiveView("code")'>
                    <i class="fas fa-code"></i>
                    <span>Code</span>
                </button>
                <div class="db-view-slider" style="transform: translateX(@(GetViewSliderPosition())px);"></div>
            </div>
        </div>
        
        <div class="db-header-right">
            <!-- Undo/Redo -->
            <div class="db-btn-group">
                <button class="db-btn-icon" @onclick="Undo" disabled="@(!CanUndo)" title="Undo (Ctrl+Z)">
                    <i class="fas fa-undo"></i>
                </button>
                <button class="db-btn-icon" @onclick="Redo" disabled="@(!CanRedo)" title="Redo (Ctrl+Y)">
                    <i class="fas fa-redo"></i>
                </button>
            </div>
            
            <div class="db-header-divider"></div>
            
            <!-- Device Preview -->
            <div class="db-device-switcher">
                <button class="db-btn-icon @(_deviceMode == "desktop" ? "active" : "")" 
                        @onclick='() => SetDeviceMode("desktop")' title="Desktop">
                    <i class="fas fa-desktop"></i>
                </button>
                <button class="db-btn-icon @(_deviceMode == "tablet" ? "active" : "")" 
                        @onclick='() => SetDeviceMode("tablet")' title="Tablet">
                    <i class="fas fa-tablet-alt"></i>
                </button>
                <button class="db-btn-icon @(_deviceMode == "mobile" ? "active" : "")" 
                        @onclick='() => SetDeviceMode("mobile")' title="Mobile">
                    <i class="fas fa-mobile-alt"></i>
                </button>
            </div>
            
            <div class="db-header-divider"></div>
            
            <!-- Dark Mode Toggle -->
            <button class="db-btn-icon" @onclick="ToggleDarkMode" title="Toggle Dark Mode">
                <i class="fas @(_darkMode ? "fa-sun" : "fa-moon")"></i>
            </button>
            
            <div class="db-header-divider"></div>
            
            <!-- Action Buttons -->
            <button class="db-btn db-btn-secondary" @onclick="PreviewDashboard">
                <i class="fas fa-play"></i>
                <span>Preview</span>
            </button>
            
            <button class="db-btn db-btn-primary" @onclick="SaveDashboard">
                <i class="fas fa-save"></i>
                <span>Save</span>
                <span class="db-btn-badge">⌘S</span>
            </button>
            
            <div class="db-dropdown">
                <button class="db-btn-icon" @onclick="ToggleMoreMenu">
                    <i class="fas fa-ellipsis-v"></i>
                </button>
                @if (_showMoreMenu)
                {
                    <div class="db-dropdown-menu">
                        <button class="db-dropdown-item" @onclick="ExportDashboard">
                            <i class="fas fa-file-export"></i> Export as JSON
                        </button>
                        <button class="db-dropdown-item" @onclick="ExportAsImage">
                            <i class="fas fa-image"></i> Export as Image
                        </button>
                        <button class="db-dropdown-item" @onclick="ShareDashboard">
                            <i class="fas fa-share-alt"></i> Share Dashboard
                        </button>
                        <div class="db-dropdown-divider"></div>
                        <button class="db-dropdown-item" @onclick="DuplicateDashboard">
                            <i class="fas fa-copy"></i> Duplicate
                        </button>
                        <button class="db-dropdown-item db-text-danger" @onclick="DeleteDashboard">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    </div>
                }
            </div>
        </div>
    </header>
    
    <!-- ==================== MAIN BUILDER AREA ==================== -->
    <div class="db-main">
        
        <!-- ========== LEFT PANEL: COMPONENTS ========== -->
        <aside class="db-panel db-panel-left @(_leftPanelCollapsed ? "collapsed" : "")">
            <div class="db-panel-toggle" @onclick="() => _leftPanelCollapsed = !_leftPanelCollapsed">
                <i class="fas @(_leftPanelCollapsed ? "fa-chevron-right" : "fa-chevron-left")"></i>
            </div>
            
            @if (!_leftPanelCollapsed)
            {
                <div class="db-panel-header">
                    <div class="db-panel-tabs">
                        <button class="db-panel-tab @(_leftPanelTab == "components" ? "active" : "")"
                                @onclick='() => _leftPanelTab = "components"'>
                            <i class="fas fa-shapes"></i>
                            <span>Components</span>
                        </button>
                        <button class="db-panel-tab @(_leftPanelTab == "templates" ? "active" : "")"
                                @onclick='() => _leftPanelTab = "templates"'>
                            <i class="fas fa-layer-group"></i>
                            <span>Templates</span>
                        </button>
                    </div>
                </div>
                
                <div class="db-panel-body">
                    @if (_leftPanelTab == "components")
                    {
                        <!-- Search -->
                        <div class="db-search">
                            <i class="fas fa-search"></i>
                            <input type="text" 
                                   placeholder="Search components..." 
                                   @bind="_componentSearch"
                                   @bind:event="oninput" />
                            @if (!string.IsNullOrEmpty(_componentSearch))
                            {
                                <button class="db-search-clear" @onclick='() => _componentSearch = ""'>
                                    <i class="fas fa-times"></i>
                                </button>
                            }
                        </div>
                        
                        <!-- Component Categories -->
                        <div class="db-component-list">
                            @foreach (var category in GetFilteredCategories())
                            {
                                <div class="db-component-category @(_expandedCategories.Contains(category.Name) ? "expanded" : "")">
                                    <div class="db-category-header" @onclick="() => ToggleCategory(category.Name)">
                                        <div class="db-category-info">
                                            <i class="@category.Icon db-category-icon"></i>
                                            <span>@category.Name</span>
                                            <span class="db-category-count">@category.Components.Count()</span>
                                        </div>
                                        <i class="fas fa-chevron-down db-category-arrow"></i>
                                    </div>
                                    
                                    @if (_expandedCategories.Contains(category.Name))
                                    {
                                        <div class="db-category-content">
                                            @foreach (var comp in category.Components)
                                            {
                                                <div class="db-component-card"
                                                     draggable="true"
                                                     @ondragstart="() => StartDrag(comp)"
                                                     @ondragend="EndDrag"
                                                     @onclick="() => AddComponent(comp)">
                                                    <div class="db-component-icon" style="background: @comp.Color;">
                                                        <i class="@comp.Icon"></i>
                                                    </div>
                                                    <div class="db-component-details">
                                                        <span class="db-component-name">@comp.Name</span>
                                                        <span class="db-component-desc">@comp.Description</span>
                                                    </div>
                                                    <div class="db-component-add">
                                                        <i class="fas fa-plus"></i>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Templates -->
                        <div class="db-templates-grid">
                            @foreach (var template in _templates)
                            {
                                <div class="db-template-card" @onclick="() => ApplyTemplate(template)">
                                    <div class="db-template-preview" style="background: @template.PreviewGradient;">
                                        <i class="@template.Icon"></i>
                                    </div>
                                    <div class="db-template-info">
                                        <span class="db-template-name">@template.Name</span>
                                        <span class="db-template-desc">@template.ComponentCount components</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </aside>
        
        <!-- ========== CENTER: CANVAS ========== -->
        <main class="db-canvas-container">
            <!-- Canvas Toolbar -->
            <div class="db-canvas-toolbar">
                <div class="db-toolbar-left">
                    <!-- Zoom Controls -->
                    <div class="db-zoom-control">
                        <button class="db-btn-icon-sm" @onclick="ZoomOut" disabled="@(_zoom <= 0.25)">
                            <i class="fas fa-minus"></i>
                        </button>
                        <div class="db-zoom-slider">
                            <input type="range" min="25" max="200" @bind="_zoomPercent" @bind:event="oninput" />
                        </div>
                        <button class="db-btn-icon-sm" @onclick="ZoomIn" disabled="@(_zoom >= 2)">
                            <i class="fas fa-plus"></i>
                        </button>
                        <span class="db-zoom-value">@(_zoomPercent)%</span>
                        <button class="db-btn-icon-sm" @onclick="ResetZoom" title="Reset Zoom">
                            <i class="fas fa-compress-arrows-alt"></i>
                        </button>
                    </div>
                    
                    <div class="db-toolbar-divider"></div>
                    
                    <!-- Grid Toggle -->
                    <label class="db-toggle">
                        <input type="checkbox" @bind="_showGrid" />
                        <span class="db-toggle-track">
                            <span class="db-toggle-thumb"></span>
                        </span>
                        <span class="db-toggle-label">
                            <i class="fas fa-th"></i> Grid
                        </span>
                    </label>
                    
                    <!-- Snap Toggle -->
                    <label class="db-toggle">
                        <input type="checkbox" @bind="_snapToGrid" />
                        <span class="db-toggle-track">
                            <span class="db-toggle-thumb"></span>
                        </span>
                        <span class="db-toggle-label">
                            <i class="fas fa-magnet"></i> Snap
                        </span>
                    </label>
                </div>
                
                <div class="db-toolbar-center">
                    <span class="db-canvas-size">
                        <i class="fas fa-vector-square"></i>
                        12 columns × @(GetCanvasRows()) rows
                    </span>
                </div>
                
                <div class="db-toolbar-right">
                    <button class="db-btn-icon-sm" @onclick="AddRow" title="Add Row">
                        <i class="fas fa-plus"></i>
                        <span>Add Row</span>
                    </button>
                    
                    <div class="db-toolbar-divider"></div>
                    
                    <button class="db-btn-icon-sm db-text-danger" @onclick="ClearCanvas" title="Clear All">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </div>
            </div>
            
            <!-- Canvas Wrapper -->
            <div class="db-canvas-wrapper">
                <div class="db-canvas-scroll" style="transform: scale(@_zoom); transform-origin: top center;">
                    <div class="db-canvas @(_showGrid ? "show-grid" : "") @(_deviceMode)"
                         @ondragover="HandleDragOver"
                         @ondragover:preventDefault
                         @ondrop="HandleDrop"
                         @onclick="DeselectAll">
                        
                        @if (!_components.Any())
                        {
                            <!-- Empty State -->
                            <div class="db-canvas-empty">
                                <div class="db-empty-animation">
                                    <div class="db-empty-icon">
                                        <i class="fas fa-layer-group"></i>
                                    </div>
                                    <div class="db-empty-circles">
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                    </div>
                                </div>
                                <h2>Start Building Your Dashboard</h2>
                                <p>Drag and drop components from the left panel, or choose a template to get started quickly.</p>
                                <div class="db-empty-actions">
                                    <button class="db-btn db-btn-primary db-btn-lg" @onclick="ShowAIBuilder">
                                        <i class="fas fa-magic"></i>
                                        <span>Generate with AI</span>
                                    </button>
                                    <button class="db-btn db-btn-secondary db-btn-lg" @onclick='() => _leftPanelTab = "templates"'>
                                        <i class="fas fa-th-large"></i>
                                        <span>Browse Templates</span>
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Grid with Components -->
                            <div class="db-grid" style="grid-template-rows: repeat(@(_canvasRows), minmax(80px, auto));">
                                @foreach (var comp in _components.OrderBy(c => c.GridY).ThenBy(c => c.GridX))
                                {
                                    <div class="db-grid-item @(comp.Id == _selectedComponentId ? "selected" : "") @(comp.IsHovered ? "hovered" : "")"
                                         style="grid-column: @(comp.GridX + 1) / span @comp.GridWidth; 
                                                grid-row: @(comp.GridY + 1) / span @comp.GridHeight;
                                                --item-color: @comp.Color;"
                                         @onclick="() => SelectComponent(comp.Id)"
                                         @onclick:stopPropagation="true"
                                         @onmouseenter="() => comp.IsHovered = true"
                                         @onmouseleave="() => comp.IsHovered = false"
                                         @key="comp.Id">
                                        
                                        <!-- Component Header (Drag Handle) -->
                                        <div class="db-item-header"
                                             draggable="true"
                                             @ondragstart="() => StartDragExisting(comp)"
                                             @ondragend="EndDrag">
                                            <div class="db-item-drag">
                                                <i class="fas fa-grip-vertical"></i>
                                            </div>
                                            <span class="db-item-title">@comp.Title</span>
                                            <div class="db-item-actions">
                                                <button class="db-btn-micro" @onclick="() => DuplicateComponent(comp)" @onclick:stopPropagation="true" title="Duplicate">
                                                    <i class="fas fa-copy"></i>
                                                </button>
                                                <button class="db-btn-micro" @onclick="() => DeleteComponent(comp)" @onclick:stopPropagation="true" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                        
                                        <!-- Component Content -->
                                        <div class="db-item-content">
                                            @RenderComponent(comp)
                                        </div>
                                        
                                        <!-- Resize Handles -->
                                        @if (comp.Id == _selectedComponentId)
                                        {
                                            <div class="db-resize-handle db-resize-e" @onmousedown='(e) => StartResize(e, comp, "e")' @onmousedown:stopPropagation="true"></div>
                                            <div class="db-resize-handle db-resize-s" @onmousedown='(e) => StartResize(e, comp, "s")' @onmousedown:stopPropagation="true"></div>
                                            <div class="db-resize-handle db-resize-se" @onmousedown='(e) => StartResize(e, comp, "se")' @onmousedown:stopPropagation="true"></div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        
                        <!-- Drop Zone Indicator -->
                        @if (_isDragging)
                        {
                            <div class="db-drop-indicator" style="grid-column: @(_dropX + 1) / span @_draggedWidth; grid-row: @(_dropY + 1) / span @_draggedHeight;">
                                <div class="db-drop-indicator-inner">
                                    <i class="fas fa-plus"></i>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </main>
        
        <!-- ========== RIGHT PANEL: PROPERTIES ========== -->
        <aside class="db-panel db-panel-right @(_rightPanelCollapsed ? "collapsed" : "")">
            <div class="db-panel-toggle" @onclick="() => _rightPanelCollapsed = !_rightPanelCollapsed">
                <i class="fas @(_rightPanelCollapsed ? "fa-chevron-left" : "fa-chevron-right")"></i>
            </div>
            
            @if (!_rightPanelCollapsed)
            {
                @if (_selectedComponentId > 0)
                {
                    var selected = _components.FirstOrDefault(c => c.Id == _selectedComponentId);
                    if (selected != null)
                    {
                        <!-- Component Properties -->
                        <div class="db-panel-header">
                            <div class="db-selected-component">
                                <div class="db-selected-icon" style="background: @selected.Color;">
                                    <i class="@selected.Icon"></i>
                                </div>
                                <div class="db-selected-info">
                                    <span class="db-selected-type">@selected.Type</span>
                                    <span class="db-selected-name">@selected.Title</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="db-panel-body">
                            <!-- Quick Actions -->
                            <div class="db-quick-actions">
                                <button class="db-quick-btn" @onclick="() => DuplicateComponent(selected)" title="Duplicate">
                                    <i class="fas fa-copy"></i>
                                </button>
                                <button class="db-quick-btn" @onclick="() => MoveUp(selected)" title="Move Up" disabled="@(selected.GridY == 0)">
                                    <i class="fas fa-arrow-up"></i>
                                </button>
                                <button class="db-quick-btn" @onclick="() => MoveDown(selected)" title="Move Down">
                                    <i class="fas fa-arrow-down"></i>
                                </button>
                                <button class="db-quick-btn db-text-danger" @onclick="() => DeleteComponent(selected)" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                            
                            <!-- Property Sections -->
                            <div class="db-property-sections">
                                <!-- General -->
                                <div class="db-property-section">
                                    <div class="db-section-header" @onclick='() => ToggleSection("general")'>
                                        <span><i class="fas fa-cog"></i> General</span>
                                        <i class="fas @(_expandedSections.Contains("general") ? "fa-chevron-up" : "fa-chevron-down")"></i>
                                    </div>
                                    @if (_expandedSections.Contains("general"))
                                    {
                                        <div class="db-section-content">
                                            <div class="db-field">
                                                <label>Title</label>
                                                <input type="text" @bind="selected.Title" @bind:after="MarkChanged" />
                                            </div>
                                            <div class="db-field">
                                                <label>Description</label>
                                                <textarea rows="2" @bind="selected.Description" @oninput="MarkChanged"></textarea>
                                            </div>
                                        </div>
                                    }
                                </div>
                                
                                <!-- Layout -->
                                <div class="db-property-section">
                                    <div class="db-section-header" @onclick='() => ToggleSection("layout")'>
                                        <span><i class="fas fa-expand-arrows-alt"></i> Layout</span>
                                        <i class="fas @(_expandedSections.Contains("layout") ? "fa-chevron-up" : "fa-chevron-down")"></i>
                                    </div>
                                    @if (_expandedSections.Contains("layout"))
                                    {
                                        <div class="db-section-content">
                                            <div class="db-field-row">
                                                <div class="db-field db-field-half">
                                                    <label>Width</label>
                                                    <div class="db-number-input">
                                                        <button @onclick="() => { selected.GridWidth = Math.Max(1, selected.GridWidth - 1); MarkChanged(); }">-</button>
                                                        <input type="number" min="1" max="12" @bind="selected.GridWidth" @oninput="MarkChanged" />
                                                        <button @onclick="() => { selected.GridWidth = Math.Min(12, selected.GridWidth + 1); MarkChanged(); }">+</button>
                                                    </div>
                                                </div>
                                                <div class="db-field db-field-half">
                                                    <label>Height</label>
                                                    <div class="db-number-input">
                                                        <button @onclick="() => { selected.GridHeight = Math.Max(1, selected.GridHeight - 1); MarkChanged(); }">-</button>
                                                        <input type="number" min="1" max="8" @bind="selected.GridHeight" @oninput="MarkChanged" />
                                                        <button @onclick="() => { selected.GridHeight = Math.Min(8, selected.GridHeight + 1); MarkChanged(); }">+</button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="db-field-row">
                                                <div class="db-field db-field-half">
                                                    <label>Column (X)</label>
                                                    <input type="number" min="0" max="11" @bind="selected.GridX" @oninput="MarkChanged" />
                                                </div>
                                                <div class="db-field db-field-half">
                                                    <label>Row (Y)</label>
                                                    <input type="number" min="0" @bind="selected.GridY" @oninput="MarkChanged" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                
                                <!-- Appearance -->
                                <div class="db-property-section">
                                    <div class="db-section-header" @onclick='() => ToggleSection("appearance")'>
                                        <span><i class="fas fa-palette"></i> Appearance</span>
                                        <i class="fas @(_expandedSections.Contains("appearance") ? "fa-chevron-up" : "fa-chevron-down")"></i>
                                    </div>
                                    @if (_expandedSections.Contains("appearance"))
                                    {
                                        <div class="db-section-content">
                                            <div class="db-field">
                                                <label>Color Theme</label>
                                                <div class="db-color-picker">
                                                    @foreach (var color in _colorOptions)
                                                    {
                                                        <button class="db-color-option @(selected.Color == color ? "selected" : "")"
                                                                style="background: @color;"
                                                                @onclick="() => { selected.Color = color; MarkChanged(); }">
                                                            @if (selected.Color == color)
                                                            {
                                                                <i class="fas fa-check"></i>
                                                            }
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                            <div class="db-field">
                                                <label>Border Radius</label>
                                                <input type="range" min="0" max="24" @bind="selected.BorderRadius" @oninput="MarkChanged" />
                                                <span class="db-range-value">@(selected.BorderRadius)px</span>
                                            </div>
                                            <div class="db-field">
                                                <label>Shadow</label>
                                                <textarea rows="2" @bind="selected.Description" @bind:after="MarkChanged"></textarea>
                                                    <option value="none">None</option>
                                                    <option value="sm">Small</option>
                                                    <option value="md">Medium</option>
                                                    <option value="lg">Large</option>
                                              
                                            </div>
                                        </div>
                                    }
                                </div>
                                
                                <!-- Data (for Charts/Tables) -->
                                @if (selected.Type == "Chart" || selected.Type == "Table")
                                {
                                    <div class="db-property-section">
                                        <div class="db-section-header" @onclick='() => ToggleSection("data")'>
                                            <span><i class="fas fa-database"></i> Data</span>
                                            <i class="fas @(_expandedSections.Contains("data") ? "fa-chevron-up" : "fa-chevron-down")"></i>
                                        </div>
                                        @if (_expandedSections.Contains("data"))
                                        {
                                            <div class="db-section-content">
                                                <div class="db-field">
                                                    <label>Data Source</label>
                                                    <select @bind="selected.Shadow" @bind:after="MarkChanged">
                                                        <option value="0">-- Select --</option>
                                                        <option value="1">Sales Database</option>
                                                        <option value="2">Analytics Database</option>
                                                        <option value="3">Test Automation DB</option>
                                                    </select>
