</div>

<!-- Template Selection Modal -->
<div class="modal fade @(showTemplateModal ? "show" : "")" tabindex="-1" style="display: @(showTemplateModal ? "block" : "none")">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" style="border-radius: 16px; overflow: hidden; width: 850px !important">
            <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; padding: 2rem;">
                <div class="d-flex align-items-center text-white">
                    <i class="fas fa-layer-group me-3" style="font-size: 2rem;"></i>
                    <div>
                        <h3 class="mb-0 fw-bold">Choose a Template</h3>
                        <p class="mb-0 opacity-75" style="font-size: 0.95rem;">Select a layout template to start building your dashboard</p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseTemplateModal"></button>
            </div>
            <div class="modal-body" style="padding: 2rem;">

                <!-- Database Selection -->
                <div class="mb-4 p-3" style="background: #f8f9fa; border-radius: 12px;">
                    <label class="form-label fw-bold d-flex align-items-center mb-2" style="font-size: 1.1rem;">
                        <i class="fas fa-database me-2 text-primary"></i>
                        Select Database
                    </label>
                    <select class="form-select form-select-lg" @bind="selectedDatabaseIdForTemplate" style="border-radius: 8px; border: 2px solid #dee2e6;">
                        <option value="0">-- Select a Database --</option>
                        @foreach (var ds in availableDataSources)
                        {
                            <option value="@ds.Id">@ds.Name</option>
                        }
                    </select>
                    @if (selectedDatabaseIdForTemplate == 0)
                    {
@*                         <div class="alert alert-warning d-flex align-items-center mt-3 mb-0" style="border-radius: 8px; border-left: 4px solid #ffc107;">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <span>Please select a database to enable AI generation</span>
                        </div> *@
                    }
                </div>

                <!-- Template Cards -->
                <div class="row g-4">
                    @foreach (var template in availableTemplates)
                    {
                        <div class="col-lg-4">
                            <div class="template-card-enhanced @(selectedTemplateId == template.Id ? "selected" : "")"
                            @onclick="() => selectedTemplateId = template.Id">

                                <!-- Template Preview -->
                                <div class="template-preview-enhanced">
                                    @if (template.Id == "executive-template")
                                    {
                                        <!-- Executive Template Visual -->
                                        <div class="preview-row" style="height: 25%;">
                                            <div class="preview-box" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"></div>
                                            <div class="preview-box" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);"></div>
                                            <div class="preview-box" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);"></div>
                                        </div>
                                        <div class="preview-box mt-2" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); height: 35%;"></div>
                                        <div class="preview-row mt-2" style="height: 32%;">
                                            <div class="preview-box" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);"></div>
                                            <div class="preview-box" style="background: linear-gradient(135deg, #30cfd0 0%, #330867 100%);"></div>
                                        </div>
                                    }
                                    else if (template.Id == "operational-template")
                                    {
                                        <!-- Operational Template Visual -->
                                        <div class="preview-row" style="height: 20%;">
                                            <div class="preview-box" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"></div>
                                            <div class="preview-box" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);"></div>
                                            <div class="preview-box" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);"></div>
                                            <div class="preview-box" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);"></div>
                                        </div>
                                        <div class="preview-row mt-2" style="height: 35%;">
                                            <div class="preview-box" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); flex: 2;"></div>
                                            <div class="preview-box" style="background: linear-gradient(135deg, #30cfd0 0%, #330867 100%); flex: 1;"></div>
                                        </div>
                                        <div class="preview-box mt-2" style="background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%); height: 37%;"></div>
                                    }
                                    else if (template.Id == "performance-template")
                                    {
                                        <!-- Performance Template Visual -->
                                        <div class="preview-row" style="height: 22%;">
                                            <div class="preview-box" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"></div>
                                            <div class="preview-box" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);"></div>
                                        </div>
                                        <div class="preview-row mt-2" style="height: 45%;">
                                            <div class="preview-box" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); flex: 3;"></div>
                                            <div class="preview-box" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); flex: 2;"></div>
                                        </div>
                                        <div class="preview-row mt-2" style="height: 25%;">
                                            <div class="preview-box" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);"></div>
                                            <div class="preview-box" style="background: linear-gradient(135deg, #30cfd0 0%, #330867 100%);"></div>
                                        </div>
                                    }
                                </div>

                                <!-- Template Info -->
                                <div class="template-info">
                                    <h5 class="template-title">@template.Name</h5>
                                    <p class="template-description">@template.Description</p>
                                    <div class="template-meta">
                                        <span class="badge bg-light text-dark">
                                            <i class="fas fa-th me-1"></i>@template.Components.Count components
                                        </span>
                                        <span class="badge bg-light text-dark">
                                            <i class="fas fa-layer-group me-1"></i>@template.Category
                                        </span>
                                    </div>
                                    @if (selectedTemplateId == template.Id)
                                    {
                                        <div class="selected-badge">
                                            <i class="fas fa-check-circle me-2"></i>Selected
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (availableTemplates.Count == 0)
                {
                    <div class="alert alert-info d-flex align-items-center" style="border-radius: 12px;">
                        <i class="fas fa-info-circle me-2" style="font-size: 1.5rem;"></i>
                        <span>Loading templates...</span>
                    </div>
                }
            </div>
            <div class="modal-footer" style="padding: 1.5rem 2rem; border-top: 2px solid #f0f0f0;">
                <button type="button" class="btn btn-secondary btn-lg" @onclick="CloseTemplateModal" style="border-radius: 8px; padding: 0.75rem 2rem;">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-success btn-lg"
                @onclick="GenerateWithSelectedTemplate"
                disabled="@(selectedDatabaseIdForTemplate == 0 || string.IsNullOrEmpty(selectedTemplateId) || isGeneratingFromTemplate)"
                style="border-radius: 8px; padding: 0.75rem 2rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none;">
                    @if (isGeneratingFromTemplate)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <text>Generating...</text>
                    }
                    else
                    {
                        <i class="fas fa-magic me-2"></i>
                        <text>Generate with AI</text>
                    }
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade @(showTemplateModal ? "show" : "")" style="display: @(showTemplateModal ? "block" : "none")"></div>

<div class="modal fade @(showAddChartModal ? "show" : "")" tabindex="-1" style="display: @(showAddChartModal ? "block" : "none")">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; padding: 2rem;">
                <div class="d-flex align-items-center text-white">
                    <i class="fas fa-magic me-3" style="font-size: 2rem;"></i>
                    <div>
                        <h3 class="mb-0 fw-bold">Add Custom Chart</h3>
                        <p class="mb-0 opacity-75" style="font-size: 0.95rem;">Describe what you want to visualize in natural language</p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseAddChartModal"></button>
            </div>
            <div class="modal-body" style="padding: 2rem;">

                <!-- Step Indicator -->
                <div class="steps-indicator mb-4">
                    <div class="step @(addChartStep >= 1 ? "active" : "") @(addChartStep > 1 ? "completed" : "")">
                        <div class="step-number">1</div>
                        <div class="step-label">Describe</div>
                    </div>
                    <div class="step-line @(addChartStep > 1 ? "active" : "")"></div>
                    <div class="step @(addChartStep >= 2 ? "active" : "") @(addChartStep > 2 ? "completed" : "")">
                        <div class="step-number">2</div>
                        <div class="step-label">Configure</div>
                    </div>
                    <div class="step-line @(addChartStep > 2 ? "active" : "")"></div>
                    <div class="step @(addChartStep >= 3 ? "active" : "")">
                        <div class="step-number">3</div>
                        <div class="step-label">Preview</div>
                    </div>
                </div>

                <!-- Step 1: Natural Language Query -->
                @if (addChartStep == 1)
                {
                    <div class="step-content">
                        <div class="mb-4">
                            <label class="form-label fw-bold d-flex align-items-center mb-2" style="font-size: 1.1rem;">
                                <i class="fas fa-comment-dots me-2 text-primary"></i>
                                What would you like to visualize?
                            </label>
                            <textarea class="form-control"
                                      rows="5"
                                      @bind="customChartQuery"
                                      placeholder="Example: Show me total violations by month for the last 6 months&#10;Example: Compare revenue across different regions&#10;Example: Display top 10 drivers with most violations"
                                      style="border-radius: 8px; border: 2px solid #dee2e6; font-size: 1rem;"></textarea>
                            <small class="form-text text-muted mt-2">
                                <i class="fas fa-lightbulb me-1"></i>
                                Tip: Be specific about timeframes, filters, and what data you want to see
                            </small>
                        </div>

                        <!-- Examples -->
                        <div class="examples-section">
                            <p class="mb-2 fw-bold text-muted small">Quick Examples:</p>
                            <div class="d-flex gap-2 flex-wrap">
                                <button class="btn btn-sm btn-outline-secondary" @onclick='() => customChartQuery = "Show violations grouped by severity level"'>
                                    Violations by Severity
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick='() => customChartQuery = "Display monthly trend of traffic incidents"'>
                                    Monthly Trend
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick='() => customChartQuery = "Top 5 violation types by count"'>
                                    Top Violations
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <!-- Step 2: Chart Configuration -->
                @if (addChartStep == 2)
                {
                    <div class="step-content">
                        <div class="alert alert-info d-flex align-items-start mb-4" style="border-radius: 8px;">
                            <i class="fas fa-check-circle me-2 mt-1" style="font-size: 1.5rem;"></i>
                            <div>
                                <strong>Query Analyzed Successfully!</strong>
                                <p class="mb-0 mt-1">@customChartExplanation</p>
                            </div>
                        </div>

                        <!-- Chart Title Input -->
                        <div class="mb-4">
                            <label class="form-label fw-bold d-flex align-items-center mb-2">
                                <i class="fas fa-heading me-2 text-primary"></i>
                                Chart Title
                            </label>
                            <input type="text"
                                   class="form-control form-control-lg"
                                   @bind="customChartTitle"
                                   placeholder="Enter a descriptive title for your chart"
                                   style="border-radius: 8px; border: 2px solid #dee2e6;" />
                            <small class="form-text text-muted mt-1">
                                This will appear as the heading above your chart
                            </small>
                        </div>

                        <!-- Chart Type Selection -->
                        <div class="mb-4">
                            <label class="form-label fw-bold d-flex align-items-center mb-3">
                                <i class="fas fa-chart-bar me-2 text-primary"></i>
                                Select Chart Type
                            </label>
                            <div class="chart-type-grid">
                                <div class="chart-type-option @(customChartType == "bar" ? "selected" : "")"
                                     @onclick='() => customChartType = "bar"'>
                                    <i class="fas fa-chart-bar fa-2x mb-2"></i>
                                    <span>Bar Chart</span>
                                </div>
                                <div class="chart-type-option @(customChartType == "column" ? "selected" : "")"
                                     @onclick='() => customChartType = "column"'>
                                    <i class="fas fa-chart-column fa-2x mb-2"></i>
                                    <span>Column Chart</span>
                                </div>
                                <div class="chart-type-option @(customChartType == "line" ? "selected" : "")"
                                     @onclick='() => customChartType = "line"'>
                                    <i class="fas fa-chart-line fa-2x mb-2"></i>
                                    <span>Line Chart</span>
                                </div>
                                <div class="chart-type-option @(customChartType == "pie" ? "selected" : "")"
                                     @onclick='() => customChartType = "pie"'>
                                    <i class="fas fa-chart-pie fa-2x mb-2"></i>
                                    <span>Pie Chart</span>
                                </div>
                                <div class="chart-type-option @(customChartType == "donut" ? "selected" : "")"
                                     @onclick='() => customChartType = "donut"'>
                                    <i class="fas fa-ring fa-2x mb-2"></i>
                                    <span>Donut Chart</span>
                                </div>
                                <div class="chart-type-option @(customChartType == "area" ? "selected" : "")"
                                     @onclick='() => customChartType = "area"'>
                                    <i class="fas fa-chart-area fa-2x mb-2"></i>
                                    <span>Area Chart</span>
                                </div>
                            </div>
                        </div>

                        <!-- Size Selection -->
                        <div class="mb-4">
                            <label class="form-label fw-bold d-flex align-items-center mb-3">
                                <i class="fas fa-expand me-2 text-primary"></i>
                                Chart Size
                            </label>
                            <div class="size-selection-grid">
                                <div class="size-option @(customChartSize == "small" ? "selected" : "")"
                                     @onclick='() => customChartSize = "small"'>
                                    <div class="size-preview small-preview"></div>
                                    <span>Small (3x2)</span>
                                </div>
                                <div class="size-option @(customChartSize == "medium" ? "selected" : "")"
                                     @onclick='() => customChartSize = "medium"'>
                                    <div class="size-preview medium-preview"></div>
                                    <span>Medium (6x3)</span>
                                </div>
                                <div class="size-option @(customChartSize == "large" ? "selected" : "")"
                                     @onclick='() => customChartSize = "large"'>
                                    <div class="size-preview large-preview"></div>
                                    <span>Large (12x4)</span>
                                </div>
                            </div>
                        </div>

                        <!-- Generated SQL Preview -->
                        @if (!string.IsNullOrEmpty(customChartSql))
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold d-flex align-items-center mb-2">
                                    <i class="fas fa-code me-2 text-primary"></i>
                                    Generated SQL Query
                                </label>
                                <div class="sql-preview">
                                    <pre><code>@customChartSql</code></pre>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Step 3: Preview -->
                @if (addChartStep == 3)
                {
                    <div class="step-content">
                        <div class="text-center py-5">
                            <i class="fas fa-check-circle text-success mb-3" style="font-size: 4rem;"></i>
                            <h4 class="mb-3">Chart Added Successfully!</h4>
                            <p class="text-muted mb-4">Your custom chart has been added to the dashboard</p>
                            <div class="chart-summary p-4" style="background: #f8f9fa; border-radius: 12px; text-align: left;">
                                <div class="d-flex align-items-start mb-3">
                                    <i class="fas fa-chart-@(GetChartIcon(customChartType)) me-3 mt-1 text-primary" style="font-size: 1.5rem;"></i>
                                    <div>
                                        <strong>@customChartTitle</strong>
                                        <p class="mb-0 text-muted small">@customChartType.ToUpper() Chart · @customChartSize.ToUpper() Size</p>
                                    </div>
                                </div>
                                <div class="small text-muted">
                                    <i class="fas fa-map-marker-alt me-2"></i>
                                    Automatically placed in the best available position
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
            <div class="modal-footer" style="padding: 1.5rem 2rem; border-top: 2px solid #f0f0f0;">
                <button type="button" class="btn btn-secondary btn-lg" @onclick="CloseAddChartModal" style="border-radius: 8px; padding: 0.75rem 2rem;">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>

                @if (addChartStep == 1)
                {
                    <button type="button" class="btn btn-primary btn-lg"
                            @onclick="AnalyzeChartQuery"
                            disabled="@(string.IsNullOrWhiteSpace(customChartQuery) || isAnalyzing)"
                            style="border-radius: 8px; padding: 0.75rem 2rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none;">
                        @if (isAnalyzing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <text>Analyzing...</text>
                        }
                        else
                        {
                            <i class="fas fa-arrow-right me-2"></i>
                            <text>Next: Configure</text>
                        }
                    </button>
                }
                else if (addChartStep == 2)
                {
                    <button type="button" class="btn btn-outline-secondary btn-lg"
                            @onclick='() => addChartStep = 1'
                            style="border-radius: 8px; padding: 0.75rem 2rem;">
                        <i class="fas fa-arrow-left me-2"></i>Back
                    </button>
                    <button type="button" class="btn btn-success btn-lg"
                            @onclick="GenerateSqlAndAddChart"
                            disabled="@(string.IsNullOrWhiteSpace(customChartTitle) || isGeneratingSql)"
                            style="border-radius: 8px; padding: 0.75rem 2rem;">
                        @if (isGeneratingSql)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <text>Generating...</text>
                        }
                        else
                        {
                            <i class="fas fa-plus me-2"></i>
                            <text>Add Chart</text>
                        }
                    </button>
                }
                else if (addChartStep == 3)
                {
                    <button type="button" class="btn btn-success btn-lg"
                            @onclick="CloseAddChartModal"
                            style="border-radius: 8px; padding: 0.75rem 2rem;">
                        <i class="fas fa-check me-2"></i>Done
                    </button>
                }
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade @(showAddChartModal ? "show" : "")" style="display: @(showAddChartModal ? "block" : "none")"></div>



