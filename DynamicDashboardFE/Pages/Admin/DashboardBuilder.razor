    private async Task ApplyComponentChanges()
    {
        if (selectedComponent == null)
        {
            ToastService.ShowWarning("No component selected");
            return;
        }

        try
        {
            // Mark as having unsaved changes
            hasUnsavedChanges = true;

            // Update component metadata
            selectedComponent.LastUpdated = DateTime.UtcNow;

            // 🔥 ALWAYS force re-render to update visual indicators (icons, labels, etc.)
            StateHasChanged();
            canvasKey++; // Force canvas re-render
            StateHasChanged();

            // 🔥 If component has data loaded (regardless of mode), reload to reflect changes
            if (componentData.ContainsKey(selectedComponent.ComponentID) &&
                componentData[selectedComponent.ComponentID].Any())
            {
                // Only reload visual component types
                if (selectedComponent.DataViewingTypeID == (int)DataViewingTypeEnum.Chart ||
                    selectedComponent.DataViewingTypeID == (int)DataViewingTypeEnum.Table ||
                    selectedComponent.DataViewingTypeID == (int)DataViewingTypeEnum.Number)
                {
                    await LoadComponentDataAsync(selectedComponent);
                }
            }

            ToastService.ShowSuccess($"{selectedComponent.Title} properties updated!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error updating component: {ex.Message}");
            Console.WriteLine($"Error in ApplyComponentChanges: {ex.Message}");
        }
    }

