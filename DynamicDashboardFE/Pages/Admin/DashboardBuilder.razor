    // ==================== DRAG & DROP ====================
    private void StartDrag(ComponentTemplate template)
    {
        _isDragging = true;
        _draggedTemplate = template;
        _draggedComponent = null;
        _draggedWidth = template.DefaultWidth;
        _draggedHeight = template.DefaultHeight;
    }

    private void StartDragExisting(CanvasComponent component)
    {
        _isDragging = true;
        _draggedTemplate = null;
        _draggedComponent = component;
        _draggedWidth = component.GridWidth;
        _draggedHeight = component.GridHeight;
    }

    private void EndDrag()
    {
        _isDragging = false;
        _draggedTemplate = null;
        _draggedComponent = null;
    }

    private void HandleDragOver(DragEventArgs e)
    {
        // Calculate drop position based on grid
        // For demo, we'll use simple calculation
        _dropX = Math.Min(11, Math.Max(0, (int)(e.OffsetX / 80)));
        _dropY = Math.Min(_canvasRows - 1, Math.Max(0, (int)(e.OffsetY / 80)));

        if (_snapToGrid)
        {
            _dropX = (_dropX / 3) * 3; // Snap to 3-column grid
        }
    }

    private void HandleDrop(DragEventArgs e)
    {
        if (_draggedTemplate != null)
        {
            // Add new component
            var newComponent = new CanvasComponent
                {
                    Id = _nextComponentId++,
                    Type = _draggedTemplate.Type,
                    Title = _draggedTemplate.Name,
                    Icon = _draggedTemplate.Icon,
                    Color = _draggedTemplate.Color,
                    GridX = _dropX,
                    GridY = _dropY,
                    GridWidth = _draggedTemplate.DefaultWidth,
                    GridHeight = _draggedTemplate.DefaultHeight,
                    ChartType = _draggedTemplate.ChartType ?? "bar",
                    EnableAnimation = true,
                    ShowLegend = true,
                    KpiValue = GetRandomKpiValue(),
                    KpiIcon = _draggedTemplate.Icon,
                    KpiTrend = (decimal)(Random.Shared.NextDouble() * 20 - 10)
                };

            _components.Add(newComponent);
            _selectedComponentId = newComponent.Id;
            SaveToHistory();
            MarkChanged();

            ShowNotification($"{_draggedTemplate.Name} added!", "success");
        }
        else if (_draggedComponent != null)
        {
            // Move existing component
            _draggedComponent.GridX = _dropX;
            _draggedComponent.GridY = _dropY;
            SaveToHistory();
            MarkChanged();
        }

        EndDrag();
        UpdateCanvasRows();
    }

    private void AddComponent(ComponentTemplate template)
    {
        // Find next available position
        int gridY = 0;
        if (_components.Any())
        {
            gridY = _components.Max(c => c.GridY + c.GridHeight);
        }

        var newComponent = new CanvasComponent
            {
                Id = _nextComponentId++,
                Type = template.Type,
                Title = template.Name,
                Icon = template.Icon,
                Color = template.Color,
                GridX = 0,
                GridY = gridY,
                GridWidth = template.DefaultWidth,
                GridHeight = template.DefaultHeight,
                ChartType = template.ChartType ?? "bar",
                EnableAnimation = true,
                ShowLegend = true,
                KpiValue = GetRandomKpiValue(),
                KpiIcon = template.Icon,
                KpiTrend = (decimal)(Random.Shared.NextDouble() * 20 - 10)
            };

        _components.Add(newComponent);
        _selectedComponentId = newComponent.Id;
        SaveToHistory();
        MarkChanged();
        UpdateCanvasRows();

        ShowNotification($"{template.Name} added!", "success");
    }

    private string GetRandomKpiValue()
    {
        var formats = new[] { "${0:N0}", "{0:N0}", "{0:P1}", "${0:N2}" };
        var format = formats[Random.Shared.Next(formats.Length)];
        var value = Random.Shared.Next(100, 100000);

        if (format.Contains("P"))
            return string.Format(format, Random.Shared.NextDouble());
        return string.Format(format, value);
    }

