@page "/dashboard/builder"
@page "/dashboard/builder/{DashboardId:int}"
@using DynamicDashboardCommon.Models
@using DynamicDashboardCommon.Enums
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IToastService ToastService

<PageTitle>Dashboard Builder</PageTitle>

<div class="dashboard-builder">
    <!-- Header -->
    <!-- ============================================ -->
    <!-- COMPLETE TOOLBAR HEADER SECTION -->
    <!-- FILE: DashboardBuilder.razor -->
    <!-- REPLACE ENTIRE HEADER SECTION WITH THIS -->
    <!-- ============================================ -->

    <div class="builder-header">
        <!-- LEFT SECTION: Dashboard Title & Status -->
        <div class="builder-header-left">
            <div class="dashboard-title-section">
                <i class="fas fa-chart-line me-2"></i>
                <h5 class="mb-0">@(dashboard?.Title ?? "Untitled Dashboard")</h5>
                @if (dashboard != null)
                {
                    @if (dashboard.DashboardID > 0)
                    {
                        <span class="badge bg-success ms-2">
                            <i class="fas fa-check-circle me-1"></i>Saved
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark ms-2">
                            <i class="fas fa-exclamation-circle me-1"></i>Unsaved
                        </span>
                    }
                }
            </div>
        </div>

        <!-- CENTER SECTION: Main Actions -->
        <div class="builder-header-center">
            @if (dashboard != null)
            {
                <!-- PRIMARY ACTIONS GROUP -->
                <div class="btn-group me-2" role="group">
                    <!-- Save Button -->
                    <button class="btn btn-success"
                            @onclick="SaveDashboard"
                            disabled="@(!CanSave())"
                            title="Save dashboard">
                        <i class="fas fa-save me-1"></i>
                        <span class="btn-text">Save</span>
                    </button>

                    <!-- Load Data Button (only show if we have components and database) -->
                    @if (dashboard.Components != null && dashboard.Components.Any() && dashboard.DatabaseID > 0)
                    {
                        <button class="btn btn-primary"
                                @onclick="LoadAllComponentsData"
                                disabled="@isLoadingAllData"
                                title="Load data for all components">
                            @if (isLoadingAllData)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span class="btn-text">Loading...</span>
                            }
                            else
                            {
                                <i class="fas fa-play me-1"></i>
                                <span class="btn-text">Load Data</span>
                            }
                        </button>
                    }
                </div>

                <!-- SECONDARY ACTIONS GROUP -->
                <div class="btn-group me-2" role="group">
                    <!-- AI Generate Button -->
                    <button class="btn btn-outline-success"
                            @onclick="ShowTemplateModal"
                            title="Generate dashboard with AI">
                        <i class="fas fa-magic me-1"></i>
                        <span class="btn-text">AI Generate</span>
                    </button>

                    <!-- Add Custom Chart Button -->
                    <button class="btn btn-outline-info"
                            @onclick="ShowAddChartModal"
                            disabled="@(dashboard.DatabaseID <= 0)"
                            title="Add custom chart component">
                        <i class="fas fa-plus-circle me-1"></i>
                        <span class="btn-text">Add Chart</span>
                    </button>
                </div>

                <!-- VIEW CONTROLS GROUP -->
                <div class="btn-group me-2" role="group">
                    <!-- Preview/Design Toggle -->
                    <button class="btn @(isPreviewMode ? "btn-secondary" : "btn-outline-secondary")"
                            @onclick="TogglePreviewMode"
                            disabled="@(!dashboard.Components.Any())"
                            title="@(isPreviewMode ? "Switch to Design Mode" : "Preview Dashboard")">
                        <i class="fas fa-@(isPreviewMode ? "edit" : "eye") me-1"></i>
                        <span class="btn-text">@(isPreviewMode ? "Design" : "Preview")</span>
                    </button>
                </div>

                <!-- ZOOM CONTROLS (Only in Design Mode) -->
                @if (!isPreviewMode)
                {
                    <div class="btn-group me-2" role="group">
                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="ZoomOut"
                                disabled="@(zoomLevel <= 0.5)"
                                title="Zoom Out">
                            <i class="fas fa-search-minus"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary disabled zoom-display"
                                title="Current Zoom Level">
                            <span>@((int)(zoomLevel * 100))%</span>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="ZoomIn"
                                disabled="@(zoomLevel >= 1.5)"
                                title="Zoom In">
                            <i class="fas fa-search-plus"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="ResetZoom"
                                title="Reset Zoom to 100%">
                            <i class="fas fa-compress-arrows-alt"></i>
                        </button>
                    </div>
                }
            }
        </div>

        <!-- RIGHT SECTION: Utility Actions -->
        <div class="builder-header-right">
            @if (dashboard != null)
            {
                <div class="btn-group" role="group">
                    <!-- Dashboard Settings Button -->
                    <button class="btn btn-outline-secondary"
                            @onclick="ShowDashboardSettings"
                            title="Dashboard Settings">
                        <i class="fas fa-cog"></i>
                    </button>

                    <!-- Auto Arrange Components (only show if we have components) -->
                    @if (dashboard.Components != null && dashboard.Components.Any())
                    {
                        <button class="btn btn-outline-secondary"
                                @onclick="AutoArrangeComponents"
                                title="Auto Arrange Components">
                            <i class="fas fa-th"></i>
                        </button>
                    }

                    <!-- Close Button -->
                    <button class="btn btn-outline-danger"
                            @onclick="CloseDashboard"
                            title="Close Dashboard Builder">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Main Content -->
    @* REPLACE the builder-content section with this enhanced version *@

    <div class="builder-content @(isPreviewMode ? "preview-mode" : "")">
    @if (isPreviewMode)
    {
        <!-- ============================================ -->
        <!-- PREVIEW MODE - FULLSCREEN -->
        <!-- ============================================ -->
        <div class="preview-fullscreen">
            <div class="preview-header">
                <div>
                    <h4 class="mb-1">@dashboard.Title</h4>
                    @if (!string.IsNullOrEmpty(dashboard.Description))
                    {
                        <p class="text-muted mb-0 small">@dashboard.Description</p>
                    }
                </div>
                <button class="btn btn-secondary" @onclick="TogglePreviewMode">
                    <i class="fas fa-edit me-2"></i>
                    Exit Preview
                </button>
            </div>

            <div class="preview-grid" style="grid-template-rows: repeat(@GetGridHeight(), 100px);">
                @foreach (var component in dashboard.Components.Where(c => c.IsVisible))
                {
                    <div class="dashboard-component"
                         style="grid-column: @(component.GridX + 1) / span @component.GridWidth;
                                grid-row: @(component.GridY + 1) / span @component.GridHeight;">

                        <div class="component-header">
                            <span class="component-title">@component.Title</span>
                        </div>

                        <!-- ✅ COMPONENT BODY - PREVIEW MODE -->
                        <div class="component-body">
                            @if (IsComponentLoading(component.ComponentID))
                            {
                                <div class="component-loading">
                                    <div class="spinner-border text-primary mb-2"></div>
                                    <p class="text-muted small mb-0">Loading data...</p>
                                </div>
                            }
                            else if (componentData.ContainsKey(component.ComponentID))
                            {
                                @if (component.DataViewingTypeID == 2)
                                {
                                    <!-- TABLE -->
                                   
                                        var data = GetComponentData(component.ComponentID);
                                        if (data != null && data.Any())
                                        {
                                            var columns = data.First().Keys.ToList();
                                            var displayData = data.Take(10).ToList();
                                            
                                            <div class="table-responsive" style="max-height: 100%; overflow: auto;">
                                                <table class="table table-sm table-hover mb-0">
                                                    <thead class="sticky-top bg-light">
                                                        <tr>
                                                            @foreach (var col in columns)
                                                            {
                                                                <th style="font-size: 11px; padding: 8px;">@col</th>
                                                            }
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var row in displayData)
                                                        {
                                                            <tr>
                                                                @foreach (var col in columns)
                                                                {
                                                                    <td style="font-size: 11px; padding: 8px;">@row[col]</td>
                                                                }
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                            @if (data.Count > 10)
                                            {
                                                <div class="text-center mt-2">
                                                    <small class="text-muted">Showing 10 of @data.Count rows</small>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-center py-4">
                                                <i class="fas fa-table fa-2x text-muted mb-2"></i>
                                                <p class="text-muted mb-0 small">No data available</p>
                                            </div>
                                        }
                                 
                                }
                                else if (component.DataViewingTypeID == 3)
                                {
                                    <!-- KPI / NUMBER -->
                                  
                                        var data = GetComponentData(component.ComponentID);
                                        if (data != null && data.Any())
                                        {
                                            var firstRow = data.First();
                                            var value = firstRow.Values.FirstOrDefault()?.ToString() ?? "0";
                                            
                                            <div class="kpi-display">
                                                <div class="kpi-value">@value</div>
                                                <div class="kpi-label">@component.Title</div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="kpi-display">
                                                <div class="kpi-value">--</div>
                                                <div class="kpi-label">No Data</div>
                                            </div>
                                        }
                                 
                                }
                                else if (component.DataViewingTypeID == 4)
                                {
                                    <!-- ✅ CHART - DIRECT DIV (CRITICAL!) -->
                                    <div id="chart-@component.ComponentID" style="height: 100%; min-height: 250px;"></div>
                                }
                                else if (component.DataViewingTypeID == 1)
                                {
                                    <!-- LABEL -->
                                    <div class="label-display" style="padding: 20px; text-align: center;">
                                        <h5 style="margin-bottom: 8px; color: #2d3748;">@component.Title</h5>
                                        @if (!string.IsNullOrEmpty(component.Description))
                                        {
                                            <p class="text-muted mb-0" style="font-size: 14px;">@component.Description</p>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="component-placeholder">
                                    <i class="fas @GetComponentIcon(component.DataViewingTypeID) fa-3x mb-3 text-muted"></i>
                                    <p class="text-muted mb-1 font-weight-bold">@GetComponentTypeName(component.DataViewingTypeID)</p>
                                    <small class="text-muted">No data loaded</small>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- ============================================ -->
        <!-- DESIGN MODE -->
        <!-- ============================================ -->
        <div class="builder-design">
            <!-- Canvas -->
            <div class="builder-canvas" style="transform: scale(@zoomLevel);">
                <div class="dashboard-grid" @key="canvasKey" style="grid-template-rows: repeat(@GetGridHeight(), 100px);">
                    @if (dashboard.Components != null && dashboard.Components.Any())
                    {
                        @foreach (var component in dashboard.Components)
                        {
                            <div class="dashboard-component @(selectedComponentId == component.ComponentID ? "selected" : "")"
                                 style="grid-column: @(component.GridX + 1) / span @component.GridWidth;
                                        grid-row: @(component.GridY + 1) / span @component.GridHeight;"
                                 @onclick="() => SelectComponent(component.ComponentID)">

                                <div class="component-header">
                                    <span class="component-title">@component.Title</span>
                                    <div class="component-actions">
                                        <button class="btn btn-sm btn-link" @onclick="() => DuplicateComponent(component)" @onclick:stopPropagation="true" title="Duplicate">
                                            <i class="fas fa-clone"></i>
                                        </button>
                                        <button class="btn btn-sm btn-link" @onclick="() => RemoveComponent(component.ComponentID)" @onclick:stopPropagation="true" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- ✅ COMPONENT BODY - DESIGN MODE (EXACT SAME AS PREVIEW) -->
                                <div class="component-body">
                                    @if (IsComponentLoading(component.ComponentID))
                                    {
                                        <div class="component-loading">
                                            <div class="spinner-border text-primary mb-2"></div>
                                            <p class="text-muted small mb-0">Loading data...</p>
                                        </div>
                                    }
                                    else if (componentData.ContainsKey(component.ComponentID))
                                    {
                                        @if (component.DataViewingTypeID == 2)
                                        {
                                            <!-- TABLE -->
                                            
                                                var data = GetComponentData(component.ComponentID);
                                                if (data != null && data.Any())
                                                {
                                                    var columns = data.First().Keys.ToList();
                                                    var displayData = data.Take(10).ToList();
                                                    
                                                    <div class="table-responsive" style="max-height: 100%; overflow: auto;">
                                                        <table class="table table-sm table-hover mb-0">
                                                            <thead class="sticky-top bg-light">
                                                                <tr>
                                                                    @foreach (var col in columns)
                                                                    {
                                                                        <th style="font-size: 11px; padding: 8px;">@col</th>
                                                                    }
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var row in displayData)
                                                                {
                                                                    <tr>
                                                                        @foreach (var col in columns)
                                                                        {
                                                                            <td style="font-size: 11px; padding: 8px;">@row[col]</td>
                                                                        }
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    @if (data.Count > 10)
                                                    {
                                                        <div class="text-center mt-2">
                                                            <small class="text-muted">Showing 10 of @data.Count rows</small>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="text-center py-4">
                                                        <i class="fas fa-table fa-2x text-muted mb-2"></i>
                                                        <p class="text-muted mb-0 small">No data available</p>
                                                    </div>
                                                }
                                           
                                        }
                                        else if (component.DataViewingTypeID == 3)
                                        {
                                            <!-- KPI / NUMBER -->
                                            
                                                var data = GetComponentData(component.ComponentID);
                                                if (data != null && data.Any())
                                                {
                                                    var firstRow = data.First();
                                                    var value = firstRow.Values.FirstOrDefault()?.ToString() ?? "0";
                                                    
                                                    <div class="kpi-display">
                                                        <div class="kpi-value">@value</div>
                                                        <div class="kpi-label">@component.Title</div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="kpi-display">
                                                        <div class="kpi-value">--</div>
                                                        <div class="kpi-label">No Data</div>
                                                    </div>
                                                }
                                            
                                        }
                                        else if (component.DataViewingTypeID == 4)
                                        {
                                            <!-- ✅ CHART - DIRECT DIV (CRITICAL!) -->
                                            <div id="chart-@component.ComponentID" style="height: 100%; min-height: 250px;"></div>
                                        }
                                        else if (component.DataViewingTypeID == 1)
                                        {
                                            <!-- LABEL -->
                                            <div class="label-display" style="padding: 20px; text-align: center;">
                                                <h5 style="margin-bottom: 8px; color: #2d3748;">@component.Title</h5>
                                                @if (!string.IsNullOrEmpty(component.Description))
                                                {
                                                    <p class="text-muted mb-0" style="font-size: 14px;">@component.Description</p>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <!-- NO DATA PLACEHOLDER -->
                                        <div class="component-placeholder">
                                            <i class="fas @GetComponentIcon(component.DataViewingTypeID) fa-3x mb-3 text-muted"></i>
                                            <p class="text-muted mb-1 font-weight-bold">@GetComponentTypeName(component.DataViewingTypeID)</p>
                                            @if (!string.IsNullOrEmpty(component.Description))
                                            {
                                                <small class="text-muted">@component.Description</small>
                                            }
                                            <div class="mt-3">
                                                <small class="text-muted">
                                                    <i class="fas fa-info-circle me-1"></i>
                                                    Click "Load Data" to preview
                                                </small>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- EMPTY CANVAS -->
                        <div class="empty-canvas">
                            <i class="fas fa-magic fa-3x mb-3 text-muted"></i>
                            <h5>Start Building Your Dashboard</h5>
                            <p class="text-muted">Click "AI Generate" to create components automatically or "Add Chart" to create custom components</p>
                            <div class="d-flex gap-2 justify-content-center mt-3">
                                <button class="btn btn-success" @onclick="ShowTemplateModal">
                                    <i class="fas fa-magic me-2"></i>AI Generate
                                </button>
                                <button class="btn btn-primary" @onclick="ShowAddChartModal" disabled="@(dashboard.DatabaseID <= 0)">
                                    <i class="fas fa-plus-circle me-2"></i>Add Chart
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- ============================================ -->
            <!-- PROPERTIES PANEL (RIGHT SIDEBAR) -->
            <!-- ============================================ -->
            <div class="builder-sidebar builder-sidebar-right">
                @if (selectedComponentId != 0 && selectedComponent != null)
                {
                    <div class="properties-panel">
                        <div class="properties-header">
                            <h5>
                                <i class="fas fa-cog me-2"></i>
                                Component Properties
                            </h5>
                            <button class="btn-close-panel" @onclick="ClosePropertiesPanel">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>

                        <div class="properties-body">
                            <!-- Component Title -->
                            <div class="property-section">
                                <label class="property-label">
                                    <i class="fas fa-heading me-2"></i>
                                    Title
                                </label>
                                <input type="text"
                                       class="form-control"
                                       @bind="selectedComponent.Title"
                                       placeholder="Enter component title" />
                            </div>

                            <!-- Component Description -->
                            <div class="property-section">
                                <label class="property-label">
                                    <i class="fas fa-align-left me-2"></i>
                                    Description
                                </label>
                                <textarea class="form-control"
                                          @bind="selectedComponent.Description"
                                          placeholder="Enter component description (optional)"
                                          rows="3"
                                          style="resize: vertical;"></textarea>
                                <small class="form-text text-muted mt-1">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Optional description to help others understand this component
                                </small>
                            </div>

                            <!-- SQL Query -->
                            <div class="property-section">
                                <label class="property-label">
                                    <i class="fas fa-code me-2"></i>
                                    SQL Query
                                </label>

                                @if (!string.IsNullOrEmpty(selectedComponent.QueryText))
                                {
                                    @if (!isEditingSql)
                                    {
                                        <!-- VIEW MODE -->
                                        <div class="sql-viewer-large">
                                            <div class="sql-header">
                                                <span>SQL Statement</span>
                                                <div class="sql-actions">
                                                    <button class="btn-sql-action" @onclick="() => CopyToClipboard(selectedComponent.QueryText)" title="Copy">
                                                        <i class="fas fa-copy"></i>
                                                    </button>
                                                    <button class="btn-sql-action" @onclick="EnableSqlEdit" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <pre class="sql-code-large">@selectedComponent.QueryText</pre>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- EDIT MODE -->
                                        <div class="sql-editor-large">
                                            <div class="sql-header">
                                                <span>Edit SQL Query</span>
                                                <div class="sql-actions">
                                                    <button class="btn-sql-action text-success" @onclick="SaveSqlEdit" title="Save">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                    <button class="btn-sql-action text-danger" @onclick="CancelSqlEdit" title="Cancel">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <textarea class="sql-textarea"
                                                      @bind="editingSqlText"
                                                      rows="10"
                                                      spellcheck="false"
                                                      placeholder="Enter SQL query..."></textarea>
                                            <small class="text-muted mt-1 d-block">
                                                <i class="fas fa-info-circle me-1"></i>
                                                Changes will be saved when you click the checkmark
                                            </small>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-warning mb-0">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        No SQL query defined for this component
                                    </div>
                                    <button class="btn btn-sm btn-primary mt-2 w-100" @onclick="AddComponentSQL">
                                        <i class="fas fa-plus me-1"></i>Add SQL Query
                                    </button>
                                }
                            </div>

                            <!-- Component Type -->
                            <div class="property-section">
                                <label class="property-label">
                                    <i class="fas fa-shapes me-2"></i>
                                    Component Type
                                </label>
                                <select class="form-select" @bind="selectedComponentType" @bind:after="OnComponentTypeChanged">
                                    <option value="1">Label</option>
                                    <option value="2">Table</option>
                                    <option value="3">KPI / Number</option>
                                    <option value="4">Chart</option>
                                </select>
                            </div>

                            <!-- Chart Type (Only if Chart) -->
                            @if (selectedComponent.DataViewingTypeID == 4)
                            {
                                <div class="property-section">
                                    <label class="property-label">
                                        <i class="fas fa-chart-bar me-2"></i>
                                        Chart Type
                                    </label>
                                    <div class="chart-type-grid">
                                        <div class="chart-type-option @(GetComponentChartType() == "bar" ? "selected" : "")"
                                             @onclick='() => UpdateChartType("bar")'>
                                            <i class="fas fa-chart-bar fa-2x mb-2"></i>
                                            <span>Bar</span>
                                        </div>
                                        <div class="chart-type-option @(GetComponentChartType() == "line" ? "selected" : "")"
                                             @onclick='() => UpdateChartType("line")'>
                                            <i class="fas fa-chart-line fa-2x mb-2"></i>
                                            <span>Line</span>
                                        </div>
                                        <div class="chart-type-option @(GetComponentChartType() == "pie" ? "selected" : "")"
                                             @onclick='() => UpdateChartType("pie")'>
                                            <i class="fas fa-chart-pie fa-2x mb-2"></i>
                                            <span>Pie</span>
                                        </div>
                                        <div class="chart-type-option @(GetComponentChartType() == "donut" ? "selected" : "")"
                                             @onclick='() => UpdateChartType("donut")'>
                                            <i class="fas fa-ring fa-2x mb-2"></i>
                                            <span>Donut</span>
                                        </div>
                                        <div class="chart-type-option @(GetComponentChartType() == "area" ? "selected" : "")"
                                             @onclick='() => UpdateChartType("area")'>
                                            <i class="fas fa-chart-area fa-2x mb-2"></i>
                                            <span>Area</span>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Table Options (Only if Table) -->
                            @if (selectedComponent.DataViewingTypeID == 2)
                            {
                                <div class="property-section">
                                    <label class="property-label">
                                        <i class="fas fa-table me-2"></i>
                                        Table Options
                                    </label>

                                    <div class="form-group mb-3">
                                        <label class="form-label small">Rows Per Page</label>
                                        <select class="form-select form-select-sm" @bind="tablePageSize">
                                            <option value="10">10 rows</option>
                                            <option value="25">25 rows</option>
                                            <option value="50">50 rows</option>
                                            <option value="100">100 rows</option>
                                        </select>
                                    </div>

                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" @bind="tableEnablePagination" id="tablePagination">
                                        <label class="form-check-label" for="tablePagination">
