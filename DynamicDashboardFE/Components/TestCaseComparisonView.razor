@using DynamicDashboardCommon.Models
@inject IJSRuntime JSRuntime

<div class="comparison-container @(IsVisible ? "visible" : "")" @onclick:stopPropagation>
    <div class="comparison-header">
        <div class="header-info">
            <h2>Advanced Test Analysis</h2>
            <div class="metadata">
                <div class="metadata-item">
                    <span class="label">Question:</span>
                    <span class="value">@TestDetail?.Question</span>
                </div>
                <div class="metadata-stats">
                    <div class="stat @GetStatusClass(TestDetail?.SQLMatchScore)">
                        <span>SQL Match</span>
                        <div class="gauge">
                            <div class="gauge-fill" style="width: @(TestDetail?.SQLMatchScore * 100 ?? 0)%"></div>
                        </div>
                        <span>@FormatPercent(TestDetail?.SQLMatchScore)</span>
                    </div>
                    <div class="stat @GetStatusClass(TestDetail?.ExplanationMatchScore)">
                        <span>Explanation</span>
                        <div class="gauge">
                            <div class="gauge-fill" style="width: @(TestDetail?.ExplanationMatchScore * 100 ?? 0)%"></div>
                        </div>
                        <span>@FormatPercent(TestDetail?.ExplanationMatchScore)</span>
                    </div>
                    <div class="stat @GetStatusClass(TestDetail?.DataMatchScore)">
                        <span>Data Match</span>
                        <div class="gauge">
                            <div class="gauge-fill" style="width: @(TestDetail?.DataMatchScore * 100 ?? 0)%"></div>
                        </div>
                        <span>@FormatPercent(TestDetail?.DataMatchScore)</span>
                    </div>
                </div>
            </div>
        </div>
        <button class="close-btn" @onclick="OnClose">×</button>
    </div>

    <div class="tabs">
        <div class="tab @(ActiveTab == "sql" ? "active" : "")" @onclick='() => SetActiveTab("sql")'>
            <i class="fas fa-code"></i> SQL Comparison
        </div>
        <div class="tab @(ActiveTab == "explanation" ? "active" : "")" @onclick='() => SetActiveTab("explanation")'>
            <i class="fas fa-comment-alt"></i> Explanation
        </div>
        <div class="tab @(ActiveTab == "datasets" ? "active" : "")" @onclick='() => SetActiveTab("datasets")'>
            <i class="fas fa-table"></i> Datasets
        </div>
        <div class="tab @(ActiveTab == "visual" ? "active" : "")" @onclick='() => SetActiveTab("visual")'>
            <i class="fas fa-chart-bar"></i> Visual Analysis
        </div>
    </div>

    <div class="tab-content">
        @if (ActiveTab == "sql")
        {
            <div class="sql-comparison animate__animated animate__fadeIn">
                <div class="split-view">
                    <div class="panel">
                        <div class="panel-header">
                            <h3>Expected SQL</h3>
                            <div class="header-actions">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyToClipboard(TestDetail?.ExpectedSQL)">
                                    <i class="fas fa-copy"></i> Copy
                                </button>
                            </div>
                        </div>
                        <div class="code-container expected">
                            <pre class="code">@TestDetail?.ExpectedSQL</pre>
                        </div>
                    </div>
                    <div class="panel">
                        <div class="panel-header">
                            <h3>Generated SQL</h3>
                            <div class="header-actions">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyToClipboard(TestDetail?.GeneratedSQL)">
                                    <i class="fas fa-copy"></i> Copy
                                </button>
                            </div>
                        </div>
                        <div class="code-container generated">
                            <pre class="code">@TestDetail?.GeneratedSQL</pre>
                        </div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(TestDetail?.ErrorMessage))
                {
                    <div class="error-panel">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>@TestDetail.ErrorMessage</span>
                    </div>
                }
            </div>
        }
        else if (ActiveTab == "explanation")
        {
            <div class="explanation-comparison animate__animated animate__fadeIn">
                <div class="split-view">
                    <div class="panel">
                        <div class="panel-header">
                            <h3>Expected Explanation</h3>
                        </div>
                        <div class="text-container expected">
                            <div class="text-content">@TestDetail?.ExpectedExplanation</div>
                        </div>
                    </div>
                    <div class="panel">
                        <div class="panel-header">
                            <h3>Generated Explanation</h3>
                        </div>
                        <div class="text-container generated">
                            <div class="text-content">@TestDetail?.GeneratedExplanation</div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (ActiveTab == "datasets")
        {
            <div class="dataset-comparison animate__animated animate__fadeIn">
                <div class="dataset-meta">
                    <div class="meta-item">
                        <span class="label">Expected Rows:</span>
                        <span class="value">@TestDetail?.ExpectedRowCount</span>
                    </div>
                    <div class="meta-item">
                        <span class="label">Actual Rows:</span>
                        <span class="value">@TestDetail?.ActualRowCount</span>
                    </div>
                    <div class="meta-item">
                        <span class="label">Status:</span>
                        <span class="value @(TestDetail?.Success == true ? "success" : "error")">
                            @TestDetail?.ResultMatchStatus
                        </span>
                    </div>
                </div>

                <div class="split-view">
                    <div class="panel">
                        <div class="panel-header">
                            <h3>Expected Dataset</h3>
                            @if (ExpectedData == null || !ExpectedData.Any())
                            {
                                <span class="empty-badge">No data</span>
                            }
                            else
                            {
                                <span class="count-badge">@ExpectedData.Count rows</span>
                            }
                        </div>
                        <div class="data-container">
                            @if (ExpectedData == null || !ExpectedData.Any())
                            {
                                <div class="empty-state">
                                    <i class="fas fa-database"></i>
                                    <p>No expected dataset available</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-wrapper">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                @foreach (var col in ExpectedData[0].Keys)
                                                {
                                                    <th>@col</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in ExpectedData.Take(ShowAllRows ? ExpectedData.Count : 15))
                                            {
                                                <tr>
                                                    @foreach (var col in ExpectedData[0].Keys)
                                                    {
                                                        <td>@FormatValue(row.TryGetValue(col, out var val) ? val : null)</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if (ExpectedData.Count > 15 && !ShowAllRows)
                                {
                                    <div class="data-footer">
                                        <span>Showing 15 of @ExpectedData.Count rows</span>
                                        <button class="btn btn-sm btn-link" @onclick="() => ShowAllRows = true">Show All</button>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    <div class="panel">
                        <div class="panel-header">
                            <h3>Actual Dataset</h3>
                            @if (ActualData == null || !ActualData.Any())
                            {
                                <span class="empty-badge">No data</span>
                            }
                            else
                            {
                                <span class="count-badge">@ActualData.Count rows</span>
                            }
                        </div>
                        <div class="data-container">
                            @if (ActualData == null || !ActualData.Any())
                            {
                                <div class="empty-state">
                                    <i class="fas fa-database"></i>
                                    <p>No actual dataset available</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-wrapper">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                @foreach (var col in ActualData[0].Keys)
                                                {
                                                    <th>@col</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in ActualData.Take(ShowAllRows ? ActualData.Count : 15))
                                            {
                                                <tr>
                                                    @foreach (var col in ActualData[0].Keys)
                                                    {
                                                        <td>@FormatValue(row.TryGetValue(col, out var val) ? val : null)</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if (ActualData.Count > 15 && !ShowAllRows)
                                {
                                    <div class="data-footer">
                                        <span>Showing 15 of @ActualData.Count rows</span>
                                        <button class="btn btn-sm btn-link" @onclick="() => ShowAllRows = true">Show All</button>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="diff-controls">
                    <button class="btn btn-primary" @onclick="CalculateDifferences">
                        <i class="fas fa-exchange-alt me-2"></i> Calculate Differences
                    </button>

                    @if (HasCalculatedDiff)
                    {
                        <div class="diff-summary">
                            <div class="diff-stat">
                                <span class="diff-label">Matching Rows:</span>
                                <span class="diff-value @(ExactMatchCount > 0 ? "success" : "")">@ExactMatchCount</span>
                            </div>
                            <div class="diff-stat">
                                <span class="diff-label">Different Rows:</span>
                                <span class="diff-value @(DifferentValueCount > 0 ? "error" : "")">@DifferentValueCount</span>
                            </div>
                            <div class="diff-stat">
                                <span class="diff-label">Missing in Actual:</span>
                                <span class="diff-value @(MissingRowCount > 0 ? "warning" : "")">@MissingRowCount</span>
                            </div>
                            <div class="diff-stat">
                                <span class="diff-label">Extra in Actual:</span>
                                <span class="diff-value @(ExtraRowCount > 0 ? "warning" : "")">@ExtraRowCount</span>
                            </div>
                        </div>
                    }
                </div>

                @if (ShowDiffView && DifferenceRows.Any())
                {
                    <div class="diff-view animate__animated animate__fadeIn">
                        <h4>Row Differences</h4>
                        <div class="table-wrapper">
                            <table class="diff-table">
                                <thead>
                                    <tr>
                                        <th>Row #</th>
                                        <th>Column</th>
                                        <th>Expected Value</th>
                                        <th>Actual Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var diff in DifferenceRows)
                                    {
                                        <tr>
                                            <td>@diff.RowIndex</td>
                                            <td>@diff.Column</td>
                                            <td class="expected-value">@diff.ExpectedValue</td>
                                            <td class="actual-value">@diff.ActualValue</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }
        else if (ActiveTab == "visual")
        {
            <div class="visual-diff animate__animated animate__fadeIn">
                @if ((ExpectedData == null || !ExpectedData.Any()) && (ActualData == null || !ActualData.Any()))
                {
                    <div class="empty-state">
                        <i class="fas fa-chart-line"></i>
                        <p>No data available for visualization</p>
                    </div>
                }
                else
                {
                    <div class="visual-container">
                        <div class="viz-section structure">
                            <h3>Structure Comparison</h3>
                            <div class="structure-viz" id="structureViz">
                                <!-- Will be populated by JS -->
                                <div class="loading-spinner">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="viz-section data">
                            <h3>Data Differences</h3>
                            <div class="data-viz" id="dataViz">
                                <!-- Will be populated by JS -->
                                <div class="loading-spinner">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="viz-section sunburst">
                            <h3>Match Overview</h3>
                            <div class="sunburst-viz" id="sunburstViz">
                                <!-- Will be populated by JS -->
                                <div class="loading-spinner">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public TestAutomationDetail TestDetail { get; set; }
    [Parameter] public List<Dictionary<string, object>> ExpectedData { get; set; }
    [Parameter] public List<Dictionary<string, object>> ActualData { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private string ActiveTab = "sql";
    private bool ShowAllRows = false;
    private bool ShowDiffView = false;
    private bool HasCalculatedDiff = false;

    // Difference analysis metrics
    private int ExactMatchCount = 0;
    private int DifferentValueCount = 0;
    private int MissingRowCount = 0;
    private int ExtraRowCount = 0;
    private List<RowDifference> DifferenceRows = new List<RowDifference>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsVisible && ActiveTab == "visual" && ExpectedData != null && ActualData != null)
        {
            await RenderVisualizations();
        }
    }

    protected override void OnParametersSet()
    {
        // Reset diff view when new data is loaded
        ShowDiffView = false;
        HasCalculatedDiff = false;
        DifferenceRows.Clear();
    }

    private async Task RenderVisualizations()
    {
        // Column comparison data
        var expectedColumns = ExpectedData?.Count > 0 ? ExpectedData[0].Keys.ToArray() : new string[0];
        var actualColumns = ActualData?.Count > 0 ? ActualData[0].Keys.ToArray() : new string[0];

        // Row count comparison
        var rowData = new
        {
            expected = ExpectedData?.Count ?? 0,
            actual = ActualData?.Count ?? 0
        };

        // Create data for visualizations
        var structureData = new
        {
            expectedColumns,
            actualColumns,
            rowData
        };

        // Diff metrics
        int commonCount = 0;
        int diffCount = 0;
        int missingCount = 0;
        int extraCount = 0;

        if (ExpectedData?.Count > 0 && ActualData?.Count > 0)
        {
            var commonColumns = expectedColumns.Intersect(actualColumns, StringComparer.OrdinalIgnoreCase).ToArray();

            // Count differences in data
            var minRows = Math.Min(ExpectedData.Count, ActualData.Count);
            for (int i = 0; i < minRows; i++)
            {
                foreach (var col in commonColumns)
                {
                    var expectedVal = ExpectedData[i].TryGetValue(col, out var ev) ? ev?.ToString() : null;
                    var actualVal = ActualData[i].TryGetValue(col, out var av) ? av?.ToString() : null;

                    if (string.Equals(expectedVal, actualVal, StringComparison.OrdinalIgnoreCase))
                        commonCount++;
                    else
                        diffCount++;
                }
            }

            // Count missing/extra rows
            if (ExpectedData.Count > ActualData.Count)
                missingCount = (ExpectedData.Count - ActualData.Count) * commonColumns.Length;
            else if (ActualData.Count > ExpectedData.Count)
                extraCount = (ActualData.Count - ExpectedData.Count) * commonColumns.Length;
        }

        var diffData = new
        {
            common = commonCount,
            different = diffCount,
            missing = missingCount,
            extra = extraCount
        };

        // Sunburst data
        var sunburstData = new
        {
            sqlMatch = TestDetail?.SQLMatchScore ?? 0,
            explanationMatch = TestDetail?.ExplanationMatchScore ?? 0,
            dataMatch = TestDetail?.DataMatchScore ?? 0
        };

        // Call JS to render visualizations
        await JSRuntime.InvokeVoidAsync("renderTestVisualizations",
            structureData,
            diffData,
            sunburstData);
    }

    private void SetActiveTab(string tab)
    {
        ActiveTab = tab;
        StateHasChanged();
    }

    private async Task OnClose()
    {
        IsVisible = false;
        await OnClosed.InvokeAsync();
    }

    private async Task CopyToClipboard(string text)
    {
        if (string.IsNullOrEmpty(text))
            return;

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }

    private void CalculateDifferences()
    {
        if (ExpectedData == null || !ExpectedData.Any() || ActualData == null || !ActualData.Any())
        {
            return;
        }

        DifferenceRows.Clear();

        // Get common columns for comparison
        var expectedColumns = ExpectedData[0].Keys.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var actualColumns = ActualData[0].Keys.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var commonColumns = expectedColumns.Intersect(actualColumns, StringComparer.OrdinalIgnoreCase).ToList();

        if (!commonColumns.Any())
        {
            return;
        }

        // Calculate exact matches, different values, missing and extra rows
        int minRows = Math.Min(ExpectedData.Count, ActualData.Count);

        ExactMatchCount = 0;
        DifferentValueCount = 0;

        // Compare common rows
        for (int i = 0; i < minRows; i++)
        {
            bool rowMatches = true;

            foreach (var column in commonColumns)
            {
                string actualColumn = ActualData[i].Keys.FirstOrDefault(k =>
                    string.Equals(k, column, StringComparison.OrdinalIgnoreCase));

                string expectedColumn = ExpectedData[i].Keys.FirstOrDefault(k =>
                    string.Equals(k, column, StringComparison.OrdinalIgnoreCase));

                if (actualColumn != null && expectedColumn != null)
                {
                    var expectedVal = ExpectedData[i][expectedColumn];
                    var actualVal = ActualData[i][actualColumn];

                    bool valuesMatch = AreValuesEqual(expectedVal, actualVal);

                    if (!valuesMatch)
                    {
                        rowMatches = false;
                        DifferenceRows.Add(new RowDifference
                            {
                                RowIndex = i + 1,
                                Column = column,
                                ExpectedValue = FormatValue(expectedVal),
                                ActualValue = FormatValue(actualVal)
                            });
                    }
                }
            }

            if (rowMatches)
            {
                ExactMatchCount++;
            }
            else
            {
                DifferentValueCount++;
            }
        }

        // Count missing and extra rows
        MissingRowCount = ExpectedData.Count - minRows;
        ExtraRowCount = ActualData.Count - minRows;

        HasCalculatedDiff = true;
        ShowDiffView = true;
        StateHasChanged();
    }

    private bool AreValuesEqual(object expected, object actual)
    {
        if (expected == null && actual == null)
            return true;

        if (expected == null || actual == null)
            return false;

        // Convert to string for comparison
        string expectedStr = expected.ToString();
        string actualStr = actual.ToString();

        // Special handling for numeric values
        if (IsNumeric(expected) && IsNumeric(actual))
        {
            if (decimal.TryParse(expectedStr, out var expectedNum) &&
                decimal.TryParse(actualStr, out var actualNum))
            {
                // Consider numbers equal if they're within a small tolerance
                return Math.Abs(expectedNum - actualNum) < 0.000001m;
            }
        }

        // Special handling for dates
        if ((expected is DateTime || actual is DateTime) &&
            DateTime.TryParse(expectedStr, out var expectedDate) &&
            DateTime.TryParse(actualStr, out var actualDate))
        {
            return expectedDate == actualDate;
        }

        // Default string comparison
        return string.Equals(expectedStr, actualStr, StringComparison.OrdinalIgnoreCase);
    }

    private bool IsNumeric(object obj)
    {
        return obj is int || obj is long || obj is float ||
               obj is double || obj is decimal || obj is short ||
               obj is byte || obj is sbyte || obj is ushort ||
               obj is uint || obj is ulong;
    }

    private string GetStatusClass(decimal? score)
    {
        if (!score.HasValue) return "error";

        return score.Value switch
        {
            >= 0.9m => "excellent",
            >= 0.7m => "good",
            >= 0.5m => "fair",
            _ => "poor"
        };
    }

    private string FormatPercent(decimal? value)
    {
        return value.HasValue ? $"{value.Value:P1}" : "N/A";
    }

    private string FormatValue(object value)
    {
        if (value == null) return "";

        if (value is DateTime dateTime)
            return dateTime.ToString("yyyy-MM-dd HH:mm");

        if (value is decimal decimalValue)
            return decimalValue.ToString("0.00");

        if (value is double doubleValue)
            return doubleValue.ToString("0.00");

        return value.ToString();
    }

    private class RowDifference
    {
        public int RowIndex { get; set; }
        public string Column { get; set; }
        public string ExpectedValue { get; set; }
        public string ActualValue { get; set; }
    }
}